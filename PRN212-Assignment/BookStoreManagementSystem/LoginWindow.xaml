<Window x:Class="BookStoreManagementSystem.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BookStore - Đăng Nhập &amp; Đăng Ký Hệ Thống"
        Height="680" Width="1040"
        MinHeight="620" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI, Inter, Arial">

    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="24" Direction="270" ShadowDepth="6" Opacity="0.12" Color="#0F172A" />

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4F46E5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="16,11" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4338CA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3730A3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EEF2FF" />
            <Setter Property="Foreground" Value="#4F46E5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#C7D2FE" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0E7FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="40" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4F46E5" />
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Border Background="#FFFFFF" CornerRadius="20" Effect="{StaticResource CardShadow}" ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="440" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT PANEL: BRANDING -->
                <Border Grid.Column="0" CornerRadius="20,0,0,20" Padding="34,36">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#312E81" Offset="0" />
                            <GradientStop Color="#4F46E5" Offset="0.55" />
                            <GradientStop Color="#0284C7" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Brand Header -->
                        <StackPanel Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <Border Width="46" Height="46" CornerRadius="12" Background="#30FFFFFF" Margin="0,0,12,0">
                                    <TextBlock Text="📚" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="BOOKSTORE PORTAL" FontWeight="Black" FontSize="19" Foreground="White" />
                                    <TextBlock Text="/auth/portal • Mua Bán &amp; Thuê Sách" FontSize="12" Foreground="#C7D2FE" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="Website Hiệu Sách Trực Tuyến Toàn Diện" FontWeight="Black" FontSize="24" Foreground="White" TextWrapping="Wrap" Margin="0,8,0,12" />
                            <TextBlock Text="Hệ thống tích hợp đầy đủ: Mua sách sở hữu, Thuê sách theo tuần/tháng, Quản lý giỏ hàng, Theo dõi đơn thuê/mua và Admin Dashboard quản trị."
                                       FontSize="13" Foreground="#E0E7FF" TextWrapping="Wrap" LineHeight="20" />
                        </StackPanel>

                        <!-- Feature Highlights -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,16">
                            <Border Background="#20FFFFFF" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛍️" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="Mua Bán &amp; Thanh Toán Trực Tuyến" FontWeight="Bold" FontSize="13" Foreground="White" />
                                        <TextBlock Text="Tự động đồng bộ giỏ hàng, tồn kho và hóa đơn CSDL" FontSize="11" Foreground="#C7D2FE" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="#20FFFFFF" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📅" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="Dịch Vụ Thuê Sách &amp; Trả Sách" FontWeight="Bold" FontSize="13" Foreground="White" />
                                        <TextBlock Text="Chọn kỳ hạn thuê 7/14/30 ngày, quản lý trạng thái Đang thuê &amp; Đã trả" FontSize="11" Foreground="#C7D2FE" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="#20FFFFFF" CornerRadius="10" Padding="12,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛠️" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="Admin Dashboard Chuyên Nghiệp" FontWeight="Bold" FontSize="13" Foreground="White" />
                                        <TextBlock Text="Thống kê doanh thu, CRUD Sách + Ảnh bìa, Thể loại, Đơn hàng &amp; User" FontSize="11" Foreground="#C7D2FE" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- RIGHT PANEL: LOGIN / REGISTER FORMS -->
                <Grid Grid.Column="1" Margin="44,32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Mode Switcher Tabs -->
                    <Border Grid.Row="0" Background="#F1F5F9" CornerRadius="10" Padding="4" HorizontalAlignment="Left" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnTabLogin" Content="🔐 Đăng Nhập" Width="150" Padding="12,8"
                                    Background="#4F46E5" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                    Click="btnTabLogin_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="btnTabRegister" Content="✨ Đăng Ký Mới" Width="150" Padding="12,8"
                                    Background="Transparent" Foreground="#475569" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                                    Click="btnTabRegister_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- LOGIN FORM -->
                    <StackPanel x:Name="panelLogin" Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="Chào mừng trở lại! 👋" FontWeight="Black" FontSize="24" Foreground="#0F172A" Margin="0,0,0,6" />
                        <TextBlock Text="Nhập email và mật khẩu của bạn để truy cập hệ thống hiệu sách." FontSize="13" Foreground="#64748B" Margin="0,0,0,22" />

                        <TextBlock Text="ĐỊA CHỈ EMAIL" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,6" />
                        <TextBox x:Name="txtLoginEmail" Style="{StaticResource InputTextBoxStyle}" Text="" Margin="0,0,0,16" />

                        <TextBlock Text="MẬT KHẨU" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,6" />
                        <Border Height="40" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Background="White" Margin="0,0,0,24">
                            <PasswordBox x:Name="txtLoginPassword" FontSize="13" Padding="10,0" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" />
                        </Border>

                        <Button Content="Đăng Nhập Vào Hệ Thống →" Style="{StaticResource PrimaryButtonStyle}" Click="btnSubmitLogin_Click" />
                    </StackPanel>

                    <!-- REGISTER FORM -->
                    <ScrollViewer x:Name="panelRegister" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Tạo Tài Khoản Khách Hàng ✨" FontWeight="Black" FontSize="22" Foreground="#0F172A" Margin="0,0,0,4" />
                            <TextBlock Text="Đăng ký tài khoản để mua sách, thuê sách và theo dõi đơn hàng." FontSize="13" Foreground="#64748B" Margin="0,0,0,14" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,12">
                                    <TextBlock Text="HỌ VÀ TÊN *" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox x:Name="txtRegFullName" Style="{StaticResource InputTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,12">
                                    <TextBlock Text="SỐ ĐIỆN THOẠI *" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox x:Name="txtRegPhone" Style="{StaticResource InputTextBoxStyle}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="ĐỊA CHỈ EMAIL *" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                            <TextBox x:Name="txtRegEmail" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,12" />

                            <TextBlock Text="ĐỊA CHỈ NHẬN SÁCH" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                            <TextBox x:Name="txtRegAddress" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="MẬT KHẨU *" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                    <Border Height="40" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Background="White">
                                        <PasswordBox x:Name="txtRegPassword" FontSize="13" Padding="10,0" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="XÁC NHẬN MẬT KHẨU *" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                    <Border Height="40" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Background="White">
                                        <PasswordBox x:Name="txtRegConfirmPassword" FontSize="13" Padding="10,0" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Button Content="Hoàn Tất Đăng Ký Tài Khoản" Style="{StaticResource PrimaryButtonStyle}" Click="btnSubmitRegister_Click" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Guest Access -->
                    <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,12,0,0">
                        <Grid>
                            <TextBlock Text="Bạn chỉ muốn dạo xem kho sách?" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                            <Button Content="🏪 Quay lại" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Click="btnContinueAsGuest_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
