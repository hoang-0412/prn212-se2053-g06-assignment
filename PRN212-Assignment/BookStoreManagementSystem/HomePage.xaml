<Window x:Class="BookStoreManagementSystem.HomePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookStoreManagementSystem"
        mc:Ignorable="d"
        Title="BookStore - Website Hiệu Sách Trực Tuyến (Mua Bán &amp; Thuê Sách)" 
        Height="860" Width="1380"
        MinHeight="720" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI, Inter, Arial">

    <Window.Resources>
        <!-- Card Drop Shadow -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" Direction="270" ShadowDepth="3" Opacity="0.08" Color="#0F172A" />
        <DropShadowEffect x:Key="ModalShadow" BlurRadius="25" Direction="270" ShadowDepth="8" Opacity="0.25" Color="#000000" />

        <!-- Converter for Boolean to Visibility -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <!-- Modern Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4F46E5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4338CA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3730A3" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#D97706" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B45309" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EEF2FF" />
            <Setter Property="Foreground" Value="#4F46E5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#C7D2FE" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0E7FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded TextBox Style -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4F46E5" />
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- MAIN WINDOW CONTENT -->
        <DockPanel LastChildFill="True">

            <!-- 1. TOP HEADER / APP BAR -->
            <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Logo and App Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="10" Background="#4F46E5" Margin="0,0,12,0">
                            <TextBlock Text="📚" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="BOOK" FontWeight="Black" FontSize="20" Foreground="#4F46E5" />
                                <TextBlock Text="STORE" FontWeight="Black" FontSize="20" Foreground="#0F172A" />
                                <Border Background="#EEF2FF" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="/homepage" FontSize="11" FontWeight="SemiBold" Foreground="#4F46E5" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Mua Bán Sách &amp; Dịch Vụ Thuê Sách Trực Tuyến" FontSize="11" Foreground="#64748B" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Search Input -->
                    <Grid Grid.Column="1" HorizontalAlignment="Center" Width="400" Margin="14,0">
                        <TextBox x:Name="txtSearch" 
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 Padding="36,8,30,8"
                                 TextChanged="txtSearch_TextChanged" />
                        <TextBlock Text="🔍" FontSize="14" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False" />
                        <TextBlock x:Name="txtSearchPlaceholder" 
                                   Text="Tìm sách theo tên, tác giả, NXB..." 
                                   Foreground="#94A3B8" FontSize="13" 
                                   VerticalAlignment="Center" HorizontalAlignment="Left" 
                                   Margin="36,0,0,0" IsHitTestVisible="False" />
                        <Button x:Name="btnClearSearch" Content="✖" 
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" 
                                Background="Transparent" BorderThickness="0" Foreground="#94A3B8" 
                                Cursor="Hand" Click="btnClearSearch_Click" Visibility="Collapsed" />
                    </Grid>

                    <!-- Header Action Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Current User Badge -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,8,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👤 " FontSize="13" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock x:Name="txtCurrentUserName" Text="Khách vãng lai" FontWeight="Bold" FontSize="12" Foreground="#0F172A" />
                                    <TextBlock x:Name="txtCurrentUserRole" Text="Khách (Guest)" FontSize="10" Foreground="#64748B" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- My Orders & Rentals Button -->
                        <Button x:Name="btnOpenMyOrders" Content="📦 Đơn Mua &amp; Thuê" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="btnOpenMyOrders_Click" />

                        <!-- Admin Dashboard Button -->
                        <Button x:Name="btnOpenAdmin" Content="🛠️ Admin Dashboard" Style="{StaticResource RentButtonStyle}" Background="#0F172A" Margin="0,0,8,0" Click="btnOpenAdmin_Click" />

                        <!-- Cart Button -->
                        <Button x:Name="btnOpenCart" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Click="btnOpenCart_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛒 " FontSize="14" />
                                <TextBlock x:Name="txtCartBadge" Text="Giỏ hàng (0)" FontWeight="Bold" />
                            </StackPanel>
                        </Button>

                        <!-- Login / Switch Account Button -->
                        <Button x:Name="btnAuthAction" Content="🔐 Tài khoản" Style="{StaticResource SecondaryButtonStyle}" Click="btnAuthAction_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. MAIN BODY (Sidebar + Book Catalog) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="275" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDEBAR: FILTERS -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="18">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Filter Header -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBlock Text="⚡" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="BỘ LỌC TÌM KIẾM" FontWeight="Bold" FontSize="14" Foreground="#1E293B" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- CATEGORY FILTER -->
                            <TextBlock Text="THỂ LOẠI SÁCH" FontWeight="Bold" FontSize="12" Foreground="#64748B" Margin="0,0,0,8" />
                            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Background="#F8FAFC" Padding="4" Margin="0,0,0,16">
                                <ListBox x:Name="lstCategories" 
                                         BorderThickness="0" Background="Transparent" 
                                         SelectionChanged="lstCategories_SelectionChanged"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,6" CornerRadius="6" Background="Transparent">
                                                <Grid>
                                                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#1E293B" TextTrimming="CharacterEllipsis" />
                                                    <Border Background="#E2E8F0" CornerRadius="10" Padding="6,1" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding Count}" FontSize="11" Foreground="#475569" FontWeight="SemiBold" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <!-- PRICE RANGE FILTER -->
                            <TextBlock Text="KHOẢNG GIÁ" FontWeight="Bold" FontSize="12" Foreground="#64748B" Margin="0,0,0,8" />
                            <StackPanel Margin="0,0,0,16">
                                <RadioButton x:Name="rbPriceAll" Content="Tất cả mức giá" IsChecked="True" Margin="0,4" Checked="FilterChanged" />
                                <RadioButton x:Name="rbPriceUnder100" Content="Dưới 100.000 đ" Margin="0,4" Checked="FilterChanged" />
                                <RadioButton x:Name="rbPrice100To300" Content="100.000 đ - 300.000 đ" Margin="0,4" Checked="FilterChanged" />
                                <RadioButton x:Name="rbPriceAbove300" Content="Trên 300.000 đ" Margin="0,4" Checked="FilterChanged" />
                            </StackPanel>

                            <!-- STATUS FILTER -->
                            <TextBlock Text="HÌNH THỨC GIAO DỊCH" FontWeight="Bold" FontSize="12" Foreground="#64748B" Margin="0,0,0,8" />
                            <ComboBox x:Name="cbBookStatus" Margin="0,0,0,16" Padding="10,6" SelectionChanged="cbBookStatus_SelectionChanged">
                                <ComboBoxItem Content="Tất cả hình thức" IsSelected="True" />
                                <ComboBoxItem Content="Bán" />
                                <ComboBoxItem Content="Cho thuê" />
                                <ComboBoxItem Content="Đã thuê" />
                            </ComboBox>

                            <!-- STOCK AVAILABILITY FILTER -->
                            <TextBlock Text="TỒN KHO" FontWeight="Bold" FontSize="12" Foreground="#64748B" Margin="0,0,0,8" />
                            <CheckBox x:Name="chkInStockOnly" Content="Chỉ hiện sách sẵn sàng giao dịch" Margin="0,0,0,18" Checked="FilterChanged" Unchecked="FilterChanged" />

                            <!-- RESET & REFRESH BUTTONS -->
                            <Button x:Name="btnResetFilters" Content="🧹 Đặt Lại Bộ Lọc" Style="{StaticResource SecondaryButtonStyle}" Click="btnResetFilters_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                            <Button x:Name="btnRefresh" Content="🔄 Làm Mới Kho Sách" Style="{StaticResource SecondaryButtonStyle}" Click="btnRefresh_Click" HorizontalAlignment="Stretch" />

                            <Separator Margin="0,18" Background="#E2E8F0" />

                            <!-- Rental Service Info Box -->
                            <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="📅 Dịch Vụ Thuê Sách" FontWeight="Bold" FontSize="12" Foreground="#92400E" Margin="0,0,0,4" />
                                    <TextBlock Text="Tiết kiệm tới 85% chi phí! Chọn gói thuê 7 ngày (15%), 14 ngày (25%) hoặc 30 ngày (40%) và trả sách dễ dàng ngay trên hệ thống." 
                                               FontSize="11" Foreground="#B45309" TextWrapping="Wrap" LineHeight="16" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- RIGHT MAIN CATALOG -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- HERO BANNER -->
                    <Border Grid.Row="0" Margin="20,16,20,10" CornerRadius="14" Padding="26,18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4F46E5" Offset="0" />
                                <GradientStop Color="#6366F1" Offset="0.5" />
                                <GradientStop Color="#06B6D4" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <Border Background="#30FFFFFF" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,6">
                                    <TextBlock Text="✨ HIỆU SÁCH TRỰC TUYẾN • MUA SỞ HỮU &amp; THUÊ SÁCH TIẾT KIỆM" FontWeight="Bold" FontSize="11" Foreground="White" />
                                </Border>
                                <TextBlock Text="Chào mừng bạn đến với BookStore (/homepage)" FontWeight="Black" FontSize="22" Foreground="White" Margin="0,0,0,4" />
                                <TextBlock Text="Mua sách chính hãng giao tận nơi hoặc đăng ký thuê sách theo tuần/tháng với chi phí chỉ từ 15% giá bìa." 
                                           FontSize="13" Foreground="#E0E7FF" TextWrapping="Wrap" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                                <Border Background="#25FFFFFF" CornerRadius="12" Padding="14,8" Margin="4,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="txtTotalBooksChip" Text="10+" FontWeight="Black" FontSize="18" Foreground="White" HorizontalAlignment="Center" />
                                        <TextBlock Text="Đầu sách" FontSize="11" Foreground="#E0E7FF" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#25FFFFFF" CornerRadius="12" Padding="14,8" Margin="4,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="txtTotalRentBooksChip" Text="0" FontWeight="Black" FontSize="18" Foreground="#FDE68A" HorizontalAlignment="Center" />
                                        <TextBlock Text="Sách cho thuê" FontSize="11" Foreground="#FEF3C7" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#25FFFFFF" CornerRadius="12" Padding="14,8" Margin="4,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="txtTotalCategoriesChip" Text="5" FontWeight="Black" FontSize="18" Foreground="White" HorizontalAlignment="Center" />
                                        <TextBlock Text="Thể loại" FontSize="11" Foreground="#E0E7FF" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- CATALOG CONTROLS BAR -->
                    <Border Grid.Row="1" Margin="20,4,20,8">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Kệ Sách Trực Tuyến" FontWeight="Bold" FontSize="18" Foreground="#0F172A" VerticalAlignment="Center" />
                                <Border Background="#EEF2FF" CornerRadius="12" Padding="8,2" Margin="10,0,14,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtResultCount" Text="Hiển thị: 0 sách" FontSize="12" FontWeight="SemiBold" Foreground="#4F46E5" />
                                </Border>

                                <!-- Quick Mode Filter Pills -->
                                <Button Content="Tất Cả" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" FontSize="11" Margin="0,0,6,0" Click="btnQuickTabAll_Click" />
                                <Button Content="🛍️ Sách Mua" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" FontSize="11" Margin="0,0,6,0" Click="btnQuickTabBuy_Click" />
                                <Button Content="📅 Sách Cho Thuê" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" FontSize="11" Click="btnQuickTabRent_Click" />
                            </StackPanel>

                            <!-- Sorting Options -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="Sắp xếp theo:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="cbSortBy" Width="180" Padding="10,6" SelectionChanged="cbSortBy_SelectionChanged">
                                    <ComboBoxItem Content="Mặc định (Mới nhất)" IsSelected="True" />
                                    <ComboBoxItem Content="Giá: Thấp đến cao" />
                                    <ComboBoxItem Content="Giá: Cao đến thấp" />
                                    <ComboBoxItem Content="Tên: A -> Z" />
                                    <ComboBoxItem Content="Tên: Z -> A" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- BOOK GRID ITEMS -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="12,0,12,20">
                        <Grid>
                            <!-- EMPTY STATE (Shown when 0 books match) -->
                            <StackPanel x:Name="panelEmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60,0,0">
                                <TextBlock Text="🔍" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                <TextBlock Text="Không tìm thấy quyển sách nào!" FontWeight="Bold" FontSize="18" Foreground="#334155" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <TextBlock Text="Vui lòng thử tìm kiếm với từ khóa khác hoặc bấm 'Đặt Lại Bộ Lọc'." FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,14" />
                                <Button Content="Đặt Lại Bộ Lọc" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" Click="btnResetFilters_Click" />
                            </StackPanel>

                            <!-- BOOK CARDS CONTAINER -->
                            <ItemsControl x:Name="icBooks">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- BOOK CARD -->
                                        <Border Width="244" Height="392" Margin="8,8,8,12" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Effect="{StaticResource CardShadow}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="175" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- 1. COVER PHOTO / PLACEHOLDER -->
                                                <Border Grid.Row="0" CornerRadius="12,12,0,0" ClipToBounds="True">
                                                    <Grid>
                                                        <Image Source="{Binding CoverImage}" Stretch="UniformToFill" 
                                                               Visibility="{Binding HasCoverImage, Converter={StaticResource BoolToVisConverter}}" />

                                                        <Border Visibility="{Binding HasNoCoverImage, Converter={StaticResource BoolToVisConverter}}" Padding="12">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#4338CA" Offset="0" />
                                                                    <GradientStop Color="#6D28D9" Offset="0.6" />
                                                                    <GradientStop Color="#0284C7" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <TextBlock Text="📖" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold" Foreground="White" 
                                                                           TextAlignment="Center" TextWrapping="Wrap" MaxHeight="45" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Category Badge (Top Left) -->
                                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" 
                                                                Background="#D9000000" CornerRadius="6" Padding="6,2">
                                                            <TextBlock Text="{Binding CategoryName}" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                                        </Border>

                                                        <!-- Status Badge (Top Right) -->
                                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" 
                                                                Background="{Binding StatusBadgeColor}" CornerRadius="6" Padding="8,2">
                                                            <TextBlock Text="{Binding BookStatus}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <!-- 2. BOOK INFO -->
                                                <StackPanel Grid.Row="1" Margin="12,10,12,6">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" 
                                                               TextTrimming="CharacterEllipsis" MaxHeight="38" TextWrapping="Wrap" Margin="0,0,0,3" />
                                                    
                                                    <TextBlock Text="{Binding Author}" FontSize="11" Foreground="#64748B" 
                                                               TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />

                                                    <!-- Price and Stock -->
                                                    <Grid Margin="0,2,0,2">
                                                        <TextBlock Text="{Binding PrimaryPriceDisplay}" FontWeight="Black" FontSize="14" Foreground="#4F46E5" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding StockStatusText}" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding SecondaryPriceDisplay}" FontSize="11" Foreground="#D97706" FontWeight="SemiBold" />
                                                </StackPanel>

                                                <!-- 3. ACTIONS -->
                                                <Border Grid.Row="2" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Padding="10,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button Grid.Column="0" Content="Chi Tiết" Style="{StaticResource SecondaryButtonStyle}" 
                                                                Margin="0,0,5,0" Padding="8,6" FontSize="11"
                                                                Tag="{Binding}" Click="btnViewDetail_Click" />
                                                        <Button Grid.Column="1" Content="🛒 Mua" Style="{StaticResource PrimaryButtonStyle}" 
                                                                Margin="0,0,5,0" Padding="8,6" FontSize="11"
                                                                Tag="{Binding}" Click="btnAddToCart_Click" 
                                                                IsEnabled="{Binding IsInStock}" />
                                                        <Button Grid.Column="2" Content="📅 Thuê" Style="{StaticResource RentButtonStyle}" 
                                                                Padding="8,6" FontSize="11"
                                                                Tag="{Binding}" Click="btnOpenRentModal_Click" 
                                                                IsEnabled="{Binding IsInStock}" />
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </DockPanel>

        <!-- ==================== 3. MODAL OVERLAY: BOOK DETAIL POPUP ==================== -->
        <Grid x:Name="gridDetailModal" Background="#70000000" Visibility="Collapsed">
            <Border Width="660" MaxHeight="720" Background="#FFFFFF" CornerRadius="16" Effect="{StaticResource ModalShadow}" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Modal Header -->
                    <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,16">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📖 " FontSize="18" />
                                <TextBlock Text="Thông Tin Chi Tiết Sách" FontWeight="Bold" FontSize="16" Foreground="#0F172A" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Content="✕" Width="30" Height="30" Background="#F1F5F9" BorderThickness="0" 
                                    Foreground="#64748B" FontWeight="Bold" Cursor="Hand" HorizontalAlignment="Right" 
                                    Click="btnCloseDetail_Click" />
                        </Grid>
                    </Border>

                    <!-- Modal Content -->
                    <ScrollViewer Grid.Row="1" Padding="24,18" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="txtDetailTitle" Text="Clean Code" FontWeight="Black" FontSize="20" Foreground="#0F172A" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock x:Name="txtDetailAuthor" Text="Tác giả: Robert C. Martin" FontSize="13" Foreground="#475569" Margin="0,0,0,14" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Background="#EEF2FF" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                    <TextBlock x:Name="txtDetailCategory" Text="Công nghệ thông tin" FontSize="12" FontWeight="Bold" Foreground="#4F46E5" />
                                </Border>
                                <Border x:Name="borderDetailStatus" Background="#10B981" CornerRadius="6" Padding="10,4">
                                    <TextBlock x:Name="txtDetailStatus" Text="Bán" FontSize="12" FontWeight="Bold" Foreground="White" />
                                </Border>
                            </StackPanel>

                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                        <TextBlock Text="Giá Mua Sở Hữu" FontSize="11" Foreground="#64748B" />
                                        <TextBlock x:Name="txtDetailPrice" Text="450.000 đ" FontWeight="Black" FontSize="18" Foreground="#4F46E5" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                        <TextBlock Text="Giá Thuê (7 ngày)" FontSize="11" Foreground="#64748B" />
                                        <TextBlock x:Name="txtDetailRentPrice" Text="68.000 đ / tuần" FontWeight="Black" FontSize="16" Foreground="#D97706" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                                        <TextBlock Text="Nhà Xuất Bản" FontSize="11" Foreground="#64748B" />
                                        <TextBlock x:Name="txtDetailPublisher" Text="Prentice Hall" FontWeight="SemiBold" FontSize="13" Foreground="#334155" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                                        <TextBlock Text="Năm Xuất Bản &amp; Tồn Kho" FontSize="11" Foreground="#64748B" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="txtDetailYear" Text="2008" FontWeight="SemiBold" FontSize="13" Foreground="#334155" />
                                            <TextBlock Text=" • " Foreground="#94A3B8" />
                                            <TextBlock x:Name="txtDetailStock" Text="Còn 20 cuốn" FontWeight="Bold" FontSize="13" Foreground="#10B981" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                                        <TextBlock Text="Mã Tiêu Chuẩn ISBN" FontSize="11" Foreground="#64748B" />
                                        <TextBlock x:Name="txtDetailIsbn" Text="9780132350884" FontWeight="SemiBold" FontSize="13" Foreground="#334155" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="MÔ TẢ NỘI DUNG SÁCH" FontWeight="Bold" FontSize="13" Foreground="#334155" Margin="0,0,0,6" />
                            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
                                <TextBlock x:Name="txtDetailDescription" Text="Mô tả..." FontSize="13" Foreground="#475569" TextWrapping="Wrap" LineHeight="20" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Modal Actions -->
                    <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,14" Background="#F8FAFC">
                        <Grid>
                            <Button Content="Đóng" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Click="btnCloseDetail_Click" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="btnDetailRentBook" Content="📅 Đăng Ký Thuê Sách" Style="{StaticResource RentButtonStyle}" Margin="0,0,10,0" Click="btnDetailRentBook_Click" />
                                <Button x:Name="btnDetailAddToCart" Content="🛒 Mua Sở Hữu (Thêm Giỏ)" Style="{StaticResource PrimaryButtonStyle}" Click="btnDetailAddToCart_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 4. MODAL OVERLAY: BOOK RENTAL REGISTRATION ==================== -->
        <Grid x:Name="gridRentModal" Background="#70000000" Visibility="Collapsed">
            <Border Width="540" Background="#FFFFFF" CornerRadius="16" Effect="{StaticResource ModalShadow}" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,16" Background="#FFFBEB" CornerRadius="16,16,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📅 " FontSize="18" />
                                <TextBlock Text="Đăng Ký Thuê Sách Trực Tuyến" FontWeight="Bold" FontSize="16" Foreground="#92400E" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Content="✕" Width="30" Height="30" Background="#FEF3C7" BorderThickness="0"
                                    Foreground="#92400E" FontWeight="Bold" Cursor="Hand" HorizontalAlignment="Right"
                                    Click="btnCloseRentModal_Click" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="24,18">
                        <TextBlock x:Name="txtRentBookTitle" Text="Tên sách thuê" FontWeight="Black" FontSize="17" Foreground="#0F172A" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <TextBlock x:Name="txtRentBookOriginPrice" Text="Giá bìa gốc: 0 đ" FontSize="12" Foreground="#64748B" Margin="0,0,0,16" />

                        <TextBlock Text="1. CHỌN GÓI KỲ HẠN THUÊ SÁCH" FontWeight="Bold" FontSize="12" Foreground="#475569" Margin="0,0,0,8" />
                        <StackPanel Margin="0,0,0,16">
                            <RadioButton x:Name="rbRent7Days" Content="Gói 7 Ngày (1 tuần) — Phí thuê 15% giá bìa" IsChecked="True" Margin="0,4" FontWeight="SemiBold" Checked="RentOption_Changed" />
                            <RadioButton x:Name="rbRent14Days" Content="Gói 14 Ngày (2 tuần) — Phí thuê 25% giá bìa" Margin="0,4" FontWeight="SemiBold" Checked="RentOption_Changed" />
                            <RadioButton x:Name="rbRent30Days" Content="Gói 30 Ngày (1 tháng) — Phí thuê 40% giá bìa" Margin="0,4" FontWeight="SemiBold" Checked="RentOption_Changed" />
                        </StackPanel>

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Phí Thuê Trọn Gói:" FontSize="11" Foreground="#64748B" />
                                    <TextBlock x:Name="txtRentCalculatedFee" Text="0 đ" FontWeight="Black" FontSize="20" Foreground="#D97706" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Hạn Trả Sách Dự Kiến:" FontSize="11" Foreground="#64748B" />
                                    <TextBlock x:Name="txtRentDueDate" Text="09/11/2026" FontWeight="Bold" FontSize="15" Foreground="#0F172A" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="2. THÔNG TIN NHẬN SÁCH THUÊ" FontWeight="Bold" FontSize="12" Foreground="#475569" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Số điện thoại *" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" />
                                <TextBox x:Name="txtRentPhone" Style="{StaticResource SearchTextBoxStyle}" Text="0987654321" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Địa chỉ nhận &amp; hoàn trả sách *" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" />
                                <TextBox x:Name="txtRentAddress" Style="{StaticResource SearchTextBoxStyle}" Text="Đà Nẵng" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,14" Background="#F8FAFC" CornerRadius="0,0,16,16">
                        <Grid>
                            <Button Content="🛒 Thêm Vào Giỏ Thuê" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Click="btnAddRentToCart_Click" />
                            <Button Content="⚡ Xác Nhận Thuê Ngay" Style="{StaticResource RentButtonStyle}" HorizontalAlignment="Right" Click="btnConfirmRentNow_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 5. MODAL OVERLAY: SHOPPING CART & CHECKOUT POPUP ==================== -->
        <Grid x:Name="gridCartModal" Background="#70000000" Visibility="Collapsed">
            <Border Width="640" MaxHeight="740" Background="#FFFFFF" CornerRadius="16" Effect="{StaticResource ModalShadow}" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Cart Header -->
                    <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,16">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🛒 " FontSize="18" />
                                <TextBlock Text="Giỏ Hàng &amp; Thanh Toán Đơn Hàng" FontWeight="Bold" FontSize="16" Foreground="#0F172A" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Content="✕" Width="30" Height="30" Background="#F1F5F9" BorderThickness="0" 
                                    Foreground="#64748B" FontWeight="Bold" Cursor="Hand" HorizontalAlignment="Right" 
                                    Click="btnCloseCart_Click" />
                        </Grid>
                    </Border>

                    <!-- Cart Item List -->
                    <ScrollViewer Grid.Row="1" Padding="20,12" VerticalScrollBarVisibility="Auto" MaxHeight="310">
                        <StackPanel>
                            <!-- Empty Cart Note -->
                            <StackPanel x:Name="panelEmptyCart" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,30">
                                <TextBlock Text="🛍️" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                <TextBlock Text="Giỏ hàng của bạn đang trống" FontWeight="Bold" FontSize="15" Foreground="#64748B" HorizontalAlignment="Center" />
                                <TextBlock Text="Bạn có thể chọn Mua sở hữu hoặc Thuê sách từ kệ sách." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>

                            <ItemsControl x:Name="icCartItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Item Title, Badge & Unit Price -->
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <Border Background="{Binding TypeBadgeColor}" CornerRadius="4" Padding="6,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TypeBadgeText}" FontSize="10" FontWeight="Bold" Foreground="{Binding TypeTextColor}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" TextTrimming="CharacterEllipsis" MaxWidth="250" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding FormattedUnitPrice}" FontSize="12" Foreground="#64748B" />
                                                </StackPanel>

                                                <!-- Quantity Controls -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                                    <Button Content="-" Width="24" Height="24" Padding="0" Tag="{Binding}" Click="btnDecreaseQty_Click" Style="{StaticResource SecondaryButtonStyle}" />
                                                    <TextBlock Text="{Binding Quantity}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="8,0" />
                                                    <Button Content="+" Width="24" Height="24" Padding="0" Tag="{Binding}" Click="btnIncreaseQty_Click" Style="{StaticResource SecondaryButtonStyle}" />
                                                </StackPanel>

                                                <!-- SubTotal -->
                                                <TextBlock Grid.Column="2" Text="{Binding FormattedSubTotal}" FontWeight="Black" FontSize="14" Foreground="#4F46E5" VerticalAlignment="Center" Margin="10,0" Width="95" TextAlignment="Right" />

                                                <!-- Remove Button -->
                                                <Button Grid.Column="3" Content="🗑️" Background="Transparent" BorderThickness="0" Cursor="Hand" Tag="{Binding}" Click="btnRemoveCartItem_Click" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Shipping & Payment Information Box -->
                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,14">
                        <StackPanel>
                            <TextBlock Text="🚚 THÔNG TIN GIAO NHẬN &amp; PHƯƠNG THỨC THANH TOÁN" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Số điện thoại nhận *" FontSize="11" Foreground="#64748B" Margin="0,0,0,3" />
                                    <TextBox x:Name="txtCheckoutPhone" Style="{StaticResource SearchTextBoxStyle}" Text="0987654321" Padding="10,6" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Phương thức thanh toán *" FontSize="11" Foreground="#64748B" Margin="0,0,0,3" />
                                    <ComboBox x:Name="cbCheckoutPaymentMethod" Padding="10,6">
                                        <ComboBoxItem Content="COD (Thanh toán khi nhận sách)" IsSelected="True" />
                                        <ComboBoxItem Content="Chuyển khoản Ngân hàng (VietQR)" />
                                        <ComboBoxItem Content="Ví điện tử MoMo / VNPay" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Địa chỉ giao sách *" FontSize="11" Foreground="#64748B" Margin="0,0,0,3" />
                            <TextBox x:Name="txtCheckoutAddress" Style="{StaticResource SearchTextBoxStyle}" Text="Số 1 Đại Cồ Việt, Hai Bà Trưng, Hà Nội" Padding="10,6" />
                        </StackPanel>
                    </Border>

                    <!-- Cart Footer / Total -->
                    <Border Grid.Row="3" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,14" Background="#FFFFFF" CornerRadius="0,0,16,16">
                        <Grid>
                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="Tổng Thanh Toán:" FontSize="12" Foreground="#64748B" />
                                <TextBlock x:Name="txtCartTotalAmount" Text="0 đ" FontWeight="Black" FontSize="20" Foreground="#4F46E5" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Tiếp Tục Chọn Sách" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="btnCloseCart_Click" />
                                <Button Content="✅ Đặt Hàng &amp; Lưu Hóa Đơn" Style="{StaticResource PrimaryButtonStyle}" Click="btnCheckout_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 6. MODAL OVERLAY: MY ORDERS & BOOK RENTALS ==================== -->
        <Grid x:Name="gridMyOrdersModal" Background="#70000000" Visibility="Collapsed">
            <Border Width="920" Height="640" Background="#FFFFFF" CornerRadius="16" Effect="{StaticResource ModalShadow}" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="22,16">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📦 " FontSize="18" />
                                <StackPanel>
                                    <TextBlock Text="Lịch Sử Đơn Mua &amp; Quản Lý Sách Đang Thuê" FontWeight="Bold" FontSize="16" Foreground="#0F172A" />
                                    <TextBlock x:Name="txtMyOrdersSubtitle" Text="Theo dõi trạng thái giao hàng và hoàn trả sách thuê trực tuyến" FontSize="12" Foreground="#64748B" />
                                </StackPanel>
                            </StackPanel>
                            <Button Content="✕" Width="30" Height="30" Background="#F1F5F9" BorderThickness="0"
                                    Foreground="#64748B" FontWeight="Bold" Cursor="Hand" HorizontalAlignment="Right"
                                    Click="btnCloseMyOrders_Click" />
                        </Grid>
                    </Border>

                    <!-- Filter Tabs -->
                    <Border Grid.Row="1" Background="#F8FAFC" Padding="22,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="📋 Tất Cả Đơn" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="btnFilterOrdersAll_Click" />
                            <Button Content="🛍️ Đơn Mua Sách" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="btnFilterOrdersBuy_Click" />
                            <Button Content="📅 Sách Thuê (Đang thuê / Đã trả)" Style="{StaticResource SecondaryButtonStyle}" Click="btnFilterOrdersRent_Click" />
                        </StackPanel>
                    </Border>

                    <!-- Orders List -->
                    <DataGrid x:Name="dgCustomerOrders" Grid.Row="2" Margin="20,14" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                              BorderBrush="#E2E8F0" BorderThickness="1" RowHeight="42" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã Đơn" Binding="{Binding OrderCode}" Width="85" FontWeight="Bold" />
                            <DataGridTextColumn Header="Hình Thức" Binding="{Binding OrderTypeDisplay}" Width="125" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Sách Đặt Mua / Thuê" Binding="{Binding ItemsSummary}" Width="*" />
                            <DataGridTextColumn Header="Tổng Tiền" Binding="{Binding FormattedTotalAmount}" Width="105" FontWeight="Bold" />
                            <DataGridTextColumn Header="Trạng Thái" Binding="{Binding StatusDisplay}" Width="115" FontWeight="Bold" />
                            <DataGridTextColumn Header="Ngày Đặt" Binding="{Binding FormattedCreatedAt}" Width="115" />
                            <DataGridTemplateColumn Header="Thao Tác" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="📥 Trả Sách" Padding="8,4" FontSize="11" Margin="0,0,4,0"
                                                    Style="{StaticResource RentButtonStyle}" Background="#10B981"
                                                    Visibility="{Binding CanReturnBook, Converter={StaticResource BoolToVisConverter}}"
                                                    Tag="{Binding}" Click="btnCustomerReturnBook_Click" />
                                            <Button Content="✖ Hủy Đơn" Padding="8,4" FontSize="11"
                                                    Style="{StaticResource SecondaryButtonStyle}" Foreground="#DC2626"
                                                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisConverter}}"
                                                    Tag="{Binding}" Click="btnCustomerCancelOrder_Click" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Footer -->
                    <Border Grid.Row="3" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="22,12" Background="#F8FAFC" CornerRadius="0,0,16,16">
                        <Grid>
                            <TextBlock Text="💡 Nhấn '📥 Trả Sách' khi bạn đã đọc xong sách thuê để hoàn kho và kết thúc kỳ hạn thuê." FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                            <Button Content="Đóng" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Click="btnCloseMyOrders_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
