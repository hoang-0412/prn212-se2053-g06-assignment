<Window x:Class="BookStoreManagementSystem.BookDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookStoreManagementSystem"
        mc:Ignorable="d"
        Title="BookStore - Chi Tiết Sách"
        Height="900" Width="1440"
        MinHeight="740" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI, Inter, Arial">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <DropShadowEffect x:Key="CardShadow" BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.07" Color="#0F172A" />
        <DropShadowEffect x:Key="ModalShadow" BlurRadius="32" Direction="270" ShadowDepth="8" Opacity="0.22" Color="#0F172A" />

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4F46E5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4338CA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3730A3" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#D97706" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B45309" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EEF2FF" />
            <Setter Property="Foreground" Value="#4F46E5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#C7D2FE" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0E7FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                                <Setter Property="BorderBrush" Value="#E2E8F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="38" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4F46E5" />
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 1. TOP NAVIGATION BAR ==================== -->
        <StackPanel Grid.Row="0" Panel.ZIndex="10">
            <local:StoreHeaderControl x:Name="headerControl" ActiveNav="Categories" />
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="28,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnBack" Content="⬅️ Quay Lại" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" FontSize="12" Margin="0,0,12,0" Click="btnBack_Click" />
                    <TextBlock x:Name="txtBreadcrumbRoute" Text="/books/detail" FontWeight="Bold" FontSize="12" Foreground="#4F46E5" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="›" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="txtBreadcrumbTitle" Text="Chi tiết tác phẩm" FontWeight="Bold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center" MaxWidth="500" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ==================== 2. MAIN SCROLLABLE CONTENT ==================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,22">
            <StackPanel MaxWidth="1360" HorizontalAlignment="Stretch">

                <!-- TOP CARD: BOOK GALLERY + FULL INFO & ACTIONS -->
                <Border Background="#FFFFFF" CornerRadius="18" Padding="28" Effect="{StaticResource CardShadow}" Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="420" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN: LARGE IMAGE VIEWER, GALLERY & ADMIN IMAGE CONTROLS -->
                        <StackPanel Grid.Column="0">
                            <!-- Main Cover Frame -->
                            <Border Height="420" CornerRadius="14" Background="#EEF2FF" BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <!-- Fallback when no image -->
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="📖" FontSize="68" HorizontalAlignment="Center" Opacity="0.35" />
                                        <TextBlock Text="BOOKSTORE COVER" FontSize="12" FontWeight="Bold" Foreground="#6366F1" Opacity="0.55" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                    </StackPanel>

                                    <!-- Actual Loaded Image -->
                                    <Image x:Name="imgMainCover" Stretch="Uniform" Margin="8" />

                                    <!-- Status Badge Top-Left -->
                                    <Border x:Name="borderStatusBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,14,0,0"
                                            CornerRadius="8" Padding="10,5" Background="#10B981">
                                        <TextBlock x:Name="txtStatusBadge" Text="Bán" Foreground="White" FontSize="12" FontWeight="Bold" />
                                    </Border>

                                    <!-- Image Counter Badge Top-Right -->
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0"
                                            CornerRadius="8" Padding="10,5" Background="#CC0F172A">
                                        <TextBlock x:Name="txtImageCounterBadge" Text="🖼️ Ảnh 1 / 1" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                    </Border>

                                    <!-- Prev / Next Image Arrows -->
                                    <Button x:Name="btnPrevImage" Content="◀" Width="36" Height="36" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                                            Background="#AA0F172A" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                            Click="btnPrevImage_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button x:Name="btnNextImage" Content="▶" Width="36" Height="36" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                            Background="#AA0F172A" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                            Click="btnNextImage_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Thumbnail Gallery Header -->
                            <Grid Margin="0,14,0,6">
                                <TextBlock x:Name="txtGalleryHeader" Text="🖼️ Album ảnh sách (1)" FontSize="12" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" />
                                <TextBlock Text="Bấm vào ảnh nhỏ để xem phóng to" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Thumbnail Strip -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                                <ItemsControl x:Name="icGalleryThumbnails">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,0,8,4" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    Tag="{Binding}" Click="btnSelectThumbnail_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Width="68" Height="84" CornerRadius="8" BorderBrush="{Binding BorderColor}" BorderThickness="2" Background="#F8FAFC" ClipToBounds="True">
                                                            <Grid>
                                                                <Image Source="{Binding ImageSource}" Stretch="UniformToFill" />
                                                                <Border VerticalAlignment="Bottom" Background="#CC4F46E5" Padding="2,2"
                                                                        Visibility="{Binding IsCover, Converter={StaticResource BoolToVisConverter}}">
                                                                    <TextBlock Text="⭐ Bìa" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- ADMIN ONLY: IMAGE MANAGEMENT PANEL -->
                            <Border x:Name="panelAdminImageManager" Visibility="Collapsed"
                                    Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="12" Padding="14,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="👑 QUẢN TRỊ ẢNH SÁCH (ADMIN)" FontSize="11" FontWeight="Black" Foreground="#B45309" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Tải thêm ảnh mới từ máy tính hoặc chọn ảnh bìa chính cho sách:" FontSize="11" Foreground="#92400E" Margin="0,0,0,10" TextWrapping="Wrap" />

                                    <UniformGrid Columns="2" Rows="2">
                                        <Button Content="➕ Thêm Ảnh Mới" Style="{StaticResource PrimaryButtonStyle}" Padding="8,8" FontSize="11" Margin="0,0,4,6"
                                                Click="btnAdminAddImages_Click" />
                                        <Button Content="🔄 Đổi Ảnh Bìa" Style="{StaticResource RentButtonStyle}" Padding="8,8" FontSize="11" Margin="4,0,0,6"
                                                Click="btnAdminReplaceCover_Click" />
                                        <Button x:Name="btnAdminSetAsCover" Content="⭐ Đặt Làm Bìa" Style="{StaticResource SecondaryButtonStyle}" Padding="8,7" FontSize="11" Margin="0,0,4,0"
                                                Click="btnAdminSetAsCover_Click" />
                                        <Button x:Name="btnAdminDeleteImage" Content="🗑️ Xóa Ảnh Này" Style="{StaticResource SecondaryButtonStyle}" Padding="8,7" FontSize="11" Margin="4,0,0,0"
                                                Foreground="#DC2626" BorderBrush="#FECACA" Background="#FEF2F2"
                                                Click="btnAdminDeleteImage_Click" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- RIGHT COLUMN: BOOK DETAILS, BUY & RENT OPTIONS, DESCRIPTION -->
                        <StackPanel Grid.Column="2">
                            <!-- Top Badges Row -->
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,6">
                                    <TextBlock x:Name="txtCategoryBadge" Text="📚 Công nghệ thông tin" Foreground="#4F46E5" FontSize="12" FontWeight="Bold" />
                                </Border>
                                <Border x:Name="borderStockBadge" Background="#DCFCE7" CornerRadius="6" Padding="10,4" Margin="0,0,8,6">
                                    <TextBlock x:Name="txtStockBadge" Text="Còn 15 cuốn" Foreground="#15803D" FontSize="12" FontWeight="Bold" />
                                </Border>
                                <Border Background="#F1F5F9" CornerRadius="6" Padding="10,4" Margin="0,0,0,6">
                                    <TextBlock x:Name="txtBookCodeBadge" Text="#BOOK-001" Foreground="#475569" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                            </WrapPanel>

                            <!-- Book Title & Author -->
                            <TextBlock x:Name="txtBookTitle" Text="Tên Tác Phẩm Sách" FontSize="26" FontWeight="Black" Foreground="#0F172A" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock x:Name="txtBookAuthor" Text="Tác giả: Đang cập nhật" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,18" />

                            <!-- Metadata 4-Column Cards -->
                            <UniformGrid Columns="4" Margin="0,0,0,20">
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="NHÀ XUẤT BẢN" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                        <TextBlock x:Name="txtPublisher" Text="Đang cập nhật" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="4,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="NĂM XUẤT BẢN" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                        <TextBlock x:Name="txtPublicationYear" Text="2024" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="4,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="MÃ ISBN" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                        <TextBlock x:Name="txtIsbn" Text="978-..." FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="TỒN KHO HIỆN TẠI" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                        <TextBlock x:Name="txtStockCount" Text="15 cuốn" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- DUAL PURCHASE & RENTAL BOX -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Option 1: Buy Book -->
                                <Border Grid.Column="0" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1.5" CornerRadius="14" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="🛍️ MUA SỞ HỮU VĨNH VIỄN" FontSize="11" FontWeight="Black" Foreground="#4338CA" />
                                        <TextBlock x:Name="txtBuyPrice" Text="150,000 đ" FontSize="26" FontWeight="Black" Foreground="#4F46E5" Margin="0,6,0,4" />
                                        <TextBlock Text="Sách mới 100%, giao tận nơi và tích lũy đơn hàng." FontSize="11" Foreground="#475569" Margin="0,0,0,14" />

                                        <!-- Quantity Selector -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,14">
                                            <TextBlock Text="Số lượng mua:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <Button Content="−" Width="30" Height="30" Style="{StaticResource SecondaryButtonStyle}" Padding="0" Click="btnDecreaseQty_Click" />
                                            <Border Width="44" Height="30" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Margin="6,0">
                                                <TextBlock x:Name="txtBuyQuantity" Text="1" FontSize="13" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Button Content="+" Width="30" Height="30" Style="{StaticResource SecondaryButtonStyle}" Padding="0" Click="btnIncreaseQty_Click" />
                                        </StackPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="btnAddToCartBuy" Grid.Column="0" Content="🛒 Thêm Vào Giỏ" Style="{StaticResource PrimaryButtonStyle}" Padding="10,10" Click="btnAddToCartBuy_Click" />
                                            <Button x:Name="btnBuyNow" Grid.Column="2" Content="⚡ Mua Ngay" Style="{StaticResource SecondaryButtonStyle}" Background="White" Padding="10,10" Click="btnBuyNow_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Option 2: Rent Book -->
                                <Border Grid.Column="2" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1.5" CornerRadius="14" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="📅 ĐĂNG KÝ THUÊ SÁCH TIẾT KIỆM" FontSize="11" FontWeight="Black" Foreground="#B45309" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,8">
                                            <TextBlock x:Name="txtSelectedRentPrice" Text="22,000 đ" FontSize="26" FontWeight="Black" Foreground="#D97706" />
                                            <TextBlock x:Name="txtSelectedRentDaysLabel" Text=" / 7 ngày" FontSize="13" FontWeight="Bold" Foreground="#92400E" VerticalAlignment="Bottom" Margin="4,0,0,4" />
                                        </StackPanel>

                                        <!-- Rental Duration Radio Buttons -->
                                        <StackPanel Margin="0,0,0,12">
                                            <RadioButton x:Name="rbRent7Days" Content="Gói 7 ngày (1 tuần) - Tiết kiệm 85%" IsChecked="True" FontSize="12" FontWeight="SemiBold" Foreground="#78350F" Margin="0,0,0,4" Checked="RentPackage_Changed" />
                                            <RadioButton x:Name="rbRent14Days" Content="Gói 14 ngày (2 tuần) - Tiết kiệm 75%" FontSize="12" FontWeight="SemiBold" Foreground="#78350F" Margin="0,0,0,4" Checked="RentPackage_Changed" />
                                            <RadioButton x:Name="rbRent30Days" Content="Gói 30 ngày (1 tháng) - Đọc thả ga" FontSize="12" FontWeight="SemiBold" Foreground="#78350F" Checked="RentPackage_Changed" />
                                        </StackPanel>

                                        <TextBlock x:Name="txtExpectedDueDate" Text="Hạn trả dự kiến: --/--/----" FontSize="11" FontWeight="SemiBold" Foreground="#B45309" Margin="0,0,0,10" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="btnAddRentToCart" Grid.Column="0" Content="🛒 Giỏ Thuê" Style="{StaticResource RentButtonStyle}" Padding="10,10" Click="btnAddRentToCart_Click" />
                                            <Button x:Name="btnRentNow" Grid.Column="2" Content="📅 Thuê Ngay" Style="{StaticResource SecondaryButtonStyle}" Background="White" BorderBrush="#F59E0B" Foreground="#B45309" Padding="10,10" Click="btnRentNow_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Book Description Box -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="📝 GIỚI THIỆU NỘI DUNG TÁC PHẨM" FontSize="12" FontWeight="Black" Foreground="#334155" Margin="0,0,0,8" />
                                    <TextBlock x:Name="txtDescription" Text="Mô tả chi tiết nội dung sách..." FontSize="13.5" Foreground="#334155" TextWrapping="Wrap" LineHeight="22" />
                                </StackPanel>
                            </Border>

                            <!-- ADMIN ONLY: QUICK STOCK & PRICE UPDATE BAR -->
                            <Border x:Name="panelAdminQuickBookActions" Visibility="Collapsed"
                                    Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="12" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="🛠️ CẬP NHẬT NHANH KHO &amp; GIÁ (ADMIN)" FontSize="11" FontWeight="Black" Foreground="#6D28D9" />
                                        <TextBlock Text="Chỉnh nhanh giá bán, tồn kho và hình thức ngay trên trang chi tiết" FontSize="11" Foreground="#5B21B6" />
                                    </StackPanel>

                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="Giá (đ):" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBox x:Name="txtAdminQuickPrice" Width="105" Style="{StaticResource InputTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="Tồn kho:" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBox x:Name="txtAdminQuickStock" Width="70" Style="{StaticResource InputTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Hình thức:" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <ComboBox x:Name="cbAdminQuickStatus" Width="110" Height="38" VerticalContentAlignment="Center">
                                                <ComboBoxItem Content="Bán" />
                                                <ComboBoxItem Content="Cho thuê" />
                                            </ComboBox>
                                        </StackPanel>
                                    </WrapPanel>

                                    <Button Grid.Column="2" Content="💾 Lưu Thay Đổi" Style="{StaticResource PrimaryButtonStyle}" Padding="14,9" Click="btnAdminSaveQuickBook_Click" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ==================== 3. RELATED BOOKS SECTION ==================== -->
                <Border Background="#FFFFFF" CornerRadius="18" Padding="24" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="📖 Sách Cùng Thể Loại &amp; Gợi Ý Cho Bạn" FontSize="18" FontWeight="Black" Foreground="#0F172A" />
                                <TextBlock x:Name="txtRelatedSubtitle" Text="Khám phá thêm các đầu sách liên quan đang có sẵn tại BookStore" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Content="Xem tất cả sách →" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="btnGoBookList_Click" />
                        </Grid>

                        <ItemsControl x:Name="icRelatedBooks">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="240" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Margin="0,0,16,12" Padding="12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="150" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" CornerRadius="8" Background="#EEF2FF" ClipToBounds="True">
                                                <Grid>
                                                    <TextBlock Text="📘" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.35" />
                                                    <Image Source="{Binding CoverImage}" Stretch="UniformToFill"
                                                           Visibility="{Binding HasCoverImage, Converter={StaticResource BoolToVisConverter}}" />
                                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0" CornerRadius="6" Padding="7,3" Background="{Binding StatusBadgeColor}">
                                                        <TextBlock Text="{Binding BookStatus}" Foreground="White" FontSize="10" FontWeight="Bold" />
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Row="1" Margin="0,10,0,8">
                                                <TextBlock Text="{Binding CategoryName}" FontSize="10" FontWeight="Bold" Foreground="#4F46E5" />
                                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" TextTrimming="CharacterEllipsis" Height="36" TextWrapping="Wrap" Margin="0,2,0,2" />
                                                <TextBlock Text="{Binding Author}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <Grid Grid.Row="2">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FormattedPrice}" FontSize="14" FontWeight="Black" Foreground="#4F46E5" />
                                                    <TextBlock Text="{Binding FormattedRentalHint}" FontSize="10" Foreground="#D97706" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <Button Content="Xem Sách →" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="10,6" FontSize="11"
                                                        Tag="{Binding}" Click="btnOpenRelatedBook_Click" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== 4. QUICK RENT CONFIRMATION MODAL ==================== -->
        <Grid x:Name="gridQuickRentModal" Grid.Row="0" Grid.RowSpan="2" Background="#880F172A" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Background="White" CornerRadius="16" Padding="24" Effect="{StaticResource ModalShadow}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="📅 Xác Nhận Đăng Ký Thuê Sách" FontSize="18" FontWeight="Black" Foreground="#0F172A" VerticalAlignment="Center" />
                        <Button Content="✕" Width="30" Height="30" HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}" Padding="0" Click="btnCloseQuickRentModal_Click" />
                    </Grid>

                    <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock x:Name="txtModalRentBookTitle" Text="Tên sách" FontWeight="Bold" FontSize="14" Foreground="#92400E" TextWrapping="Wrap" />
                            <TextBlock x:Name="txtModalRentSummary" Text="Gói thuê: 7 ngày • Phí thuê: 22,000 đ" FontSize="12" FontWeight="SemiBold" Foreground="#B45309" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="SỐ ĐIỆN THOẠI LIÊN HỆ *" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4" />
                    <TextBox x:Name="txtModalRentPhone" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,12" />

                    <TextBlock Text="ĐỊA CHỈ NHẬN &amp; HOÀN TRẢ SÁCH *" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4" />
                    <TextBox x:Name="txtModalRentAddress" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,18" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Hủy Bỏ" Style="{StaticResource SecondaryButtonStyle}" Click="btnCloseQuickRentModal_Click" />
                        <Button Grid.Column="2" Content="✅ Xác Nhận Thuê Ngay" Style="{StaticResource RentButtonStyle}" Click="btnConfirmQuickRent_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
