<UserControl x:Class="BookStoreManagementSystem.StoreHeaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="68" d:DesignWidth="1280"
             FontFamily="Segoe UI, Inter, Arial">

    <UserControl.Resources>
        <Style x:Key="HeaderPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4F46E5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4338CA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EEF2FF" />
            <Setter Property="Foreground" Value="#4F46E5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#C7D2FE" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0E7FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderAdminButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderPrimaryButtonStyle}">
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#4F46E5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#CBD5E1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="28,10">
        <Grid MinHeight="44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Brand Logo -->
            <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Click="btnNavHome_Click" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="G07" FontWeight="Black" FontSize="20" Foreground="#0F172A" />
                    <TextBlock Text=" BookStore" FontWeight="Black" FontSize="20" Foreground="#4F46E5" />
                </StackPanel>
            </Button>

            <!-- Center: Navigation Links -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Margin="4,0">
                    <Button x:Name="btnNavHome" Content="Trang Chủ" Style="{StaticResource HeaderNavButtonStyle}" Click="btnNavHome_Click" />
                    <Border x:Name="indNavHome" Height="2" Background="#4F46E5" CornerRadius="1" Margin="10,-2,10,0" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Margin="4,0">
                    <Button x:Name="btnNavCategories" Content="Tất Cả Danh Mục" Style="{StaticResource HeaderNavButtonStyle}" Click="btnNavCategories_Click" />
                    <Border x:Name="indNavCategories" Height="2" Background="#4F46E5" CornerRadius="1" Margin="10,-2,10,0" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Margin="4,0">
                    <Button x:Name="btnNavRentals" Content="Sách Cho Thuê" Style="{StaticResource HeaderNavButtonStyle}" Click="btnNavRentals_Click" />
                    <Border x:Name="indNavRentals" Height="2" Background="#4F46E5" CornerRadius="1" Margin="10,-2,10,0" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Margin="4,0">
                    <Button x:Name="btnNavPromotions" Content="Khuyến Mãi" Style="{StaticResource HeaderNavButtonStyle}" Click="btnNavPromotions_Click" />
                    <Border x:Name="indNavPromotions" Height="2" Background="#4F46E5" CornerRadius="1" Margin="10,-2,10,0" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>

            <!-- Right: Search Icon, Cart Icon, User / Login Actions -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Search Icon -->
                <Button x:Name="btnToggleSearch" Content="🔍" Style="{StaticResource HeaderIconButtonStyle}" Margin="0,0,8,0"
                        ToolTip="Tìm kiếm sách" Click="btnToggleSearch_Click" />

                <!-- Cart Icon Button with Badge -->
                <Grid Margin="0,0,10,0">
                    <Button x:Name="btnOpenCart" Content="🛒" Style="{StaticResource HeaderIconButtonStyle}"
                            ToolTip="Mở giỏ hàng" Click="btnOpenCart_Click" />
                    <Border x:Name="badgeCartCount" Background="#4F46E5" CornerRadius="8" MinWidth="16" Height="16" Padding="4,0"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-4,0" IsHitTestVisible="False" Visibility="Collapsed">
                        <TextBlock x:Name="txtCartBadge" Text="0" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- Logged-in User Dropdown Container -->
                <Grid x:Name="gridUserMenu" Visibility="Collapsed">
                    <Button x:Name="btnUserMenu" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                            Padding="12,7" Cursor="Hand" Click="btnUserMenu_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="22" Height="22" CornerRadius="11" Background="#EEF2FF" Margin="0,0,8,0">
                                            <TextBlock Text="👤" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock x:Name="txtCurrentUserName" Text="Người dùng" FontWeight="SemiBold" FontSize="12.5" Foreground="#0F172A" VerticalAlignment="Center" />
                                        <TextBlock Text=" ▾" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="4,0,0,0" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#EEF2FF" />
                                        <Setter TargetName="border" Property="BorderBrush" Value="#C7D2FE" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Popup x:Name="popupUserMenu" PlacementTarget="{Binding ElementName=btnUserMenu}"
                           Placement="Bottom" HorizontalOffset="-40" VerticalOffset="8"
                           StaysOpen="False" AllowsTransparency="True">
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="8" MinWidth="205">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" Direction="270" ShadowDepth="4" Opacity="0.12" Color="#0F172A" />
                            </Border.Effect>
                            <StackPanel>
                                <!-- User Name Header (No Role) -->
                                <Border Padding="10,8" Margin="0,0,0,4" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                    <TextBlock x:Name="txtDropdownUserName" Text="Người dùng" FontWeight="Bold" FontSize="13" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                                </Border>

                                <!-- Admin Dashboard (Admin only) -->
                                <Button x:Name="btnOpenAdmin" Content="🛠️ Admin Dashboard" HorizontalContentAlignment="Left"
                                        Background="Transparent" BorderThickness="0" Padding="10,8" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A"
                                        Cursor="Hand" Click="btnOpenAdmin_Click" />

                                <!-- Orders -->
                                <Button x:Name="btnOpenMyOrders" Content="📦 Đơn Hàng" HorizontalContentAlignment="Left"
                                        Background="Transparent" BorderThickness="0" Padding="10,8" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155"
                                        Cursor="Hand" Click="btnOpenMyOrders_Click" />

                                <!-- Profile -->
                                <Button x:Name="btnOpenProfile" Content="👤 Hồ Sơ" HorizontalContentAlignment="Left"
                                        Background="Transparent" BorderThickness="0" Padding="10,8" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155"
                                        Cursor="Hand" Click="btnOpenProfile_Click" />

                                <Border Height="1" Background="#F1F5F9" Margin="6,4" />

                                <!-- Logout -->
                                <Button x:Name="btnLogoutMenuItem" Content="🚪 Đăng Xuất" HorizontalContentAlignment="Left"
                                        Background="Transparent" BorderThickness="0" Padding="10,8" FontSize="12.5" FontWeight="SemiBold" Foreground="#DC2626"
                                        Cursor="Hand" Click="btnAuthAction_Click" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Guest Login Button -->
                <Button x:Name="btnAuthAction" Content="👤 Đăng Nhập" Style="{StaticResource HeaderPrimaryButtonStyle}" Click="btnAuthAction_Click" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
