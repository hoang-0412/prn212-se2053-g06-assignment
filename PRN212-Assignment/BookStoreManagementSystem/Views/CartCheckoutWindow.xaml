<Window x:Class="BookStoreManagementSystem.CartCheckoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookStoreManagementSystem"
        mc:Ignorable="d"
        Title="BookStore - Giỏ Hàng &amp; Thanh Toán"
        Height="880" Width="1420"
        MinHeight="720" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI, Inter, Arial">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <DropShadowEffect x:Key="CardShadow" BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.07" Color="#0F172A" />
        <DropShadowEffect x:Key="ModalShadow" BlurRadius="32" Direction="270" ShadowDepth="8" Opacity="0.22" Color="#0F172A" />

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4F46E5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4338CA" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#10B981" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#059669" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EEF2FF" />
            <Setter Property="Foreground" Value="#4F46E5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#C7D2FE" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0E7FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="40" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4F46E5" />
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 1. TOP NAVIGATION BAR ==================== -->
        <local:StoreHeaderControl x:Name="headerControl" Grid.Row="0" ActiveNav="" />

        <!-- ==================== 2. MAIN CONTENT ==================== -->
        <Grid Grid.Row="1" Margin="24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="450" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: CART ITEMS LIST + VOUCHER SELECTION -->
            <DockPanel Grid.Column="0" LastChildFill="True">
                <!-- Top Summary & Actions -->
                <Border DockPanel.Dock="Top" Background="White" CornerRadius="14" Padding="18,14" Margin="0,0,0,14" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="txtCartHeaderCount" Text="🛒 Giỏ Hàng Của Bạn (0 sản phẩm)" FontSize="17" FontWeight="Black" Foreground="#0F172A" />
                            <TextBlock Text="Bạn có thể chuyển đổi từng cuốn sách giữa chế độ Mua Sở Hữu hoặc Thuê 7/14/30 Ngày ngay tại đây" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="➕ Thêm Sách Khác" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="btnGoBookList_Click" />
                            <Button Content="🗑️ Xóa Trống Giỏ" Style="{StaticResource SecondaryButtonStyle}" Foreground="#DC2626" BorderBrush="#FECACA" Background="#FEF2F2" Click="btnClearCart_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Bottom Promo Voucher Strip -->
                <Border DockPanel.Dock="Bottom" Background="White" CornerRadius="14" Padding="18,14" Margin="0,14,0,0" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="🎟️ MÃ GIẢM GIÁ / KHUYẾN MÃI" FontSize="11" FontWeight="Black" Foreground="#4F46E5" />
                            <TextBlock Text="Bấm chọn nhanh hoặc nhập mã:" FontSize="11" Foreground="#64748B" />
                        </StackPanel>

                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Content="BOOK10 (-10%)" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="11" Margin="0,0,6,0" Tag="BOOK10" Click="btnQuickVoucher_Click" />
                            <Button Content="SINHVIEN (-15%)" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="11" Margin="0,0,6,0" Tag="SINHVIEN" Click="btnQuickVoucher_Click" />
                            <Button Content="FREESHIP (-25K)" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="11" Margin="0,0,6,0" Tag="FREESHIP" Click="btnQuickVoucher_Click" />
                            <Button Content="VIP50K (-50K đơn ≥300K)" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="11" Tag="VIP50K" Click="btnQuickVoucher_Click" />
                        </WrapPanel>

                        <ComboBox x:Name="cbSavedVouchers" Grid.Row="1" Grid.Column="1" DisplayMemberPath="DisplayText" Padding="8,6" Margin="0,10,6,0" SelectionChanged="cbSavedVouchers_SelectionChanged" />
                        <TextBox x:Name="txtVoucherCode" Grid.Row="1" Grid.Column="2" Style="{StaticResource InputTextBoxStyle}" Margin="8,10,8,0" ToolTip="Nhập mã voucher rồi bấm Áp Dụng Mã" />
                        <Button Grid.Row="1" Grid.Column="3" Content="Áp Dụng Mã" Style="{StaticResource PrimaryButtonStyle}" Margin="0,10,0,0" Click="btnApplyVoucher_Click" />
                    </Grid>
                </Border>

                <!-- Center: Cart Items List -->
                <Border Background="White" CornerRadius="14" Padding="18" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <!-- Empty State -->
                        <StackPanel x:Name="panelEmptyCart" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🛒" FontSize="56" HorizontalAlignment="Center" Opacity="0.4" />
                            <TextBlock Text="Giỏ hàng của bạn đang trống!" FontSize="18" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center" Margin="0,10,0,4" />
                            <TextBlock Text="Hãy khám phá kho sách để chọn mua hoặc đăng ký thuê những cuốn sách yêu thích." FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,16" />
                            <Button Content="📚 Khám Phá Danh Sách Sách Ngay →" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" Click="btnGoBookList_Click" />
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="icCartItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Book Cover -->
                                                <Border Grid.Column="0" Width="64" Height="86" CornerRadius="8" Background="#EEF2FF" BorderBrush="#CBD5E1" BorderThickness="1" ClipToBounds="True">
                                                    <Grid>
                                                        <TextBlock Text="📘" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4" />
                                                        <Image Source="{Binding CoverImage}" Stretch="UniformToFill"
                                                               Visibility="{Binding HasCoverImage, Converter={StaticResource BoolToVisConverter}}" />
                                                    </Grid>
                                                </Border>

                                                <!-- Title & Mode Switcher -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <Border Background="{Binding TypeBadgeColor}" CornerRadius="6" Padding="8,2" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding TypeBadgeText}" Foreground="{Binding TypeTextColor}" FontSize="11" FontWeight="Bold" />
                                                        </Border>
                                                        <TextBlock Text="{Binding FormattedUnitPrice}" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />

                                                    <!-- Mode Switcher Buttons -->
                                                    <WrapPanel Orientation="Horizontal">
                                                        <Button Content="🛍️ Mua sở hữu" Padding="8,4" FontSize="11" Margin="0,0,6,0" Style="{StaticResource SecondaryButtonStyle}"
                                                                Tag="{Binding}" Click="btnSwitchItemToBuy_Click" />
                                                        <Button Content="📅 Thuê 7 ngày" Padding="8,4" FontSize="11" Margin="0,0,6,0" Style="{StaticResource SecondaryButtonStyle}"
                                                                Tag="{Binding}" Click="btnSwitchItemToRent7_Click" />
                                                        <Button Content="📅 Thuê 14 ngày" Padding="8,4" FontSize="11" Margin="0,0,6,0" Style="{StaticResource SecondaryButtonStyle}"
                                                                Tag="{Binding}" Click="btnSwitchItemToRent14_Click" />
                                                        <Button Content="📅 Thuê 30 ngày" Padding="8,4" FontSize="11" Style="{StaticResource SecondaryButtonStyle}"
                                                                Tag="{Binding}" Click="btnSwitchItemToRent30_Click" />
                                                    </WrapPanel>
                                                </StackPanel>

                                                <!-- Quantity Adjust -->
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                                                    <Button Content="−" Width="30" Height="30" Padding="0" Style="{StaticResource SecondaryButtonStyle}" Tag="{Binding}" Click="btnDecreaseItem_Click" />
                                                    <Border Width="40" Height="30" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Margin="6,0">
                                                        <TextBlock Text="{Binding Quantity}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Button Content="+" Width="30" Height="30" Padding="0" Style="{StaticResource SecondaryButtonStyle}" Tag="{Binding}" Click="btnIncreaseItem_Click" />
                                                </StackPanel>

                                                <!-- Item Subtotal -->
                                                <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0">
                                                    <TextBlock Text="Thành tiền" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding FormattedSubTotal}" FontSize="15" FontWeight="Black" Foreground="#4F46E5" HorizontalAlignment="Right" />
                                                </StackPanel>

                                                <!-- Remove Button -->
                                                <Button Grid.Column="5" Content="✕" Width="32" Height="32" Padding="0" VerticalAlignment="Center"
                                                        Style="{StaticResource SecondaryButtonStyle}" Foreground="#DC2626" BorderBrush="#FECACA" Background="#FEF2F2"
                                                        Tag="{Binding}" Click="btnRemoveItem_Click" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </DockPanel>

            <!-- RIGHT COLUMN: SHIPPING INFO, PAYMENT METHOD & ORDER SUMMARY -->
            <Border Grid.Column="2" Background="White" CornerRadius="16" Padding="22" Effect="{StaticResource CardShadow}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="🧾 Thông Tin Giao Nhận &amp; Thanh Toán" FontSize="17" FontWeight="Black" Foreground="#0F172A" Margin="0,0,0,14" />

                        <TextBlock Text="HỌ TÊN NGƯỜI NHẬN *" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4" />
                        <TextBox x:Name="txtRecipientName" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,10" />

                        <TextBlock Text="SỐ ĐIỆN THOẠI LIÊN HỆ *" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4" />
                        <TextBox x:Name="txtRecipientPhone" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,10" />

                        <TextBlock Text="ĐỊA CHỈ GIAO SÁCH / HOÀN TRẢ *" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4" />
                        <TextBox x:Name="txtShippingAddress" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,10" />

                        <TextBlock Text="GHI CHÚ ĐƠN HÀNG (TÙY CHỌN)" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4" />
                        <TextBox x:Name="txtOrderNote" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,14" />

                        <TextBlock Text="PHƯƠNG THỨC THANH TOÁN *" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6" />
                        <ComboBox x:Name="cbPaymentMethod" Height="40" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,12" SelectionChanged="cbPaymentMethod_SelectionChanged">
                            <ComboBoxItem Content="Tiền mặt khi nhận hàng (COD)" IsSelected="True" />
                            <ComboBoxItem Content="Chuyển khoản ngân hàng (VietQR)" />
                            <ComboBoxItem Content="Ví điện tử MoMo / VNPay" />
                        </ComboBox>

                        <!-- QR Bank Transfer Preview Box -->
                        <Border x:Name="borderQrTransferInfo" Visibility="Collapsed" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="🏦 THÔNG TIN CHUYỂN KHOẢN VIETQR" FontSize="11" FontWeight="Black" Foreground="#4338CA" />
                                <TextBlock Text="• Ngân hàng: MB Bank / Vietcombank" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,4,0,0" />
                                <TextBlock Text="• Số tài khoản: 0987654321999 - BOOKSTORE VN" FontSize="12" FontWeight="Bold" Foreground="#4F46E5" />
                                <TextBlock Text="• Nội dung CK: THANHTOAN BOOKSTORE" FontSize="11" Foreground="#475569" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Financial Summary Box -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Tạm tính:" FontSize="13" Foreground="#475569" />
                                    <TextBlock x:Name="txtSummarySubtotal" Text="0 đ" FontSize="13" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Phí vận chuyển:" FontSize="13" Foreground="#475569" />
                                    <TextBlock x:Name="txtSummaryShipping" Text="25,000 đ" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock x:Name="txtSummaryDiscountLabel" Text="Giảm giá Voucher:" FontSize="13" Foreground="#10B981" />
                                    <TextBlock x:Name="txtSummaryDiscount" Text="-0 đ" FontSize="13" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right" />
                                </Grid>
                                <Border Height="1" Background="#E2E8F0" Margin="0,0,0,10" />
                                <Grid>
                                    <TextBlock Text="TỔNG THANH TOÁN:" FontSize="14" FontWeight="Black" Foreground="#0F172A" VerticalAlignment="Center" />
                                    <TextBlock x:Name="txtSummaryFinalTotal" Text="0 đ" FontSize="22" FontWeight="Black" Foreground="#4F46E5" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button x:Name="btnPlaceOrder" Content="✅ Xác Nhận Đặt Hàng &amp; Xuất Hóa Đơn" Style="{StaticResource SuccessButtonStyle}" Click="btnPlaceOrder_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ==================== 3. INVOICE CONFIRMATION MODAL ==================== -->
        <Grid x:Name="gridInvoiceModal" Grid.Row="0" Grid.RowSpan="2" Background="#880F172A" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Width="540" VerticalAlignment="Center" HorizontalAlignment="Center" Background="White" CornerRadius="18" Padding="28" Effect="{StaticResource ModalShadow}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Width="48" Height="48" CornerRadius="24" Background="#DCFCE7" Margin="0,0,12,0">
                            <TextBlock Text="🎉" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Đặt Hàng Thành Công!" FontSize="20" FontWeight="Black" Foreground="#0F172A" />
                            <TextBlock x:Name="txtInvoiceOrderCode" Text="Mã hóa đơn: #ORD-0001" FontSize="13" FontWeight="Bold" Foreground="#10B981" />
                        </StackPanel>
                    </StackPanel>

                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,18">
                        <TextBlock x:Name="txtInvoiceContent" FontFamily="Consolas, Segoe UI" FontSize="12.5" Foreground="#1E293B" TextWrapping="Wrap" LineHeight="20" />
                    </Border>

                    <UniformGrid Columns="3">
                        <Button Content="💾 Xuất File Hóa Đơn" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Click="btnExportInvoiceFile_Click" />
                        <Button Content="📦 Xem Đơn Của Tôi" Style="{StaticResource PrimaryButtonStyle}" Margin="3,0,3,0" Click="btnGoMyOrders_Click" />
                        <Button Content="Đóng" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0" Click="btnCloseInvoiceModal_Click" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

