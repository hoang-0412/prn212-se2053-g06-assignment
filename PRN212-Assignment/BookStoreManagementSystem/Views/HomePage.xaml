<Window x:Class="BookStoreManagementSystem.HomePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookStoreManagementSystem"
        mc:Ignorable="d"
        Title="BookStore - Website Hiệu Sách Trực Tuyến" 
        Height="860" Width="1380"
        MinHeight="720" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI, Inter, Arial">

    <Window.Resources>
        <!-- Card Drop Shadow -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" Direction="270" ShadowDepth="3" Opacity="0.08" Color="#0F172A" />
        <DropShadowEffect x:Key="ModalShadow" BlurRadius="25" Direction="270" ShadowDepth="8" Opacity="0.25" Color="#000000" />

        <!-- Converter for Boolean to Visibility -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <!-- Modern Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4F46E5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4338CA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3730A3" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#D97706" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B45309" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EEF2FF" />
            <Setter Property="Foreground" Value="#4F46E5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#C7D2FE" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0E7FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header Nav Link Style -->
        <Style x:Key="HeaderNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#4F46E5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Circular Header Icon Button Style -->
        <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#CBD5E1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded TextBox Style -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4F46E5" />
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- MAIN WINDOW CONTENT -->
        <DockPanel LastChildFill="True">

            <!-- 1. TOP HEADER / APP BAR -->
            <StackPanel DockPanel.Dock="Top">
                <local:StoreHeaderControl x:Name="headerControl"
                                          ActiveNav="Home"
                                          HomeClicked="headerControl_HomeClicked"
                                          RentalsClicked="headerControl_RentalsClicked"
                                          FeaturedClicked="headerControl_FeaturedClicked"
                                          PromotionsClicked="headerControl_PromotionsClicked"
                                          SearchClicked="headerControl_SearchClicked" />

                <!-- Expandable Search Bar (toggled by 🔍 icon) -->
                <Border x:Name="gridHeaderSearchBar" Visibility="Collapsed" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,10">
                    <Grid MaxWidth="560" HorizontalAlignment="Center" Width="560">
                        <TextBox x:Name="txtSearch" 
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 Padding="36,8,30,8"
                                 TextChanged="txtSearch_TextChanged" />
                        <TextBlock Text="🔍" FontSize="14" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False" />
                        <TextBlock x:Name="txtSearchPlaceholder" 
                                   Text="Tìm sách theo tên, tác giả, NXB..." 
                                   Foreground="#94A3B8" FontSize="13" 
                                   VerticalAlignment="Center" HorizontalAlignment="Left" 
                                   Margin="36,0,0,0" IsHitTestVisible="False" />
                        <Button x:Name="btnClearSearch" Content="✖" 
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" 
                                Background="Transparent" BorderThickness="0" Foreground="#94A3B8" 
                                Cursor="Hand" Click="btnClearSearch_Click" Visibility="Collapsed" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 2. MAIN SCROLLABLE PAGE BODY -->
            <ScrollViewer x:Name="svHomeMain" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#F8FAFC">
                <StackPanel>

                    <!-- ==================== A. DARK HERO BANNER + SPOTLIGHT BOOK ==================== -->
                    <Border Padding="40,42">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0B1120" Offset="0" />
                                <GradientStop Color="#1E1B4B" Offset="0.55" />
                                <GradientStop Color="#312E81" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid MaxWidth="1180" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.25*" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Hero Copy & CTAs -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="14" Padding="12,5" HorizontalAlignment="Left" Margin="0,0,0,16">
                                    <TextBlock Text="✨ Nhà Sách Trực Tuyến Hàng Đầu Việt Nam" FontSize="11.5" FontWeight="SemiBold" Foreground="#C7D2FE" />
                                </Border>

                                <TextBlock FontWeight="Black" FontSize="36" Foreground="White" LineHeight="44">
                                    <Run Text="Khơi Nguồn " /><Run Text="Tri Thức" Foreground="#38BDF8" />
                                </TextBlock>
                                <TextBlock Text="Nâng Tầm Tương Lai" FontWeight="Black" FontSize="36" Foreground="White" Margin="0,0,0,14" />

                                <TextBlock Text="Khám phá hơn 10.000+ tựa sách chọn lọc từ các tác giả danh tiếng thế giới và Việt Nam. Giao sách hỏa tốc, bao bọc cẩn thận, ưu đãi thành viên lên tới 30%."
                                           FontSize="13.5" Foreground="#CBD5E1" TextWrapping="Wrap" LineHeight="21" MaxWidth="540" HorizontalAlignment="Left" Margin="0,0,0,22" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
                                    <Button Content="Khám Phá Sách Ngay" Style="{StaticResource PrimaryButtonStyle}" Padding="20,11" FontSize="13" Margin="0,0,12,0" Click="btnHeroExplore_Click" />
                                    <Button Content="Xem Sách Bán Chạy" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#475569" BorderThickness="1"
                                            FontWeight="SemiBold" FontSize="13" Padding="20,11" Cursor="Hand" Click="btnHeroBestSellers_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>

                                <!-- 3 KPI Stats -->
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Margin="0,0,36,0">
                                        <TextBlock Text="10.000+" FontWeight="Black" FontSize="22" Foreground="White" />
                                        <TextBlock Text="Đầu sách bản quyền" FontSize="11.5" Foreground="#94A3B8" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,36,0">
                                        <TextBlock Text="50.000+" FontWeight="Black" FontSize="22" Foreground="White" />
                                        <TextBlock Text="Độc giả tin dùng" FontSize="11.5" Foreground="#94A3B8" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="99.8%" FontWeight="Black" FontSize="22" Foreground="White" />
                                        <TextBlock Text="Đánh giá hài lòng" FontSize="11.5" Foreground="#94A3B8" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Right Spotlight Book Card -->
                            <Border Grid.Column="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="16" Padding="20" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="borderSpotlight_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="115" Height="162" CornerRadius="10" ClipToBounds="True" Background="#0F172A">
                                        <Grid>
                                            <TextBlock Text="📖" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image x:Name="imgSpotlightCover" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Border Background="#10B981" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,8">
                                            <TextBlock Text="SÁCH TIÊU BIỂU TUẦN NÀY" FontSize="9.5" FontWeight="Bold" Foreground="White" />
                                        </Border>
                                        <TextBlock x:Name="txtSpotlightTitle" Text="Đắc Nhân Tâm" FontWeight="Black" FontSize="17" Foreground="White" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                                        <TextBlock x:Name="txtSpotlightAuthor" Text="Tác giả: Dale Carnegie" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,6" />
                                        <TextBlock Text="⭐ Đánh giá: 5.0 (1.320+ lượt mua)" FontSize="11" Foreground="#FBBF24" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <TextBlock x:Name="txtSpotlightPrice" Text="98.000 đ" FontWeight="Black" FontSize="20" Foreground="#2DD4BF" Margin="0,0,0,6" />
                                        <TextBlock x:Name="txtSpotlightDesc" Text="Nghệ thuật giao tiếp và thu phục lòng người..." FontSize="11.5" Foreground="#CBD5E1" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ==================== B. CATEGORY FILTER PILLS STRIP ==================== -->
                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,14">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxWidth="1180">
                            <ItemsControl x:Name="icCategoryPills">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,10,0" Cursor="Hand" Tag="{Binding}" Click="btnCategoryPill_Click" BorderThickness="1" BorderBrush="#E2E8F0" Background="#F8FAFC" Padding="14,7">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="pillBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                                                            <Border Background="#E2E8F0" CornerRadius="10" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Count}" FontSize="10.5" FontWeight="Bold" Foreground="#475569" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="pillBorder" Property="Background" Value="#EEF2FF" />
                                                            <Setter TargetName="pillBorder" Property="BorderBrush" Value="#818CF8" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- ==================== C. FEATURED BESTSELLERS (4 BOOKS) ==================== -->
                    <StackPanel x:Name="panelFeaturedSection" MaxWidth="1180" Margin="24,28,24,10" HorizontalAlignment="Center" Width="1180">
                        <StackPanel Margin="8,0,8,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Sách Nổi Bật Bán Chạy" FontWeight="Black" FontSize="22" Foreground="#0F172A" VerticalAlignment="Center" />
                                <Border Background="#FEE2E2" CornerRadius="10" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="BÁN CHẠY" FontSize="10" FontWeight="Bold" Foreground="#DC2626" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Những tựa sách được độc giả quan tâm nhất" FontSize="12.5" Foreground="#64748B" Margin="0,4,0,0" />
                        </StackPanel>

                        <ItemsControl x:Name="icFeaturedBooks">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="8,6,8,12" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Effect="{StaticResource CardShadow}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="245" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Cover -->
                                            <Border Grid.Row="0" CornerRadius="14,14,0,0" ClipToBounds="True" Background="#1E1B4B" Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="cardBook_MouseLeftButtonUp">
                                                <Grid>
                                                    <Image Source="{Binding CoverImage}" Stretch="UniformToFill" Visibility="{Binding HasCoverImage, Converter={StaticResource BoolToVisConverter}}" />
                                                    <Border Visibility="{Binding HasNoCoverImage, Converter={StaticResource BoolToVisConverter}}" Padding="14">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#4338CA" Offset="0" />
                                                                <GradientStop Color="#6D28D9" Offset="0.6" />
                                                                <GradientStop Color="#0284C7" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock Text="📖" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="White" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="52" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Background="#D90F172A" CornerRadius="6" Padding="8,3">
                                                        <TextBlock Text="{Binding CategoryName}" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                                    </Border>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Background="{Binding StatusBadgeColor}" CornerRadius="6" Padding="8,3">
                                                        <TextBlock Text="{Binding BookStatus}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                                    </Border>
                                                    <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Content="📷 Thêm Ảnh" Padding="8,3" FontSize="10"
                                                            Style="{StaticResource RentButtonStyle}" Background="#4F46E5"
                                                            Visibility="{Binding IsAdminActionVisible, Converter={StaticResource BoolToVisConverter}}"
                                                            Tag="{Binding}" Click="btnAdminUploadCardImage_Click" />
                                                </Grid>
                                            </Border>

                                            <!-- Info -->
                                            <StackPanel Grid.Row="1" Margin="14,12,14,6">
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13.5" Foreground="#0F172A" TextTrimming="CharacterEllipsis" MaxHeight="38" TextWrapping="Wrap" Margin="0,0,0,4" />
                                                <TextBlock Text="{Binding Author, StringFormat='Tác giả: {0}'}" FontSize="11.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                                                <TextBlock FontSize="11" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding StockStatusText, Mode=OneWay}" Foreground="#10B981" FontWeight="SemiBold" />
                                                    <Run Text=" • " Foreground="#CBD5E1" />
                                                    <Run Text="{Binding PublisherDisplay, Mode=OneWay}" Foreground="#64748B" />
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Price + Action -->
                                            <Grid Grid.Row="2" Margin="14,6,14,14">
                                                <TextBlock Text="{Binding FormattedPrice}" FontWeight="Black" FontSize="15" Foreground="#4F46E5" VerticalAlignment="Center" />
                                                <Button Content="🛒 Thêm" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="12,5" FontSize="11.5"
                                                        Tag="{Binding}" Click="btnQuickCardAction_Click" IsEnabled="{Binding IsInStock}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ==================== D. BOOK CATALOG SECTION (8 BOOKS / PAGE) ==================== -->
                    <StackPanel x:Name="panelCatalogSection" MaxWidth="1180" Margin="24,18,24,10" HorizontalAlignment="Center" Width="1180">
                        <StackPanel Margin="8,0,8,12">
                            <TextBlock Text="Danh Mục Sách" FontWeight="Black" FontSize="22" Foreground="#0F172A" />
                            <TextBlock Text="Khám phá kho sách phong phú từ cơ sở dữ liệu hệ thống." FontSize="12.5" Foreground="#64748B" Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Controls Strip -->
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16,10" Margin="8,0,8,14" Effect="{StaticResource CardShadow}">
                            <Grid>
                                <TextBlock x:Name="txtCatalogCountSummary" Text="Hiển thị 0 trên tổng số 0 cuốn sách" FontSize="12.5" Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="Sắp xếp:" FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox x:Name="cbSortBy" Width="165" Padding="10,5" SelectionChanged="cbSortBy_SelectionChanged">
                                        <ComboBoxItem Content="Mới nhất" IsSelected="True" />
                                        <ComboBoxItem Content="Giá: Thấp đến cao" />
                                        <ComboBoxItem Content="Giá: Cao đến thấp" />
                                        <ComboBoxItem Content="Tên: A -> Z" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Empty State -->
                        <StackPanel x:Name="panelEmptyState" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,40,0,40">
                            <TextBlock Text="🔍" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,10" />
                            <TextBlock Text="Không tìm thấy quyển sách nào!" FontWeight="Bold" FontSize="17" Foreground="#334155" HorizontalAlignment="Center" Margin="0,0,0,6" />
