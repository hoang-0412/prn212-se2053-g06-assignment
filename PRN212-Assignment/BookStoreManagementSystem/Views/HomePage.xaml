                        <TextBlock Text="1. CHỌN GÓI KỲ HẠN THUÊ SÁCH" FontWeight="Bold" FontSize="12" Foreground="#475569" Margin="0,0,0,8" />
                        <StackPanel Margin="0,0,0,16">
                            <RadioButton x:Name="rbRent7Days" Content="Gói 7 Ngày (1 tuần) — Phí thuê 15% giá bìa" IsChecked="True" Margin="0,4" FontWeight="SemiBold" Checked="RentOption_Changed" />
                            <RadioButton x:Name="rbRent14Days" Content="Gói 14 Ngày (2 tuần) — Phí thuê 25% giá bìa" Margin="0,4" FontWeight="SemiBold" Checked="RentOption_Changed" />
                            <RadioButton x:Name="rbRent30Days" Content="Gói 30 Ngày (1 tháng) — Phí thuê 40% giá bìa" Margin="0,4" FontWeight="SemiBold" Checked="RentOption_Changed" />
                        </StackPanel>

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Phí Thuê Trọn Gói:" FontSize="11" Foreground="#64748B" />
                                    <TextBlock x:Name="txtRentCalculatedFee" Text="0 đ" FontWeight="Black" FontSize="20" Foreground="#D97706" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Hạn Trả Sách Dự Kiến:" FontSize="11" Foreground="#64748B" />
                                    <TextBlock x:Name="txtRentDueDate" Text="09/11/2026" FontWeight="Bold" FontSize="15" Foreground="#0F172A" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="2. THÔNG TIN NHẬN SÁCH THUÊ" FontWeight="Bold" FontSize="12" Foreground="#475569" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Số điện thoại *" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" />
                                <TextBox x:Name="txtRentPhone" Style="{StaticResource SearchTextBoxStyle}" Text="0987654321" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Địa chỉ nhận &amp; hoàn trả sách *" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" />
                                <TextBox x:Name="txtRentAddress" Style="{StaticResource SearchTextBoxStyle}" Text="Đà Nẵng" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,14" Background="#F8FAFC" CornerRadius="0,0,16,16">
                        <Grid>
                            <Button Content="🛒 Thêm Vào Giỏ Thuê" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Click="btnAddRentToCart_Click" />
                            <Button Content="⚡ Xác Nhận Thuê Ngay" Style="{StaticResource RentButtonStyle}" HorizontalAlignment="Right" Click="btnConfirmRentNow_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 5. MODAL OVERLAY: SHOPPING CART & CHECKOUT POPUP ==================== -->
        <Grid x:Name="gridCartModal" Background="#70000000" Visibility="Collapsed">
            <Border Width="640" MaxHeight="740" Background="#FFFFFF" CornerRadius="16" Effect="{StaticResource ModalShadow}" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Cart Header -->
                    <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,16">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🛒 " FontSize="18" />
                                <TextBlock Text="Giỏ Hàng &amp; Thanh Toán Đơn Hàng" FontWeight="Bold" FontSize="16" Foreground="#0F172A" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Content="✕" Width="30" Height="30" Background="#F1F5F9" BorderThickness="0" 
                                    Foreground="#64748B" FontWeight="Bold" Cursor="Hand" HorizontalAlignment="Right" 
                                    Click="btnCloseCart_Click" />
                        </Grid>
                    </Border>

                    <!-- Cart Item List -->
                    <ScrollViewer Grid.Row="1" Padding="20,12" VerticalScrollBarVisibility="Auto" MaxHeight="310">
                        <StackPanel>
                            <!-- Empty Cart Note -->
                            <StackPanel x:Name="panelEmptyCart" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,30">
                                <TextBlock Text="🛍️" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                <TextBlock Text="Giỏ hàng của bạn đang trống" FontWeight="Bold" FontSize="15" Foreground="#64748B" HorizontalAlignment="Center" />
                                <TextBlock Text="Bạn có thể chọn Mua sở hữu hoặc Thuê sách từ kệ sách." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>

                            <ItemsControl x:Name="icCartItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Book Cover Thumbnail in Cart -->
                                                <Border Grid.Column="0" Width="40" Height="50" CornerRadius="6" ClipToBounds="True" Background="#E0E7FF" Margin="0,0,10,0">
                                                    <Grid>
                                                        <TextBlock Text="📖" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Image Source="{Binding CoverImage}" Stretch="UniformToFill"
                                                               Visibility="{Binding HasCoverImage, Converter={StaticResource BoolToVisConverter}}" />
                                                    </Grid>
                                                </Border>

                                                <!-- Item Title, Badge & Unit Price -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <Border Background="{Binding TypeBadgeColor}" CornerRadius="4" Padding="6,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TypeBadgeText}" FontSize="10" FontWeight="Bold" Foreground="{Binding TypeTextColor}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding FormattedUnitPrice}" FontSize="12" Foreground="#64748B" />
                                                </StackPanel>

                                                <!-- Quantity Controls -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                                    <Button Content="-" Width="24" Height="24" Padding="0" Tag="{Binding}" Click="btnDecreaseQty_Click" Style="{StaticResource SecondaryButtonStyle}" />
                                                    <TextBlock Text="{Binding Quantity}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="8,0" />
                                                    <Button Content="+" Width="24" Height="24" Padding="0" Tag="{Binding}" Click="btnIncreaseQty_Click" Style="{StaticResource SecondaryButtonStyle}" />
                                                </StackPanel>

                                                <!-- SubTotal -->
                                                <TextBlock Grid.Column="3" Text="{Binding FormattedSubTotal}" FontWeight="Black" FontSize="14" Foreground="#4F46E5" VerticalAlignment="Center" Margin="10,0" Width="95" TextAlignment="Right" />

                                                <!-- Remove Button -->
                                                <Button Grid.Column="4" Content="🗑️" Background="Transparent" BorderThickness="0" Cursor="Hand" Tag="{Binding}" Click="btnRemoveCartItem_Click" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Shipping & Payment Information Box -->
                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,14">
                        <StackPanel>
                            <TextBlock Text="🚚 THÔNG TIN GIAO NHẬN &amp; PHƯƠNG THỨC THANH TOÁN" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Số điện thoại nhận *" FontSize="11" Foreground="#64748B" Margin="0,0,0,3" />
                                    <TextBox x:Name="txtCheckoutPhone" Style="{StaticResource SearchTextBoxStyle}" Text="0987654321" Padding="10,6" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Phương thức thanh toán *" FontSize="11" Foreground="#64748B" Margin="0,0,0,3" />
                                    <ComboBox x:Name="cbCheckoutPaymentMethod" Padding="10,6">
                                        <ComboBoxItem Content="COD (Thanh toán khi nhận sách)" IsSelected="True" />
                                        <ComboBoxItem Content="Chuyển khoản Ngân hàng (VietQR)" />
                                        <ComboBoxItem Content="Ví điện tử MoMo / VNPay" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Địa chỉ giao sách *" FontSize="11" Foreground="#64748B" Margin="0,0,0,3" />
                            <TextBox x:Name="txtCheckoutAddress" Style="{StaticResource SearchTextBoxStyle}" Text="Số 1 Đại Cồ Việt, Hai Bà Trưng, Hà Nội" Padding="10,6" />
                        </StackPanel>
                    </Border>

                    <!-- Cart Footer / Total -->
                    <Border Grid.Row="3" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,14" Background="#FFFFFF" CornerRadius="0,0,16,16">
                        <Grid>
                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="Tổng Thanh Toán:" FontSize="12" Foreground="#64748B" />
                                <TextBlock x:Name="txtCartTotalAmount" Text="0 đ" FontWeight="Black" FontSize="20" Foreground="#4F46E5" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Tiếp Tục Chọn Sách" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="btnCloseCart_Click" />
                                <Button Content="✅ Đặt Hàng &amp; Lưu Hóa Đơn" Style="{StaticResource PrimaryButtonStyle}" Click="btnCheckout_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 6. MODAL OVERLAY: MY ORDERS & BOOK RENTALS ==================== -->
        <Grid x:Name="gridMyOrdersModal" Background="#70000000" Visibility="Collapsed">
            <Border Width="920" Height="640" Background="#FFFFFF" CornerRadius="16" Effect="{StaticResource ModalShadow}" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="22,16">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📦 " FontSize="18" />
                                <StackPanel>
                                    <TextBlock Text="Lịch Sử Đơn Mua &amp; Quản Lý Sách Đang Thuê" FontWeight="Bold" FontSize="16" Foreground="#0F172A" />
                                    <TextBlock x:Name="txtMyOrdersSubtitle" Text="Theo dõi trạng thái giao hàng và hoàn trả sách thuê trực tuyến" FontSize="12" Foreground="#64748B" />
                                </StackPanel>
                            </StackPanel>
                            <Button Content="✕" Width="30" Height="30" Background="#F1F5F9" BorderThickness="0"
                                    Foreground="#64748B" FontWeight="Bold" Cursor="Hand" HorizontalAlignment="Right"
                                    Click="btnCloseMyOrders_Click" />
                        </Grid>
                    </Border>

                    <!-- Filter Tabs -->
                    <Border Grid.Row="1" Background="#F8FAFC" Padding="22,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="📋 Tất Cả Đơn" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="btnFilterOrdersAll_Click" />
                            <Button Content="🛍️ Đơn Mua Sách" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="btnFilterOrdersBuy_Click" />
                            <Button Content="📅 Sách Thuê (Đang thuê / Đã trả)" Style="{StaticResource SecondaryButtonStyle}" Click="btnFilterOrdersRent_Click" />
                        </StackPanel>
                    </Border>

                    <!-- Orders List -->
                    <DataGrid x:Name="dgCustomerOrders" Grid.Row="2" Margin="20,14" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                              BorderBrush="#E2E8F0" BorderThickness="1" RowHeight="42" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã Đơn" Binding="{Binding OrderCode}" Width="85" FontWeight="Bold" />
                            <DataGridTextColumn Header="Hình Thức" Binding="{Binding OrderTypeDisplay}" Width="125" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Sách Đặt Mua / Thuê" Binding="{Binding ItemsSummary}" Width="*" />
                            <DataGridTextColumn Header="Tổng Tiền" Binding="{Binding FormattedTotalAmount}" Width="105" FontWeight="Bold" />
                            <DataGridTextColumn Header="Trạng Thái" Binding="{Binding StatusDisplay}" Width="115" FontWeight="Bold" />
                            <DataGridTextColumn Header="Ngày Đặt" Binding="{Binding FormattedCreatedAt}" Width="115" />
                            <DataGridTemplateColumn Header="Thao Tác" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="📥 Trả Sách" Padding="8,4" FontSize="11" Margin="0,0,4,0"
                                                    Style="{StaticResource RentButtonStyle}" Background="#10B981"
                                                    Visibility="{Binding CanReturnBook, Converter={StaticResource BoolToVisConverter}}"
                                                    Tag="{Binding}" Click="btnCustomerReturnBook_Click" />
                                            <Button Content="✖ Hủy Đơn" Padding="8,4" FontSize="11"
                                                    Style="{StaticResource SecondaryButtonStyle}" Foreground="#DC2626"
                                                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisConverter}}"
                                                    Tag="{Binding}" Click="btnCustomerCancelOrder_Click" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Footer -->
                    <Border Grid.Row="3" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="22,12" Background="#F8FAFC" CornerRadius="0,0,16,16">
                        <Grid>
                            <TextBlock Text="💡 Nhấn '📥 Trả Sách' khi bạn đã đọc xong sách thuê để hoàn kho và kết thúc kỳ hạn thuê." FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                            <Button Content="Đóng" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Click="btnCloseMyOrders_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
