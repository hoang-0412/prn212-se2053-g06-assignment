<Window x:Class="BookStoreManagementSystem.AdminDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BookStore - Admin Dashboard"
        Height="860" Width="1380"
        MinHeight="720" MinWidth="1150"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI, Inter, Arial">

    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="14" Direction="270" ShadowDepth="3" Opacity="0.07" Color="#0F172A" />
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4F46E5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4338CA" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EEF2FF" />
            <Setter Property="Foreground" Value="#4F46E5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#C7D2FE" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0E7FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#10B981" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#059669" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FEE2E2" />
            <Setter Property="Foreground" Value="#DC2626" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#FECACA" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FECACA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4F46E5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 1. LEFT SIDEBAR ==================== -->
        <Border Grid.Column="0" Background="#0F172A" Padding="18,22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Logo -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,22">
                    <Border Width="42" Height="42" CornerRadius="10" Background="#4F46E5" Margin="0,0,12,0">
                        <TextBlock Text="🛠️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ADMIN PORTAL" FontWeight="Black" FontSize="17" Foreground="White" />
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Menu -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="DANH MỤC QUẢN TRỊ" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="8,0,0,8" />

                    <Button x:Name="navOverview" Content="📊  Tổng Quan &amp; Thống Kê" Style="{StaticResource SidebarNavButtonStyle}" Click="navOverview_Click" />
                    <Button x:Name="navBooks" Content="📚  Quản Lý Sách (Mua/Thuê)" Style="{StaticResource SidebarNavButtonStyle}" Click="navBooks_Click" />
                    <Button x:Name="navCategories" Content="🗂️  Quản Lý Thể Loại" Style="{StaticResource SidebarNavButtonStyle}" Click="navCategories_Click" />
                    <Button x:Name="navOrders" Content="🧾  Đơn Mua &amp; Thuê Sách" Style="{StaticResource SidebarNavButtonStyle}" Click="navOrders_Click" />
                    <Button x:Name="navUsers" Content="👥  Quản Lý Người Dùng" Style="{StaticResource SidebarNavButtonStyle}" Click="navUsers_Click" />
                    <Button x:Name="navVouchers" Content="🎟️  Quản Lý Voucher" Style="{StaticResource SidebarNavButtonStyle}" Click="navVouchers_Click" />

                    <Separator Background="#1E293B" Margin="0,16" />

                    <TextBlock Text="CÔNG CỤ NHANH" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="8,0,0,8" />
                    <Button Content="➕  Tạo Đơn Mua / Thuê Mới (POS)" Style="{StaticResource SidebarNavButtonStyle}" Foreground="#38BDF8" Click="btnOpenCreateOrderPos_Click" />
                    <Button Content="📥  Xuất Báo Cáo Thống Kê (.csv)" Style="{StaticResource SidebarNavButtonStyle}" Foreground="#FBBF24" Click="btnExportAdminReport_Click" />
                </StackPanel>

                <!-- Bottom Actions -->
                <StackPanel Grid.Row="2">
                    <Button Content="📚 Mở Trang Toàn Bộ Sách" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,8" Click="btnOpenAllBooks_Click" />
                    <Button Content="🏪 Mở Trang Chủ Cửa Hàng" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,8" Click="btnOpenStorefront_Click" />
                    <Button Content="🚪 Đăng Xuất Tài Khoản" Style="{StaticResource DangerButtonStyle}" Click="btnLogout_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 2. RIGHT MAIN CONTENT AREA ==================== -->
        <DockPanel Grid.Column="1" LastChildFill="True">

            <!-- TOP HEADER BAR -->
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="26,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" VerticalAlignment="Center">
                        <TextBlock x:Name="txtPageTitle" Text="Tổng Quan Hệ Thống (Dashboard)" FontWeight="Black" FontSize="20" Foreground="#0F172A" />
                        <TextBlock x:Name="txtPageSubtitle" Text="Theo dõi số liệu kinh doanh, sách bán, sách cho thuê và tồn kho theo thời gian thực" FontSize="12" Foreground="#64748B" />
                    </StackPanel>
                    <WrapPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,12,0,0">
                        <Button Content="➕ Tạo Đơn Mua / Thuê Mới" Style="{StaticResource SuccessButtonStyle}" Margin="0,0,10,0" Click="btnOpenCreateOrderPos_Click" />
                        <Button Content="🏪 Xem Giao Diện Khách Hàng" Style="{StaticResource SecondaryButtonStyle}" Click="btnOpenStorefront_Click" />
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- CONTENT VIEWS CONTAINER -->
            <Grid Margin="22,18">

                <!-- ==================== TAB 1: OVERVIEW ==================== -->
                <ScrollViewer x:Name="viewOverview" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 4 KPI CARDS -->
                        <UniformGrid Columns="4" Margin="0,0,0,18">
                            <!-- KPI 1: Revenue -->
                            <Border Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,12,0" Effect="{StaticResource CardShadow}" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="TỔNG DOANH THU" FontSize="11" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" />
                                        <Border Background="#DCFCE7" CornerRadius="8" Padding="8,4" HorizontalAlignment="Right">
                                            <TextBlock Text="💰" FontSize="14" />
                                        </Border>
                                    </Grid>
                                    <TextBlock x:Name="kpiTotalRevenue" Text="0 đ" FontWeight="Black" FontSize="22" Foreground="#0F172A" Margin="0,8,0,4" />
                                    <TextBlock x:Name="kpiRevenueSub" Text="Từ các đơn mua &amp; thuê sách" FontSize="11" Foreground="#10B981" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>

                            <!-- KPI 2: Books & Stock -->
                            <Border Background="White" CornerRadius="14" Padding="20,16" Margin="6,0,6,0" Effect="{StaticResource CardShadow}" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="KHO SÁCH HIỆN CÓ" FontSize="11" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" />
                                        <Border Background="#EEF2FF" CornerRadius="8" Padding="8,4" HorizontalAlignment="Right">
                                            <TextBlock Text="📚" FontSize="14" />
                                        </Border>
                                    </Grid>
                                    <TextBlock x:Name="kpiTotalBooks" Text="0 đầu sách" FontWeight="Black" FontSize="22" Foreground="#4F46E5" Margin="0,8,0,4" />
                                    <TextBlock x:Name="kpiBookSub" Text="Tổng tồn kho: 0 cuốn" FontSize="11" Foreground="#64748B" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>

                            <!-- KPI 3: Rental Books -->
                            <Border Background="White" CornerRadius="14" Padding="20,16" Margin="6,0,6,0" Effect="{StaticResource CardShadow}" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="DỊCH VỤ THUÊ SÁCH" FontSize="11" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" />
                                        <Border Background="#FEF3C7" CornerRadius="8" Padding="8,4" HorizontalAlignment="Right">
                                            <TextBlock Text="📅" FontSize="14" />
                                        </Border>
                                    </Grid>
                                    <TextBlock x:Name="kpiRentalBooks" Text="0 sách thuê" FontWeight="Black" FontSize="22" Foreground="#D97706" Margin="0,8,0,4" />
                                    <TextBlock x:Name="kpiRentalSub" Text="Cho thuê: 0 | Đang thuê: 0" FontSize="11" Foreground="#B45309" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>

                            <!-- KPI 4: Orders & Users -->
                            <Border Background="White" CornerRadius="14" Padding="20,16" Margin="12,0,0,0" Effect="{StaticResource CardShadow}" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="ĐƠN HÀNG &amp; KHÁCH" FontSize="11" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" />
                                        <Border Background="#E0F2FE" CornerRadius="8" Padding="8,4" HorizontalAlignment="Right">
                                            <TextBlock Text="🧾" FontSize="14" />
                                        </Border>
                                    </Grid>
                                    <TextBlock x:Name="kpiTotalOrders" Text="0 đơn hàng" FontWeight="Black" FontSize="22" Foreground="#0284C7" Margin="0,8,0,4" />
                                    <TextBlock x:Name="kpiOrderSub" Text="0 tài khoản thành viên" FontSize="11" Foreground="#64748B" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- SECOND ROW: CATEGORY BREAKDOWN + RECENT ORDERS -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="420" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Category Breakdown -->
                            <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="20" Margin="0,0,10,0" Effect="{StaticResource CardShadow}" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="📊 Phân Bổ Kho Sách Theo Thể Loại" FontWeight="Bold" FontSize="15" Foreground="#0F172A" Margin="0,0,0,14" />
                                    <ItemsControl x:Name="icCategoryStats">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,12">
                                                    <Grid Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding CategoryName}" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B" />
                                                        <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="#64748B">
                                                            <Run Text="{Binding BookCount}" FontWeight="Bold" Foreground="#4F46E5" />
                                                            <Run Text="đầu sách (" /><Run Text="{Binding TotalStock}" /><Run Text=" cuốn)" />
                                                        </TextBlock>
                                                    </Grid>
                                                    <ProgressBar Value="{Binding Percentage}" Maximum="100" Height="8" Foreground="#4F46E5" Background="#E2E8F0" BorderThickness="0" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Recent Orders & Rentals Table -->
                            <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="20" Margin="10,0,0,0" Effect="{StaticResource CardShadow}" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="🕒 Đơn Mua &amp; Thuê Sách Gần Đây" FontWeight="Bold" FontSize="15" Foreground="#0F172A" VerticalAlignment="Center" />
                                        <Button Content="Xem tất cả đơn →" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="10,4" FontSize="12" Click="navOrders_Click" />
                                    </Grid>
                                    <DataGrid x:Name="dgRecentOrders" AutoGenerateColumns="False" IsReadOnly="True" Height="230"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                                              BorderBrush="#E2E8F0" BorderThickness="1" RowHeight="36" Background="White">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Mã Đơn" Binding="{Binding OrderCode}" Width="90" FontWeight="Bold" />
                                            <DataGridTextColumn Header="Khách Hàng" Binding="{Binding CustomerName}" Width="140" />
                                            <DataGridTextColumn Header="Loại Đơn" Binding="{Binding OrderTypeDisplay}" Width="120" />
                                            <DataGridTextColumn Header="Tổng Tiền" Binding="{Binding FormattedTotalAmount}" Width="110" FontWeight="Bold" />
                                            <DataGridTextColumn Header="Trạng Thái" Binding="{Binding StatusDisplay}" Width="120" />
                                            <DataGridTextColumn Header="Ngày Tạo" Binding="{Binding FormattedCreatedAt}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>

                <!-- ==================== TAB 2: BOOKS MANAGEMENT ==================== -->
                <Grid x:Name="viewBooks" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="400" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Books DataGrid & Filters -->
                    <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="18" Margin="0,0,14,0" Effect="{StaticResource CardShadow}" BorderBrush="#E2E8F0" BorderThickness="1">
                        <DockPanel LastChildFill="True">
                            <!-- Filter Bar -->
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtAdminBookSearch" Grid.Column="0" Style="{StaticResource FormTextBoxStyle}"
                                         Margin="0,0,10,0" TextChanged="txtAdminBookSearch_TextChanged"
                                         ToolTip="Tìm theo tên sách, tác giả, ISBN..." />
                                <ComboBox x:Name="cbAdminBookCategoryFilter" Grid.Column="1" Margin="0,0,10,0" Padding="8,6" SelectionChanged="AdminBookFilter_Changed" />
                                <ComboBox x:Name="cbAdminBookStatusFilter" Grid.Column="2" Padding="8,6" SelectionChanged="AdminBookFilter_Changed">
                                    <ComboBoxItem Content="Tất cả hình thức" IsSelected="True" />
                                    <ComboBoxItem Content="Bán" />
                                    <ComboBoxItem Content="Cho thuê" />
                                </ComboBox>
                            </Grid>

                            <DataGrid x:Name="dgAdminBooks" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" SelectionChanged="dgAdminBooks_SelectionChanged"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                                      BorderBrush="#E2E8F0" BorderThickness="1" RowHeight="38" Background="White">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding BookId}" Width="45" />
                                    <DataGridTemplateColumn Header="Ảnh" Width="56">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Width="30" Height="34" CornerRadius="4" ClipToBounds="True" Background="#E0E7FF" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Grid>
                                                        <TextBlock Text="📖" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Image Source="{Binding CoverImage}" Stretch="UniformToFill" Visibility="{Binding HasCoverImage, Converter={StaticResource BoolToVisConverter}}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Tên Sách" Binding="{Binding Title}" Width="*" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="Tác Giả" Binding="{Binding Author}" Width="130" />
                                    <DataGridTextColumn Header="Thể Loại" Binding="{Binding CategoryName}" Width="130" />
                                    <DataGridTextColumn Header="Giá (VNĐ)" Binding="{Binding FormattedPrice}" Width="100" FontWeight="Bold" />
                                    <DataGridTextColumn Header="Kho" Binding="{Binding StockQuantity}" Width="60" />
                                    <DataGridTextColumn Header="Hình Thức" Binding="{Binding BookStatus}" Width="90" FontWeight="Bold" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- Right: Book CRUD Editor Form -->
                    <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="20" Effect="{StaticResource CardShadow}" BorderBrush="#E2E8F0" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock x:Name="txtBookFormHeader" Text="📝 Thông Tin Chi Tiết Sách" FontWeight="Bold" FontSize="16" Foreground="#0F172A" VerticalAlignment="Center" />
                                    <Button Content="+ Làm mới Form" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="10,4" FontSize="11" Click="btnClearBookForm_Click" />
                                </Grid>

                                <!-- Cover Image Upload Preview -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="68" Height="90" CornerRadius="6" Background="#E0E7FF" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="📖" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image x:Name="imgBookPreview" Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="Ảnh Bìa Sách (BookImages)" FontWeight="Bold" FontSize="12" Foreground="#1E293B" Margin="0,0,0,8" />
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="📁 Chọn Ảnh..." Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="11" Margin="0,0,6,0" Click="btnUploadBookCover_Click" />
                                                <Button Content="Xóa ảnh" Style="{StaticResource DangerButtonStyle}" Padding="8,4" FontSize="11" Click="btnClearBookCover_Click" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock Text="TIÊU ĐỀ SÁCH *" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                <TextBox x:Name="txtBookTitle" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="TÁC GIẢ *" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                        <TextBox x:Name="txtBookAuthor" Style="{StaticResource FormTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="THỂ LOẠI *" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                        <ComboBox x:Name="cbBookCategory" Padding="8,6" DisplayMemberPath="CategoryName" SelectedValuePath="CategoryId" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="95" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="NHÀ XUẤT BẢN" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                        <TextBox x:Name="txtBookPublisher" Style="{StaticResource FormTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="NĂM XB" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                        <TextBox x:Name="txtBookYear" Style="{StaticResource FormTextBoxStyle}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="95" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="ĐƠN GIÁ BÌA (VNĐ) *" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                        <TextBox x:Name="txtBookPrice" Style="{StaticResource FormTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="TỒN KHO *" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                        <TextBox x:Name="txtBookStock" Style="{StaticResource FormTextBoxStyle}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="MÃ ISBN (DUY NHẤT)" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                        <TextBox x:Name="txtBookIsbn" Style="{StaticResource FormTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="HÌNH THỨC SÁCH *" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                        <ComboBox x:Name="cbBookFormStatus" Padding="8,6">
                                            <ComboBoxItem Content="Bán" IsSelected="True" />
                                            <ComboBoxItem Content="Cho thuê" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="MÔ TẢ NỘI DUNG" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                <TextBox x:Name="txtBookDescription" Style="{StaticResource FormTextBoxStyle}" Height="68" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,14" />

                                <!-- CRUD Buttons -->
                                <UniformGrid Columns="3">
                                    <Button Content="➕ Thêm Mới" Style="{StaticResource SuccessButtonStyle}" Margin="0,0,4,0" Click="btnAddBook_Click" />
                                    <Button Content="💾 Cập Nhật" Style="{StaticResource PrimaryButtonStyle}" Margin="2,0,2,0" Click="btnUpdateBook_Click" />
                                    <Button Content="🗑️ Xóa Sách" Style="{StaticResource DangerButtonStyle}" Margin="4,0,0,0" Click="btnDeleteBook_Click" />
                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ==================== TAB 3: CATEGORIES MANAGEMENT ==================== -->
                <Grid x:Name="viewCategories" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="18" Margin="0,0,14,0" Effect="{StaticResource CardShadow}" BorderBrush="#E2E8F0" BorderThickness="1">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="🗂️ Danh Sách Thể Loại Sách" FontWeight="Bold" FontSize="16" Foreground="#0F172A" Margin="0,0,0,14" />
                            <DataGrid x:Name="dgAdminCategories" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" SelectionChanged="dgAdminCategories_SelectionChanged"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                                      BorderBrush="#E2E8F0" BorderThickness="1" RowHeight="40" Background="White">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã TL" Binding="{Binding CategoryId}" Width="70" FontWeight="Bold" />
                                    <DataGridTextColumn Header="Tên Thể Loại" Binding="{Binding Name}" Width="220" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="Mô Tả Chi Tiết" Binding="{Binding Description}" Width="*" />
                                    <DataGridTextColumn Header="Số Đầu Sách" Binding="{Binding Count}" Width="110" FontWeight="Bold" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="20" Effect="{StaticResource CardShadow}" BorderBrush="#E2E8F0" BorderThickness="1" VerticalAlignment="Top">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <TextBlock Text="✏️ Thông Tin Thể Loại" FontWeight="Bold" FontSize="16" Foreground="#0F172A" VerticalAlignment="Center" />
                                <Button Content="Làm mới" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="10,4" FontSize="11" Click="btnClearCategoryForm_Click" />
                            </Grid>

                            <TextBlock Text="TÊN THỂ LOẠI *" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,6" />
                            <TextBox x:Name="txtCategoryName" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,14" />

                            <TextBlock Text="MÔ TẢ THỂ LOẠI" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,6" />
                            <TextBox x:Name="txtCategoryDescription" Style="{StaticResource FormTextBoxStyle}" Height="100" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,18" />

                            <UniformGrid Columns="3">
                                <Button Content="➕ Thêm" Style="{StaticResource SuccessButtonStyle}" Margin="0,0,4,0" Click="btnAddCategory_Click" />
                                <Button Content="💾 Lưu Sửa" Style="{StaticResource PrimaryButtonStyle}" Margin="2,0,2,0" Click="btnUpdateCategory_Click" />
                                <Button Content="🗑️ Xóa" Style="{StaticResource DangerButtonStyle}" Margin="4,0,0,0" Click="btnDeleteCategory_Click" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ==================== TAB 4: ORDERS & RENTALS MANAGEMENT ==================== -->
                <Grid x:Name="viewOrders" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="420" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Orders List -->
                    <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="18" Margin="0,0,14,0" Effect="{StaticResource CardShadow}" BorderBrush="#E2E8F0" BorderThickness="1">
                        <DockPanel LastChildFill="True">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtAdminOrderSearch" Grid.Column="0" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,10,0"
                                         TextChanged="AdminOrderFilter_Changed" ToolTip="Tìm mã đơn, tên khách, SĐT, địa chỉ..." />
                                <ComboBox x:Name="cbAdminOrderTypeFilter" Grid.Column="1" Margin="0,0,10,0" Padding="8,6" SelectionChanged="AdminOrderFilter_Changed">
                                    <ComboBoxItem Content="Tất cả loại đơn" IsSelected="True" />
                                    <ComboBoxItem Content="Đơn Mua Sách" />
                                    <ComboBoxItem Content="Đơn Thuê Sách" />
                                </ComboBox>
                                <ComboBox x:Name="cbAdminOrderStatusFilter" Grid.Column="2" Margin="0,0,10,0" Padding="8,6" SelectionChanged="AdminOrderFilter_Changed">
                                    <ComboBoxItem Content="Tất cả trạng thái" Tag="" IsSelected="True" />
                                    <ComboBoxItem Content="Chờ xác nhận" Tag="Pending" />
                                    <ComboBoxItem Content="Đang giao" Tag="Processing" />
                                    <ComboBoxItem Content="Đang thuê sách" Tag="Renting" />
                                    <ComboBoxItem Content="Chờ xác nhận trả" Tag="ReturnPending" />
                                    <ComboBoxItem Content="Đã trả sách" Tag="Returned" />
                                    <ComboBoxItem Content="Hoàn thành" Tag="Completed" />
                                    <ComboBoxItem Content="Đã hủy" Tag="Cancelled" />
                                </ComboBox>
                                <Button Grid.Column="3" Content="➕ Tạo Đơn Mua / Thuê Mới" Style="{StaticResource SuccessButtonStyle}" Padding="14,7" Click="btnOpenCreateOrderPos_Click" />
                            </Grid>

                            <DataGrid x:Name="dgAdminOrders" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" SelectionChanged="dgAdminOrders_SelectionChanged"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                                      BorderBrush="#E2E8F0" BorderThickness="1" RowHeight="38" Background="White">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã Đơn" Binding="{Binding OrderCode}" Width="85" FontWeight="Bold" />
                                    <DataGridTextColumn Header="Khách Hàng" Binding="{Binding CustomerName}" Width="135" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="Loại" Binding="{Binding OrderTypeDisplay}" Width="120" />
                                    <DataGridTextColumn Header="Tổng Tiền" Binding="{Binding FormattedTotalAmount}" Width="105" FontWeight="Bold" />
                                    <DataGridTextColumn Header="Trạng Thái" Binding="{Binding StatusDisplay}" Width="115" />
                                    <DataGridTextColumn Header="Thanh Toán" Binding="{Binding PaymentStatusDisplay}" Width="110" />
                                    <DataGridTextColumn Header="Ngày Đặt" Binding="{Binding FormattedCreatedAt}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- Right: Order Detail & Status Actions -->
                    <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="20" Effect="{StaticResource CardShadow}" BorderBrush="#E2E8F0" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="txtAdminOrderTitle" Text="🧾 Chi Tiết Đơn Hàng" FontWeight="Bold" FontSize="16" Foreground="#0F172A" Margin="0,0,0,12" />

                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock x:Name="txtOrderCustomerInfo" Text="Khách hàng: Chưa chọn đơn" FontWeight="Bold" FontSize="13" Foreground="#1E293B" />
                                        <TextBlock x:Name="txtOrderPhoneInfo" Text="SĐT nhận: -" FontSize="12" Foreground="#475569" Margin="0,4,0,0" />
                                        <TextBlock x:Name="txtOrderAddressInfo" Text="Địa chỉ / Ghi chú thuê: -" FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <TextBlock x:Name="txtOrderPaymentMethodInfo" Text="Phương thức TT: -" FontSize="12" Foreground="#4F46E5" FontWeight="SemiBold" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="DANH SÁCH SÁCH TRONG ĐƠN" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,6" />
                                <DataGrid x:Name="dgAdminOrderItems" AutoGenerateColumns="False" IsReadOnly="True" Height="165"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                                          BorderBrush="#E2E8F0" BorderThickness="1" RowHeight="32" Background="White" Margin="0,0,0,14">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tên Sách" Binding="{Binding BookTitle}" Width="*" />
                                        <DataGridTextColumn Header="SL" Binding="{Binding Quantity}" Width="40" />
                                        <DataGridTextColumn Header="Đơn Giá" Binding="{Binding FormattedUnitPrice}" Width="85" />
                                        <DataGridTextColumn Header="Thành Tiền" Binding="{Binding FormattedSubTotal}" Width="90" FontWeight="Bold" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="TRẠNG THÁI ĐƠN HÀNG" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                        <ComboBox x:Name="cbAdminEditOrderStatus" Padding="8,6">
                                            <ComboBoxItem Content="Chờ xác nhận" Tag="Pending" />
                                            <ComboBoxItem Content="Đang giao" Tag="Processing" />
                                            <ComboBoxItem Content="Đang thuê sách" Tag="Renting" />
                                            <ComboBoxItem Content="Chờ xác nhận trả" Tag="ReturnPending" />
                                            <ComboBoxItem Content="Đã trả sách" Tag="Returned" />
                                            <ComboBoxItem Content="Quá hạn trả" Tag="Overdue" />
                                            <ComboBoxItem Content="Hoàn thành" Tag="Completed" />
                                            <ComboBoxItem Content="Đã hủy" Tag="Cancelled" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="TRẠNG THÁI THANH TOÁN" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                        <ComboBox x:Name="cbAdminEditPaymentStatus" Padding="8,6">
                                            <ComboBoxItem Content="Chưa thanh toán" Tag="Unpaid" />
                                            <ComboBoxItem Content="Đã thanh toán" Tag="Paid" />
                                            <ComboBoxItem Content="Đã hoàn tiền" Tag="Refunded" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Button x:Name="btnUpdateOrderStatus" Content="💾 Cập Nhật Trạng Thái Đơn Hàng" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,8" Click="btnUpdateOrderStatus_Click" />
                                <Button x:Name="btnConfirmBookReturn" Content="📥 Xác Nhận Khách Đã Trả Sách (Hoàn Kho)" Style="{StaticResource SuccessButtonStyle}" Margin="0,0,0,8" Click="btnConfirmBookReturn_Click" />
                                <Button Content="➕ Tạo Đơn Mua / Thuê Mới (Chọn User hoặc Khách lẻ)" Style="{StaticResource SecondaryButtonStyle}" Click="btnOpenCreateOrderPos_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ==================== TAB 5: VOUCHER MANAGEMENT ==================== -->
                <Grid x:Name="viewVouchers" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="18" Margin="0,0,14,0"
                            Effect="{StaticResource CardShadow}" BorderBrush="#E2E8F0" BorderThickness="1">
                        <DockPanel LastChildFill="True">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                                <TextBlock Text="🎟️ Danh Sách Voucher" FontWeight="Bold" FontSize="16" Foreground="#0F172A" />
                                <Button Content="🔄 Làm Mới" HorizontalAlignment="Right"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="btnRefreshVouchers_Click" />
                            </Grid>
                            <DataGrid x:Name="dgAdminVouchers" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" SelectionChanged="dgAdminVouchers_SelectionChanged"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F1F5F9" BorderBrush="#E2E8F0"
                                      BorderThickness="1" RowHeight="42" Background="White">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="110" FontWeight="Bold" />
                                    <DataGridTextColumn Header="Tên voucher" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Giảm giá" Binding="{Binding DiscountDisplay}" Width="100" />
                                    <DataGridTextColumn Header="Đã lưu / Tổng" Binding="{Binding QuantityDisplay}" Width="110" />
                                    <DataGridCheckBoxColumn Header="Hoạt động" Binding="{Binding IsActive}" Width="85" />
                                    <DataGridTextColumn Header="Hết hạn" Binding="{Binding ExpiryAt, StringFormat=dd/MM/yyyy}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="18"
                            Effect="{StaticResource CardShadow}" BorderBrush="#E2E8F0" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="🎟️ Thông Tin Voucher" FontWeight="Bold" FontSize="16"
                                           Foreground="#0F172A" Margin="0,0,0,16" />

                                <TextBlock Text="TÊN VOUCHER *" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                <TextBox x:Name="txtVoucherName" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,10" />

                                <TextBlock Text="MÃ VOUCHER *" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                <TextBox x:Name="txtVoucherCode" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="LOẠI GIẢM *" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                        <ComboBox x:Name="cbVoucherDiscountType" Padding="8,6">
                                            <ComboBoxItem Content="Phần trăm (%)" Tag="Percent" IsSelected="True" />
                                            <ComboBoxItem Content="Số tiền (VNĐ)" Tag="Amount" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="GIÁ TRỊ *" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                        <TextBox x:Name="txtVoucherDiscountValue" Style="{StaticResource FormTextBoxStyle}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="BẮT ĐẦU" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                        <DatePicker x:Name="dpVoucherStart" Padding="8,6" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="HẾT HẠN" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                        <DatePicker x:Name="dpVoucherExpiry" Padding="8,6" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="TỐI ĐA / NGƯỜI" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                        <TextBox x:Name="txtVoucherMaxUsage" Text="1" Style="{StaticResource FormTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="TỔNG SỐ LƯỢNG" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                        <TextBox x:Name="txtVoucherTotalQuantity" Text="100" Style="{StaticResource FormTextBoxStyle}" />
                                    </StackPanel>
                                </Grid>

                                <CheckBox x:Name="chkVoucherActive" Content="Voucher đang hoạt động" IsChecked="True"
                                          FontWeight="SemiBold" Foreground="#15803D" Margin="0,0,0,16" />

                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                    <Button Content="➕ Thêm Mới" Style="{StaticResource SuccessButtonStyle}"
                                            Margin="0,0,4,0" Click="btnAddVoucher_Click" />
                                    <Button Content="💾 Cập Nhật" Style="{StaticResource PrimaryButtonStyle}"
                                            Margin="4,0,0,0" Click="btnUpdateVoucher_Click" />
                                </UniformGrid>
                                <UniformGrid Columns="2">
                                    <Button Content="🗑️ Xóa Voucher" Style="{StaticResource DangerButtonStyle}"
                                            Margin="0,0,4,0" Click="btnDeleteVoucher_Click" />
                                    <Button Content="✖ Làm Trống" Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="4,0,0,0" Click="btnClearVoucherForm_Click" />
                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ==================== TAB 6: USERS MANAGEMENT ==================== -->
                <Grid x:Name="viewUsers" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="18" Margin="0,0,14,0" Effect="{StaticResource CardShadow}" BorderBrush="#E2E8F0" BorderThickness="1">
                        <DockPanel LastChildFill="True">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="👥 Danh Sách Tài Khoản Hệ Thống" FontWeight="Bold" FontSize="16" Foreground="#0F172A" />
                                    <TextBlock x:Name="txtAdminUserSummary" Text="Tổng: 0 tài khoản" FontSize="11" Foreground="#64748B" />
                                </StackPanel>
                                <TextBox x:Name="txtAdminUserSearch" Grid.Column="2" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,8,0"
                                         ToolTip="Tìm theo tên, email, số điện thoại..." TextChanged="txtAdminUserSearch_TextChanged" />
                                <ComboBox x:Name="cbAdminUserRoleFilter" Grid.Column="3" Padding="8,6" SelectionChanged="cbAdminUserRoleFilter_SelectionChanged">
                                    <ComboBoxItem Content="Tất cả vai trò" IsSelected="True" />
                                    <ComboBoxItem Content="Admin" />
                                    <ComboBoxItem Content="Customer" />
                                </ComboBox>
                            </Grid>

                            <Border DockPanel.Dock="Bottom" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,12,0,0" Height="195">
                                <DockPanel LastChildFill="True">
                                    <TextBlock x:Name="txtSelectedUserOrdersHeader" DockPanel.Dock="Top" Text="📦 Lịch Sử Đơn Mua &amp; Thuê Của Tài Khoản Đang Chọn (Chọn 1 tài khoản ở bảng trên)" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,8" />
                                    <DataGrid x:Name="dgAdminSelectedUserOrders" AutoGenerateColumns="False" IsReadOnly="True"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                                              BorderBrush="#E2E8F0" BorderThickness="1" RowHeight="32" Background="White">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Mã Đơn" Binding="{Binding OrderCode}" Width="90" FontWeight="Bold" />
                                            <DataGridTextColumn Header="Hình Thức" Binding="{Binding OrderTypeDisplay}" Width="125" />
                                            <DataGridTextColumn Header="Sách Đặt" Binding="{Binding ItemsSummary}" Width="*" />
                                            <DataGridTextColumn Header="Tổng Tiền" Binding="{Binding FormattedTotalAmount}" Width="105" FontWeight="Bold" />
                                            <DataGridTextColumn Header="Trạng Thái" Binding="{Binding StatusDisplay}" Width="115" />
                                            <DataGridTextColumn Header="Ngày Tạo" Binding="{Binding FormattedCreatedAt}" Width="125" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                            <DataGrid x:Name="dgAdminUsers" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" SelectionChanged="dgAdminUsers_SelectionChanged"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                                      BorderBrush="#E2E8F0" BorderThickness="1" RowHeight="38" Background="White">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding UserId}" Width="50" />
                                    <DataGridTextColumn Header="Họ và Tên" Binding="{Binding FullName}" Width="160" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="Email" Binding="{Binding DisplayEmail}" Width="190" />
                                    <DataGridTextColumn Header="Số ĐT" Binding="{Binding PhoneNumber}" Width="110" />
                                    <DataGridTextColumn Header="Vai Trò" Binding="{Binding RoleName}" Width="95" FontWeight="Bold" />
                                    <DataGridTextColumn Header="Trạng Thái" Binding="{Binding UserStatus}" Width="85" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="Số Đơn" Binding="{Binding OrderCount}" Width="65" />
                                    <DataGridTextColumn Header="Đang Thuê" Binding="{Binding ActiveRentalCount}" Width="80" />
                                    <DataGridTextColumn Header="Tổng Chi Tiêu" Binding="{Binding FormattedTotalSpent}" Width="115" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="Địa Chỉ" Binding="{Binding Address}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="20" Effect="{StaticResource CardShadow}" BorderBrush="#E2E8F0" BorderThickness="1" VerticalAlignment="Top">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <TextBlock Text="👤 Quản Lý Tài Khoản" FontWeight="Bold" FontSize="16" Foreground="#0F172A" VerticalAlignment="Center" />
                                <Button Content="Làm mới" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="10,4" FontSize="11" Click="btnClearUserForm_Click" />
                            </Grid>

                            <TextBlock Text="HỌ VÀ TÊN *" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                            <TextBox x:Name="txtAdminUserFullName" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,10" />

                            <TextBlock x:Name="lblAdminUserEmail" Text="EMAIL ĐĂNG NHẬP *" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                            <TextBox x:Name="txtAdminUserEmail" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="SỐ ĐIỆN THOẠI" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox x:Name="txtAdminUserPhone" Style="{StaticResource FormTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="PHÂN QUYỀN (ROLE) *" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                    <ComboBox x:Name="cbAdminUserRole" Padding="8,6" DisplayMemberPath="RoleName" SelectedValuePath="RoleId" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="ĐỊA CHỈ" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                            <TextBox x:Name="txtAdminUserAddress" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,10" />

                            <TextBlock x:Name="lblAdminUserPassword" Text="MẬT KHẨU ĐĂNG NHẬP *" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                            <TextBox x:Name="txtAdminUserPassword" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,10" />
                            <Button Content="🧾 Tạo Đơn Mua / Thuê Cho Tài Khoản Đang Chọn" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,8" Click="btnCreateOrderForSelectedUser_Click" />
                            <Button x:Name="btnOpenMyProfileFromAdmin" Content="🔐 Đổi Mật Khẩu &amp; Hồ Sơ Cá Nhân Của Tôi" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,10" Click="btnOpenMyProfile_Click" />

                            <UniformGrid Columns="3">
                                <Button Content="➕ Tạo Mới" Style="{StaticResource SuccessButtonStyle}" Margin="0,0,4,0" Click="btnAddUser_Click" />
                                <Button Content="💾 Cập Nhật" Style="{StaticResource PrimaryButtonStyle}" Margin="2,0,2,0" Click="btnUpdateUser_Click" />
                                <Button Content="🗑️ Xóa" Style="{StaticResource DangerButtonStyle}" Margin="4,0,0,0" Click="btnDeleteUser_Click" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>
        </DockPanel>
    </Grid>
</Window>

