<Window x:Class="BookStoreManagementSystem.CustomerOrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookStoreManagementSystem"
        mc:Ignorable="d"
        Title="BookStore - Quản Lý Đơn Mua &amp; Sách Đang Thuê"
        Height="880" Width="1420"
        MinHeight="720" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI, Inter, Arial">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <DropShadowEffect x:Key="CardShadow" BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.07" Color="#0F172A" />

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4F46E5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4338CA" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#10B981" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#059669" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EEF2FF" />
            <Setter Property="Foreground" Value="#4F46E5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#C7D2FE" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0E7FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                                <Setter Property="BorderBrush" Value="#E2E8F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="38" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4F46E5" />
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 1. TOP NAVIGATION BAR ==================== -->
        <local:StoreHeaderControl x:Name="headerControl" Grid.Row="0" ActiveNav="" />

        <!-- ==================== 2. MASTER-DETAIL ORDERS VIEW ==================== -->
        <Grid Grid.Row="1" Margin="24,16,24,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="460" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: ORDERS TABLE + FILTERS -->
            <Border Grid.Column="0" Background="White" CornerRadius="16" Padding="18" Effect="{StaticResource CardShadow}">
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="txtOrderSearch" Grid.Column="0" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,10,0"
                                 ToolTip="Tìm theo mã đơn, tên sách, địa chỉ..." TextChanged="txtOrderSearch_TextChanged" />

                        <ComboBox x:Name="cbOrderStatusFilter" Grid.Column="1" Height="38" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,10,0" SelectionChanged="cbOrderStatusFilter_SelectionChanged">
                            <ComboBoxItem Content="Tất cả đơn hàng" IsSelected="True" />
                            <ComboBoxItem Content="Đơn Mua Sách" />
                            <ComboBoxItem Content="Đơn Thuê Sách" />
                            <ComboBoxItem Content="Đang thuê sách" />
                            <ComboBoxItem Content="Chờ xác nhận" />
                            <ComboBoxItem Content="Đã trả sách" />
                            <ComboBoxItem Content="Hoàn thành" />
                            <ComboBoxItem Content="Đã hủy" />
                        </ComboBox>

                        <Button Grid.Column="2" Content="🔄 Làm mới" Style="{StaticResource SecondaryButtonStyle}" Click="btnRefreshOrders_Click" />
                    </Grid>

                    <DataGrid x:Name="dgCustomerOrders" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionChanged="dgCustomerOrders_SelectionChanged"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                              BorderBrush="#E2E8F0" BorderThickness="1" RowHeight="44" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã Đơn" Binding="{Binding OrderCode}" Width="90" FontWeight="Bold" />
                            <DataGridTextColumn Header="Hình Thức" Binding="{Binding OrderTypeDisplay}" Width="125" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Sách Đặt" Binding="{Binding ItemsSummary}" Width="*" />
                            <DataGridTextColumn Header="SL" Binding="{Binding TotalQuantity}" Width="45" />
                            <DataGridTextColumn Header="Tổng Tiền" Binding="{Binding FormattedTotalAmount}" Width="110" FontWeight="Bold" />
                            <DataGridTemplateColumn Header="Trạng Thái" Width="125">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusBadgeColor}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusDisplay}" Foreground="White" FontSize="11" FontWeight="Bold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Ngày Đặt" Binding="{Binding FormattedCreatedAt}" Width="125" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- RIGHT: SELECTED ORDER DETAILS & ACTIONS -->
            <Border Grid.Column="2" Background="White" CornerRadius="16" Padding="22" Effect="{StaticResource CardShadow}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="txtDetailOrderHeader" Text="🧾 Chi Tiết Đơn Hàng" FontSize="17" FontWeight="Black" Foreground="#0F172A" Margin="0,0,0,12" />

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock x:Name="txtDetailStatusText" Text="Trạng thái: Chưa chọn đơn" FontSize="13" FontWeight="Bold" Foreground="#4F46E5" />
                                <TextBlock x:Name="txtDetailCreatedAt" Text="Ngày tạo: -" FontSize="12" Foreground="#475569" Margin="0,4,0,0" />
                                <TextBlock x:Name="txtDetailPhone" Text="SĐT nhận: -" FontSize="12" Foreground="#475569" Margin="0,4,0,0" />
                                <TextBlock x:Name="txtDetailAddress" Text="Địa chỉ / Kỳ hạn thuê: -" FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <TextBlock x:Name="txtDetailPayment" Text="Thanh toán: -" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="📚 DANH SÁCH SÁCH TRONG ĐƠN" FontSize="11" FontWeight="Black" Foreground="#334155" Margin="0,0,0,8" />

                        <DataGrid x:Name="dgDetailOrderItems" AutoGenerateColumns="False" IsReadOnly="True" Height="185"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                                  BorderBrush="#E2E8F0" BorderThickness="1" RowHeight="34" Background="White" Margin="0,0,0,14">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tên Sách" Binding="{Binding BookTitle}" Width="*" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="SL" Binding="{Binding Quantity}" Width="40" />
                                <DataGridTextColumn Header="Đơn Giá" Binding="{Binding FormattedUnitPrice}" Width="90" />
                                <DataGridTextColumn Header="Thành Tiền" Binding="{Binding FormattedSubTotal}" Width="95" FontWeight="Bold" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Background="#EEF2FF" CornerRadius="10" Padding="14,10" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Tiền sách:" FontSize="12" Foreground="#475569" />
                                    <TextBlock x:Name="txtDetailItemsSubtotal" Text="0 đ" FontSize="12" Foreground="#334155" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Phí vận chuyển:" FontSize="12" Foreground="#475569" />
                                    <TextBlock x:Name="txtDetailShippingFee" Text="0 đ" FontSize="12" Foreground="#334155" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Giảm giá voucher:" FontSize="12" Foreground="#475569" />
                                    <TextBlock x:Name="txtDetailDiscountAmount" Text="-0 đ" FontSize="12" Foreground="#10B981" HorizontalAlignment="Right" />
                                </Grid>
                                <Border BorderBrush="#C7D2FE" BorderThickness="0,1,0,0" Padding="0,7,0,0">
                                    <Grid>
                                        <TextBlock Text="TỔNG CỘNG ĐƠN HÀNG:" FontSize="13" FontWeight="Bold" Foreground="#334155" />
                                        <TextBlock x:Name="txtDetailTotalAmount" Text="0 đ" FontSize="18" FontWeight="Black" Foreground="#4F46E5" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Rental Actions -->
                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <Button x:Name="btnDetailExtend7Days" Content="⏳ Gia Hạn +7 Ngày" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0" Click="btnDetailExtend7Days_Click" />
                            <Button x:Name="btnDetailReturnBook" Content="📥 Trả Sách Thuê" Style="{StaticResource SuccessButtonStyle}" Margin="4,0,0,0" Click="btnDetailReturnBook_Click" />
                        </UniformGrid>

                        <!-- General Order Actions -->
                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <Button x:Name="btnDetailReorder" Content="🔄 Mua Lại Đơn Này" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,4,0" Click="btnDetailReorder_Click" />
                            <Button x:Name="btnDetailExportInvoice" Content="💾 Xuất Hóa Đơn (.txt)" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0,0,0" Click="btnDetailExportInvoice_Click" />
                        </UniformGrid>

                        <Button x:Name="btnDetailCancelOrder" Content="✕ Hủy đơn hàng" Style="{StaticResource SecondaryButtonStyle}"
                                Foreground="#DC2626" BorderBrush="#FECACA" Background="#FEF2F2" Click="btnDetailCancelOrder_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>

