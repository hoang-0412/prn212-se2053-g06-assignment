<Window x:Class="BookStoreManagementSystem.AdminCreateOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookStoreManagementSystem.ViewModels"
        mc:Ignorable="d"
        Title="BookStore Admin POS - Tạo Đơn Mua / Thuê Sách Mới"
        Height="840" Width="1380"
        MinHeight="720" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <DropShadowEffect x:Key="CardShadow" BlurRadius="14" ShadowDepth="2" Direction="270" Color="#0F172A" Opacity="0.06" />

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4F46E5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4338CA" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1" />
                                <Setter Property="Foreground" Value="#64748B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#10B981" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#059669" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RentButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#F59E0B" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D97706" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EEF2FF" />
            <Setter Property="Foreground" Value="#4F46E5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#C7D2FE" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0E7FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FEE2E2" />
            <Setter Property="Foreground" Value="#DC2626" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#FECACA" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FECACA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4F46E5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <!-- ==================== 1. TOP HEADER BAR ==================== -->
        <Border DockPanel.Dock="Top" Background="#0F172A" Padding="24,14">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="#4F46E5" Margin="0,0,12,0">
                        <TextBlock Text="🧾" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TẠO ĐƠN MUA / THUÊ SÁCH MỚI (ADMIN POS)" FontWeight="Black" FontSize="18" Foreground="White" />
                        <TextBlock Text="Chọn sách mua hoặc thuê, gán tài khoản khách hàng hoặc bán trực tiếp cho khách vãng lai tại quầy" FontSize="12" Foreground="#94A3B8" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="🧹 Làm Mới Toàn Bộ Đơn" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="btnResetAll_Click" />
                    <Button Content="✕ Đóng Cửa Sổ" Style="{StaticResource DangerButtonStyle}" Click="btnClose_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 2. MAIN POS WORKSPACE ==================== -->
        <Grid Margin="18,14,18,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="460" />
            </Grid.ColumnDefinitions>

            <!-- ==================== LEFT COLUMN: BOOK PICKER & SELECTED ITEMS ==================== -->
            <Grid Grid.Column="0" Margin="0,0,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="285" />
                </Grid.RowDefinitions>

                <!-- A. BOOK CATALOG PICKER -->
                <Border Grid.Row="0" Background="White" CornerRadius="14" Padding="16" Margin="0,0,0,12" Effect="{StaticResource CardShadow}" BorderBrush="#E2E8F0" BorderThickness="1">
                    <DockPanel LastChildFill="True">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="📚 1. Chọn Sách Từ Kho (Bấm '+ Mua' hoặc '+ Thuê')" FontWeight="Bold" FontSize="15" Foreground="#0F172A" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="Kỳ hạn mặc định khi bấm '+ Thuê':" FontSize="12" Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="cbDefaultRentalDays" Width="175" Padding="8,5" SelectionChanged="cbDefaultRentalDays_SelectionChanged">
                                    <ComboBoxItem Content="7 ngày (15% giá bìa)" Tag="7" IsSelected="True" />
                                    <ComboBoxItem Content="14 ngày (25% giá bìa)" Tag="14" />
                                    <ComboBoxItem Content="30 ngày (40% giá bìa)" Tag="30" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Search & Filter Bar -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="145" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtBookSearch" Grid.Column="0" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,8,0"
                                     TextChanged="BookFilter_Changed" ToolTip="Tìm theo tên sách, tác giả, mã ISBN..." />
                            <ComboBox x:Name="cbCategoryFilter" Grid.Column="1" Margin="0,0,8,0" Padding="8,6" SelectionChanged="BookFilter_Changed" />
                            <ComboBox x:Name="cbStatusFilter" Grid.Column="2" Padding="8,6" SelectionChanged="BookFilter_Changed">
                                <ComboBoxItem Content="Tất cả hình thức" IsSelected="True" />
                                <ComboBoxItem Content="Bán" />
                                <ComboBoxItem Content="Cho thuê" />
                            </ComboBox>
                        </Grid>

                        <!-- Books DataGrid -->
                        <DataGrid x:Name="dgAvailableBooks" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                                  BorderBrush="#E2E8F0" BorderThickness="1" RowHeight="42" Background="White">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding BookId}" Width="42" />
                                <DataGridTemplateColumn Header="Ảnh" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="28" Height="34" CornerRadius="4" ClipToBounds="True" Background="#E0E7FF" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Grid>
                                                    <TextBlock Text="📖" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Image Source="{Binding CoverImage}" Stretch="UniformToFill" Visibility="{Binding HasCoverImage, Converter={StaticResource BoolToVisConverter}}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Tên Sách" Binding="{Binding Title}" Width="*" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="Tác Giả" Binding="{Binding Author}" Width="125" />
                                <DataGridTextColumn Header="Giá Bán" Binding="{Binding FormattedPrice}" Width="90" FontWeight="Bold" />
                                <DataGridTextColumn Header="Giá Thuê 7N" Binding="{Binding FormattedRental7Days}" Width="90" />
                                <DataGridTextColumn Header="Kho" Binding="{Binding StockQuantity}" Width="50" FontWeight="Bold" />
                                <DataGridTextColumn Header="Loại" Binding="{Binding BookStatus}" Width="75" />
                                <DataGridTemplateColumn Header="Thêm Vào Đơn" Width="168">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Content="🛒 + Mua" Style="{StaticResource PrimaryButtonStyle}" Padding="8,4" FontSize="11" Margin="0,0,6,0"
                                                        Tag="{Binding}" Click="btnAddBuyItem_Click" IsEnabled="{Binding IsInStock}" />
                                                <Button Content="📅 + Thuê" Style="{StaticResource RentButtonStyle}" Padding="8,4" FontSize="11"
                                                        Tag="{Binding}" Click="btnAddRentItem_Click" IsEnabled="{Binding IsInStock}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- B. SELECTED ORDER ITEMS -->
                <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="16" Effect="{StaticResource CardShadow}" BorderBrush="#E2E8F0" BorderThickness="1">
                    <DockPanel LastChildFill="True">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🛍️ 2. Danh Sách Sách Đã Chọn Trong Đơn" FontWeight="Bold" FontSize="15" Foreground="#0F172A" VerticalAlignment="Center" />
                                <Border Background="#EEF2FF" CornerRadius="8" Padding="10,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtSelectedItemsBadge" Text="0 cuốn" FontSize="12" FontWeight="Bold" Foreground="#4F46E5" />
                                </Border>
                            </StackPanel>
                            <Button Content="🗑️ Xóa hết sách đã chọn" Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Right" Padding="10,4" FontSize="11" Click="btnClearItems_Click" />
                        </Grid>

                        <DataGrid x:Name="dgSelectedItems" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                                  BorderBrush="#E2E8F0" BorderThickness="1" RowHeight="38" Background="White">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding BookId}" Width="42" />
                                <DataGridTextColumn Header="Tên Sách" Binding="{Binding Title}" Width="*" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="Hình Thức Giao Dịch" Binding="{Binding TypeBadgeText}" Width="135" FontWeight="Bold" />
                                <DataGridTemplateColumn Header="Đổi Hình Thức" Width="115">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🔄 Mua/Thuê" Style="{StaticResource SecondaryButtonStyle}" Padding="6,3" FontSize="11"
                                                    Tag="{Binding}" Click="btnCycleItemMode_Click" ToolTip="Bấm để chuyển đổi: Mua -> Thuê 7 ngày -> Thuê 14 ngày -> Thuê 30 ngày" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Đơn Giá" Binding="{Binding FormattedUnitPrice}" Width="95" />
                                <DataGridTemplateColumn Header="Số Lượng" Width="105">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Content="-" Width="24" Height="24" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="Bold" Cursor="Hand" Tag="{Binding}" Click="btnDecreaseItemQty_Click" />
                                                <TextBlock Text="{Binding Quantity}" Width="28" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                                <Button Content="+" Width="24" Height="24" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" Foreground="#4F46E5" FontWeight="Bold" Cursor="Hand" Tag="{Binding}" Click="btnIncreaseItemQty_Click" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Thành Tiền" Binding="{Binding FormattedSubTotal}" Width="105" FontWeight="Bold" />
                                <DataGridTemplateColumn Header="Xóa" Width="55">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" Style="{StaticResource DangerButtonStyle}" Padding="6,2" FontSize="11" Tag="{Binding}" Click="btnRemoveItem_Click" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ==================== RIGHT COLUMN: CUSTOMER (USER OR GUEST) & PAYMENT ==================== -->
            <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="20" Effect="{StaticResource CardShadow}" BorderBrush="#E2E8F0" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="👤 3. Thông Tin Khách Hàng (Chọn User Hoặc Không)" FontWeight="Bold" FontSize="15" Foreground="#0F172A" Margin="0,0,0,10" />

                        <!-- Mode Selection: Guest vs Existing User -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <RadioButton x:Name="rbCustomerWalkIn" Content="🚶 Khách vãng lai / Mua tại quầy (Không chọn tài khoản)"
                                             FontWeight="SemiBold" Foreground="#0F172A" IsChecked="True" Margin="0,0,0,8"
                                             Checked="CustomerMode_Changed" />
                                <RadioButton x:Name="rbCustomerExistingUser" Content="👤 Chọn tài khoản User có sẵn trong hệ thống"
                                             FontWeight="SemiBold" Foreground="#0F172A"
                                             Checked="CustomerMode_Changed" />

                                <!-- Existing User Picker Panel -->
                                <StackPanel x:Name="panelSelectExistingUser" Visibility="Collapsed" Margin="0,10,0,0">
                                    <TextBlock Text="TÌM &amp; CHỌN TÀI KHOẢN KHÁCH HÀNG" FontWeight="Bold" FontSize="11" Foreground="#4F46E5" Margin="0,0,0,4" />
                                    <TextBox x:Name="txtUserSearch" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,6"
                                             TextChanged="txtUserSearch_TextChanged" ToolTip="Gõ tên, email hoặc SĐT để lọc nhanh tài khoản..." />
                                    <ComboBox x:Name="cbUsers" Padding="10,7" SelectionChanged="cbUsers_SelectionChanged" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Recipient Name & Phone -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="155" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="TÊN KHÁCH HÀNG / NGƯỜI NHẬN" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                <TextBox x:Name="txtRecipientName" Style="{StaticResource FormTextBoxStyle}" Text="Khách vãng lai (Tại quầy)" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="SỐ ĐIỆN THOẠI" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                <TextBox x:Name="txtRecipientPhone" Style="{StaticResource FormTextBoxStyle}" Text="Tại quầy" />
                            </StackPanel>
                        </Grid>

                        <!-- Shipping Address / Counter Note -->
                        <TextBlock Text="ĐỊA CHỈ NHẬN SÁCH / GHI CHÚ ĐƠN HÀNG" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                        <TextBox x:Name="txtShippingAddress" Style="{StaticResource FormTextBoxStyle}" Text="Nhận sách trực tiếp tại quầy BookStore" Margin="0,0,0,14" />

                        <Separator Background="#E2E8F0" Margin="0,0,0,12" />

                        <!-- Payment & Status Configuration -->
                        <TextBlock Text="💳 4. Phương Thức Thanh Toán &amp; Trạng Thái Đơn" FontWeight="Bold" FontSize="15" Foreground="#0F172A" Margin="0,0,0,10" />

                        <TextBlock Text="PHƯƠNG THỨC THANH TOÁN *" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                        <ComboBox x:Name="cbPaymentMethod" Padding="10,7" Margin="0,0,0,10" SelectionChanged="cbPaymentMethod_SelectionChanged">
                            <ComboBoxItem Content="Tiền mặt tại quầy (Cash)" Tag="Cash" IsSelected="True" />
                            <ComboBoxItem Content="Chuyển khoản Ngân hàng (VietQR)" Tag="Banking" />
                            <ComboBoxItem Content="Ví điện tử MoMo / VNPay" Tag="MoMo/VNPay" />
                            <ComboBoxItem Content="Quẹt thẻ POS (ATM / Visa)" Tag="POS Card" />
                            <ComboBoxItem Content="Thanh toán khi nhận hàng (COD)" Tag="COD" />
                        </ComboBox>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="TRẠNG THÁI THANH TOÁN *" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                <ComboBox x:Name="cbPaymentStatus" Padding="10,7">
                                    <ComboBoxItem Content="Paid" IsSelected="True" />
                                    <ComboBoxItem Content="Unpaid" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="TRẠNG THÁI ĐƠN HÀNG *" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                                <ComboBox x:Name="cbOrderStatus" Padding="10,7">
                                    <ComboBoxItem Content="Tự động theo loại đơn" Tag="Auto" IsSelected="True" />
                                    <ComboBoxItem Content="Completed" Tag="Completed" />
                                    <ComboBoxItem Content="Renting" Tag="Renting" />
                                    <ComboBoxItem Content="Processing" Tag="Processing" />
                                    <ComboBoxItem Content="Pending" Tag="Pending" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="CHIẾT KHẤU / ƯU ĐÃI ADMIN" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                        <ComboBox x:Name="cbDiscountPreset" Padding="10,7" Margin="0,0,0,14" SelectionChanged="cbDiscountPreset_SelectionChanged">
                            <ComboBoxItem Content="Không áp dụng giảm giá (0 đ)" Tag="NONE" IsSelected="True" />
                            <ComboBoxItem Content="Giảm 5% tổng đơn hàng" Tag="PCT_5" />
                            <ComboBoxItem Content="Giảm 10% tổng đơn hàng" Tag="PCT_10" />
                            <ComboBoxItem Content="Giảm 15% (Ưu đãi Sinh viên / VIP)" Tag="PCT_15" />
                            <ComboBoxItem Content="Giảm trực tiếp 20.000 đ" Tag="FIX_20000" />
                            <ComboBoxItem Content="Giảm trực tiếp 50.000 đ" Tag="FIX_50000" />
                        </ComboBox>

                        <!-- Summary Card -->
                        <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Tổng số lượng sách:" FontSize="12" Foreground="#475569" />
                                    <TextBlock x:Name="txtSummaryTotalQty" Text="0 cuốn (0 Mua, 0 Thuê)" FontSize="12" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Tạm tính:" FontSize="12" Foreground="#475569" />
                                    <TextBlock x:Name="txtSummarySubTotal" Text="0 đ" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Chiết khấu / Giảm giá:" FontSize="12" Foreground="#475569" />
                                    <TextBlock x:Name="txtSummaryDiscount" Text="-0 đ" FontSize="12" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right" />
                                </Grid>
                                <Separator Background="#C7D2FE" Margin="0,0,0,8" />
                                <Grid>
                                    <TextBlock Text="TỔNG THANH TOÁN:" FontSize="14" FontWeight="Black" Foreground="#1E1B4B" VerticalAlignment="Center" />
                                    <TextBlock x:Name="txtSummaryFinalTotal" Text="0 đ" FontSize="20" FontWeight="Black" Foreground="#4F46E5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Submit Button -->
                        <Button x:Name="btnCreateOrder" Content="✅ Xác Nhận Tạo Đơn Mua / Thuê Mới" Style="{StaticResource SuccessButtonStyle}"
                                Padding="16,12" FontSize="14" Click="btnCreateOrder_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
