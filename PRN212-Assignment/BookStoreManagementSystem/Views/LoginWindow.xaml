<Window x:Class="BookStoreManagementSystem.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="G07 BookStore - Đăng Nhập &amp; Đăng Ký"
        Height="740" Width="1060"
        MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI, Inter, Arial">

    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="28" Direction="270" ShadowDepth="8" Opacity="0.10" Color="#0F172A" />

        <!-- Primary Coral/Rose Pill Button matching reference -->
        <Style x:Key="PrimaryPillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F43F5E" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="18,12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="22" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E11D48" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#BE123C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Rounded Input Border -->
        <Style x:Key="CleanTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="CleanPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ==================== VIEW 1: LOGIN MODAL (STEP 1 & STEP 2) ==================== -->
        <Grid x:Name="gridLoginView" Visibility="Visible" Background="#E2E8F0">
            <!-- Subtle decorative backdrop -->
            <Border Background="#94A3B8" Opacity="0.25" />

            <!-- Centered Modal Card -->
            <Border Width="450" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="#FFFFFF" CornerRadius="18" Padding="32,26,32,30"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <!-- Top Bar inside Modal (Back on Step 2 + Close X) -->
                    <Grid Margin="0,0,0,6">
                        <Button x:Name="btnBackToIdentifier" Content="←" Visibility="Collapsed"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Width="30" Height="30" Background="#F1F5F9" Foreground="#475569"
                                FontSize="15" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                Click="btnBackToIdentifier_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="btnCloseLoginModal" Content="✕"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="30" Height="30" Background="Transparent" BorderBrush="#CBD5E1" BorderThickness="1"
                                Foreground="#64748B" FontSize="12" Cursor="Hand"
                                Click="btnContinueAsGuest_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="15">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Logo Circle -->
                    <Border Width="52" Height="52" CornerRadius="26" Background="#0F172A" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="📚" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- STEP 1: IDENTIFIER (PHONE OR EMAIL) -->
                    <StackPanel x:Name="panelStepIdentifier" Visibility="Visible">
                        <TextBlock Text="Đăng nhập" FontSize="20" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="Nhập số điện thoại hoặc email hoặc đăng ký tài khoản mới"
                                   FontSize="12.5" Foreground="#64748B" HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,0,0,20" />

                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Height="44" Padding="14,0" Margin="0,0,0,18" Background="#FFFFFF">
                            <Grid>
                                <TextBlock x:Name="phIdentifier" Text="Nhập số điện thoại hoặc email"
                                           Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False" />
                                <TextBox x:Name="txtIdentifier" Style="{StaticResource CleanTextBoxStyle}"
                                         TextChanged="txtIdentifier_TextChanged" KeyDown="txtIdentifier_KeyDown" />
                            </Grid>
                        </Border>

                        <Button Content="Tiếp tục →" Style="{StaticResource PrimaryPillButtonStyle}"
                                Click="btnContinueIdentifier_Click" Margin="0,0,0,12" />

                        <Button Content="Tiếp tục xem cửa hàng với tư cách Khách"
                                Background="Transparent" BorderThickness="0" Foreground="#64748B" FontSize="12"
                                Cursor="Hand" HorizontalAlignment="Center" Click="btnContinueAsGuest_Click" />
                    </StackPanel>

                    <!-- STEP 2: PASSWORD (WHEN ACCOUNT EXISTS) -->
                    <StackPanel x:Name="panelStepPassword" Visibility="Collapsed">
                        <TextBlock Text="Đăng nhập" FontSize="20" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,0,0,4" />
                        <TextBlock x:Name="txtMatchedAccountHint" Text="" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,16" />

                        <TextBlock Text="Nhập mật khẩu" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6" />
                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Height="44" Padding="14,0,10,0" Margin="0,0,0,8" Background="#FFFFFF">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="phLoginPassword" Text="Nhập mật khẩu"
                                           Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False" />
                                <PasswordBox x:Name="pwdLogin" Style="{StaticResource CleanPasswordBoxStyle}"
                                             PasswordChanged="pwdLogin_PasswordChanged" KeyDown="pwdLogin_KeyDown" />
                                <TextBox x:Name="txtLoginPasswordVisible" Style="{StaticResource CleanTextBoxStyle}"
                                         Visibility="Collapsed" TextChanged="txtLoginPasswordVisible_TextChanged" KeyDown="pwdLogin_KeyDown" />
                                <Button Grid.Column="1" Content="👁" Background="Transparent" BorderThickness="0"
                                        Foreground="#64748B" FontSize="14" Cursor="Hand" Padding="6,0"
                                        Click="btnToggleLoginPwd_Click" ToolTip="Hiện / Ẩn mật khẩu" />
                            </Grid>
                        </Border>

                        <Button Content="Quên mật khẩu?" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"
                                Foreground="#E11D48" FontSize="12" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,0,18"
                                Click="btnForgotPassword_Click" />

                        <Button Content="Tiếp tục →" Style="{StaticResource PrimaryPillButtonStyle}"
                                Click="btnSubmitPassword_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== VIEW 2: REGISTER PAGE (WHEN NOT REGISTERED) ==================== -->
        <Grid x:Name="gridRegisterView" Visibility="Collapsed" Background="#F8FAFC">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Sub-Header Bar -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,14">
                <Grid MaxWidth="1120">
                    <Button Content="←" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0" Foreground="#0F172A"
                            FontSize="18" FontWeight="Bold" Cursor="Hand" Padding="6,2"
                            Click="btnBackToIdentifier_Click" ToolTip="Quay lại đăng nhập" />
                    <TextBlock Text="Đăng ký tài khoản" FontSize="18" FontWeight="Bold" Foreground="#0F172A"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Centered Registration Form Card -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,24">
                <Border Width="520" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="28,24,28,28"
                        Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <TextBlock Text="Thông tin liên hệ" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10" />

                        <!-- Gender Radio Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <RadioButton x:Name="rbMale" Content="Nam" IsChecked="True" FontSize="13" Foreground="#0F172A" Margin="0,0,22,0" VerticalContentAlignment="Center" />
                            <RadioButton x:Name="rbFemale" Content="Nữ" FontSize="13" Foreground="#0F172A" VerticalContentAlignment="Center" />
                        </StackPanel>

                        <!-- Full Name -->
                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Height="42" Padding="14,0" Margin="0,0,0,12" Background="#FFFFFF">
                            <Grid>
                                <TextBlock x:Name="phRegFullName" Text="Nhập họ và tên khách hàng"
                                           Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False" />
                                <TextBox x:Name="txtRegFullName" Style="{StaticResource CleanTextBoxStyle}" TextChanged="RegField_TextChanged" />
                            </Grid>
                        </Border>

                        <!-- Phone Number with (+84) prefix -->
                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Height="42" Padding="14,0" Margin="0,0,0,12" Background="#FFFFFF">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="(+84)" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Grid Grid.Column="1">
                                    <TextBlock x:Name="phRegPhone" Text="Nhập số điện thoại"
                                               Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False" />
                                    <TextBox x:Name="txtRegPhone" Style="{StaticResource CleanTextBoxStyle}" TextChanged="RegField_TextChanged" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Email -->
                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Height="42" Padding="14,0" Margin="0,0,0,14" Background="#FFFFFF">
                            <Grid>
                                <TextBlock x:Name="phRegEmail" Text="Nhập Email"
                                           Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False" />
                                <TextBox x:Name="txtRegEmail" Style="{StaticResource CleanTextBoxStyle}" TextChanged="RegField_TextChanged" />
                            </Grid>
                        </Border>

                        <!-- Password -->
                        <TextBlock Text="Mật khẩu" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6" />
                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Height="42" Padding="14,0,10,0" Margin="0,0,0,14" Background="#FFFFFF">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="phRegPassword" Text="Nhập mật khẩu"
                                           Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False" />
                                <PasswordBox x:Name="pwdReg" Style="{StaticResource CleanPasswordBoxStyle}" PasswordChanged="pwdReg_PasswordChanged" />
                                <TextBox x:Name="txtRegPwdVisible" Style="{StaticResource CleanTextBoxStyle}" Visibility="Collapsed" TextChanged="txtRegPwdVisible_TextChanged" />
                                <Button Grid.Column="1" Content="👁" Background="Transparent" BorderThickness="0"
                                        Foreground="#64748B" FontSize="14" Cursor="Hand" Padding="6,0" Click="btnToggleRegPwd_Click" />
                            </Grid>
                        </Border>

                        <!-- Confirm Password -->
                        <TextBlock Text="Nhập lại mật khẩu" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6" />
                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Height="42" Padding="14,0,10,0" Margin="0,0,0,14" Background="#FFFFFF">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="phRegConfirmPassword" Text="Nhập lại mật khẩu"
                                           Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False" />
                                <PasswordBox x:Name="pwdRegConfirm" Style="{StaticResource CleanPasswordBoxStyle}" PasswordChanged="pwdRegConfirm_PasswordChanged" />
                                <TextBox x:Name="txtRegConfirmPwdVisible" Style="{StaticResource CleanTextBoxStyle}" Visibility="Collapsed" TextChanged="txtRegConfirmPwdVisible_TextChanged" />
                                <Button Grid.Column="1" Content="👁" Background="Transparent" BorderThickness="0"
                                        Foreground="#64748B" FontSize="14" Cursor="Hand" Padding="6,0" Click="btnToggleRegConfirmPwd_Click" />
                            </Grid>
                        </Border>

                        <!-- Address -->
                        <TextBlock Text="Địa chỉ" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="cbProvince" Grid.Column="0" Height="40" Padding="10,8" FontSize="13"
                                      SelectionChanged="cbProvince_SelectionChanged" />
                            <ComboBox x:Name="cbWard" Grid.Column="2" Height="40" Padding="10,8" FontSize="13" />
                        </Grid>

                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Height="42" Padding="14,0" Margin="0,0,0,22" Background="#FFFFFF">
                            <Grid>
                                <TextBlock x:Name="phRegStreet" Text="Nhập địa chỉ cụ thể. Số nhà, tên đường..."
                                           Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False" />
                                <TextBox x:Name="txtRegStreetAddress" Style="{StaticResource CleanTextBoxStyle}" TextChanged="RegField_TextChanged" />
                            </Grid>
                        </Border>

                        <!-- Submit Button -->
                        <Button Content="Xác nhận" Style="{StaticResource PrimaryPillButtonStyle}"
                                Width="140" HorizontalAlignment="Center" Click="btnSubmitRegister_Click" />
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
