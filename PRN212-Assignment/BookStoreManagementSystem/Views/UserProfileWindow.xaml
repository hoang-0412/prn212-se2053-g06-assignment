<Window x:Class="BookStoreManagementSystem.UserProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BookStore - Hồ Sơ Cá Nhân &amp; Bảo Mật Tài Khoản"
        Height="860" Width="1360"
        MinHeight="720" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI, Inter, Arial">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <DropShadowEffect x:Key="CardShadow" BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.07" Color="#0F172A" />

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4F46E5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4338CA" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#10B981" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#059669" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EEF2FF" />
            <Setter Property="Foreground" Value="#4F46E5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#C7D2FE" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0E7FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="40" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4F46E5" />
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 1. TOP NAVIGATION BAR ==================== -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⬅️ Quay Lại" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="btnBack_Click" />
                    <Button Content="🏠 Trang Chủ" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="btnGoHome_Click" />
                    <Button Content="📚 Danh Sách Sách" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,16,0" Click="btnGoBookList_Click" />
                    <Button Content="🎟️ Voucher Của Tôi" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,16,0" Click="btnOpenVouchers_Click" />

                    <Border Width="1" Height="28" Background="#E2E8F0" Margin="0,0,16,0" />

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Bảo Mật &amp; Cá Nhân Hóa" FontWeight="Bold" FontSize="11" Foreground="#4F46E5" />
                        <TextBlock Text="Hồ Sơ Cá Nhân, Đổi Mật Khẩu &amp; Quản Lý Sách Thuê" FontWeight="Black" FontSize="15" Foreground="#0F172A" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnOpenAdmin" Content="🛠️ Admin Dashboard" Style="{StaticResource SecondaryButtonStyle}"
                            Background="#FEF3C7" BorderBrush="#FDE68A" Foreground="#B45309" Margin="0,0,10,0" Click="btnOpenAdmin_Click" />
                    <Button Content="🔄 Đăng Xuất" Style="{StaticResource SecondaryButtonStyle}" Click="btnLogout_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 2. MAIN CONTENT ==================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,22">
            <Grid MaxWidth="1300">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN: PROFILE EDIT + CHANGE PASSWORD -->
                <StackPanel Grid.Column="0">
                    <!-- User Card Summary -->
                    <Border Background="White" CornerRadius="16" Padding="22" Effect="{StaticResource CardShadow}" Margin="0,0,0,20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Width="56" Height="56" CornerRadius="28" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1.5" Margin="0,0,14,0">
                                    <TextBlock Text="👤" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="txtProfileHeaderName" Text="Nguyễn Văn A" FontSize="18" FontWeight="Black" Foreground="#0F172A" />
                                    <TextBlock x:Name="txtProfileHeaderEmail" Text="nguyenvana@gmail.com" FontSize="12" Foreground="#64748B" />
                                    <Border Background="#EEF2FF" CornerRadius="6" Padding="8,2" HorizontalAlignment="Left" Margin="0,4,0,0">
                                        <TextBlock x:Name="txtProfileHeaderRole" Text="Customer" FontSize="11" FontWeight="Bold" Foreground="#4F46E5" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="✏️ CẬP NHẬT THÔNG TIN TÀI KHOẢN CỦA BẠN" FontSize="11" FontWeight="Black" Foreground="#334155" Margin="0,0,0,10" />

                            <TextBlock Text="HỌ VÀ TÊN *" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4" />
                            <TextBox x:Name="txtProfileFullName" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,12" />

                            <TextBlock Text="EMAIL ĐĂNG NHẬP CỦA BẠN *" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4" />
                            <TextBox x:Name="txtProfileEmail" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,12" />

                            <TextBlock Text="SỐ ĐIỆN THOẠI LIÊN HỆ" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4" />
                            <TextBox x:Name="txtProfilePhone" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,12" />

                            <TextBlock Text="ĐỊA CHỈ NHẬN SÁCH MẶC ĐỊNH" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4" />
                            <TextBox x:Name="txtProfileAddress" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,16" />

                            <Button Content="💾 Lưu Thông Tin Cá Nhân" Style="{StaticResource PrimaryButtonStyle}" Click="btnSaveProfile_Click" />
                        </StackPanel>
                    </Border>

                    <!-- Change Own Password Card -->
                    <Border Background="White" CornerRadius="16" Padding="22" Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <TextBlock Text="🔐 ĐỔI MẬT KHẨU ĐĂNG NHẬP CÁ NHÂN" FontSize="12" FontWeight="Black" Foreground="#0F172A" Margin="0,0,0,4" />
                            <TextBlock Text="Chỉ chính chủ tài khoản mới có thể thay đổi mật khẩu đăng nhập." FontSize="11" Foreground="#64748B" Margin="0,0,0,14" TextWrapping="Wrap" />

                            <TextBlock Text="MẬT KHẨU HIỆN TẠI *" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4" />
                            <Border Height="40" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Background="White" Margin="0,0,0,12">
                                <PasswordBox x:Name="txtCurrentPassword" FontSize="13" Padding="10,0" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" />
                            </Border>

                            <TextBlock Text="MẬT KHẨU MỚI *" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4" />
                            <Border Height="40" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Background="White" Margin="0,0,0,12">
                                <PasswordBox x:Name="txtNewPassword" FontSize="13" Padding="10,0" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" />
                            </Border>

                            <TextBlock Text="XÁC NHẬN MẬT KHẨU MỚI *" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4" />
                            <Border Height="40" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Background="White" Margin="0,0,0,16">
                                <PasswordBox x:Name="txtConfirmNewPassword" FontSize="13" Padding="10,0" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" />
                            </Border>

                            <Button Content="🔑 Cập Nhật Mật Khẩu Mới" Style="{StaticResource SuccessButtonStyle}" Click="btnChangePassword_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT COLUMN: PERSONAL KPI STATS + MY ORDERS & RENTAL EXTENSION -->
                <StackPanel Grid.Column="2">
                    <!-- 3 KPI Cards -->
                    <UniformGrid Columns="3" Margin="0,0,0,20">
                        <Border Background="White" CornerRadius="14" Padding="18" Margin="0,0,10,0" Effect="{StaticResource CardShadow}">
                            <StackPanel>
                                <TextBlock Text="🛍️ TỔNG ĐƠN ĐÃ ĐẶT" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                                <TextBlock x:Name="txtStatTotalOrders" Text="0 đơn" FontSize="24" FontWeight="Black" Foreground="#0F172A" Margin="0,6,0,2" />
                                <TextBlock x:Name="txtStatOrderBreakdown" Text="0 đơn mua • 0 đơn thuê" FontSize="11" Foreground="#4F46E5" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="14" Padding="18" Margin="5,0,5,0" Effect="{StaticResource CardShadow}">
                            <StackPanel>
                                <TextBlock Text="📅 SÁCH ĐANG THUÊ" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                                <TextBlock x:Name="txtStatActiveRentals" Text="0 đơn" FontSize="24" FontWeight="Black" Foreground="#D97706" Margin="0,6,0,2" />
                                <TextBlock Text="Có thể gia hạn hoặc trả sách ngay" FontSize="11" Foreground="#B45309" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="14" Padding="18" Margin="10,0,0,0" Effect="{StaticResource CardShadow}">
                            <StackPanel>
                                <TextBlock Text="💰 TỔNG CHI TIÊU HỢP LỆ" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                                <TextBlock x:Name="txtStatTotalSpent" Text="0 đ" FontSize="24" FontWeight="Black" Foreground="#10B981" Margin="0,6,0,2" />
                                <TextBlock Text="Tích lũy mua &amp; thuê sách" FontSize="11" Foreground="#059669" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- My Orders & Active Rentals Management Card -->
                    <Border Background="White" CornerRadius="16" Padding="22" Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="📦 Lịch Sử Đơn Mua, Gia Hạn Thuê &amp; Trả Sách Của Bạn" FontSize="17" FontWeight="Black" Foreground="#0F172A" />
                                    <TextBlock Text="Theo dõi trạng thái đơn hàng, bấm 'Gia Hạn +7 Ngày' nếu muốn đọc thêm hoặc 'Trả Sách' để hoàn kho" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                                </StackPanel>

                                <ComboBox x:Name="cbProfileOrderFilter" Width="170" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,6" SelectionChanged="cbProfileOrderFilter_SelectionChanged">
                                    <ComboBoxItem Content="Tất cả đơn hàng" IsSelected="True" />
                                    <ComboBoxItem Content="Đơn đang thuê" />
                                    <ComboBoxItem Content="Đơn mua sở hữu" />
                                    <ComboBoxItem Content="Chờ xác nhận" />
                                </ComboBox>
                            </Grid>

                            <DataGrid x:Name="dgProfileOrders" AutoGenerateColumns="False" IsReadOnly="True" Height="450"
                                      SelectionMode="Single" SelectionChanged="dgProfileOrders_SelectionChanged"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                                      BorderBrush="#E2E8F0" BorderThickness="1" RowHeight="46" Background="White">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã Đơn" Binding="{Binding OrderCode}" Width="90" FontWeight="Bold" />
                                    <DataGridTextColumn Header="Loại Đơn" Binding="{Binding OrderTypeDisplay}" Width="125" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="Sách Đặt" Binding="{Binding ItemsSummary}" Width="*" />
                                    <DataGridTextColumn Header="Tổng Tiền" Binding="{Binding FormattedTotalAmount}" Width="105" FontWeight="Bold" />
                                    <DataGridTemplateColumn Header="Trạng Thái" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding StatusBadgeColor}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusDisplay}" Foreground="White" FontSize="11" FontWeight="Bold" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Thao Tác Nhanh" Width="210">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Button Content="⏳ +7 Ngày" Padding="8,4" FontSize="11" Margin="0,0,4,0"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Visibility="{Binding CanReturnBook, Converter={StaticResource BoolToVisConverter}}"
                                                            Tag="{Binding}" Click="btnExtendRental7Days_Click" />
                                                    <Button Content="📥 Trả Sách" Padding="8,4" FontSize="11" Margin="0,0,4,0"
                                                            Style="{StaticResource SuccessButtonStyle}"
                                                            Visibility="{Binding CanReturnBook, Converter={StaticResource BoolToVisConverter}}"
                                                            Tag="{Binding}" Click="btnReturnRentalBook_Click" />
                                                    <Button Content="✕ Hủy Đơn" Padding="8,4" FontSize="11"
                                                            Style="{StaticResource SecondaryButtonStyle}" Foreground="#DC2626" BorderBrush="#FECACA" Background="#FEF2F2"
                                                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisConverter}}"
                                                            Tag="{Binding}" Click="btnCancelOrder_Click" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border x:Name="panelProfileOrderDetail" Visibility="Collapsed" Background="#F8FAFC"
                                    BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="txtProfileDetailOrderHeader" Text="🧾 Chi Tiết Đơn Hàng"
                                               FontSize="16" FontWeight="Black" Foreground="#0F172A" Margin="0,0,0,8" />
                                    <TextBlock x:Name="txtProfileDetailStatus" FontSize="12" FontWeight="Bold" Foreground="#4F46E5" />
                                    <TextBlock x:Name="txtProfileDetailCreatedAt" FontSize="12" Foreground="#475569" Margin="0,4,0,0" />
                                    <TextBlock x:Name="txtProfileDetailPhone" FontSize="12" Foreground="#475569" Margin="0,4,0,0" />
                                    <TextBlock x:Name="txtProfileDetailAddress" FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <TextBlock x:Name="txtProfileDetailPayment" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,4,0,12" />

                                    <TextBlock Text="SÁCH TRONG ĐƠN" FontSize="11" FontWeight="Black" Foreground="#334155" Margin="0,0,0,6" />
                                    <DataGrid x:Name="dgProfileOrderItems" AutoGenerateColumns="False" IsReadOnly="True" Height="150"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="#E2E8F0"
                                              BorderThickness="1" RowHeight="32" Background="White" Margin="0,0,0,12">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Tên sách" Binding="{Binding BookTitle}" Width="*" />
                                            <DataGridTextColumn Header="SL" Binding="{Binding Quantity}" Width="45" />
                                            <DataGridTextColumn Header="Đơn giá" Binding="{Binding FormattedUnitPrice}" Width="95" />
                                            <DataGridTextColumn Header="Thành tiền" Binding="{Binding FormattedSubTotal}" Width="105" FontWeight="Bold" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Grid>
                                        <TextBlock Text="TỔNG THANH TOÁN:" FontSize="13" FontWeight="Bold" Foreground="#334155" />
                                        <TextBlock x:Name="txtProfileDetailTotal" Text="0 đ" HorizontalAlignment="Right"
                                                   FontSize="18" FontWeight="Black" Foreground="#4F46E5" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>

