<Window x:Class="BookStoreManagementSystem.BookListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookStoreManagementSystem"
        mc:Ignorable="d"
        Title="BookStore - Danh Sách Toàn Bộ Sách (/books)"
        Height="880" Width="1400"
        MinHeight="720" MinWidth="1140"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI, Inter, Arial">

    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" Direction="270" ShadowDepth="3" Opacity="0.08" Color="#0F172A" />
        <DropShadowEffect x:Key="ModalShadow" BlurRadius="25" Direction="270" ShadowDepth="8" Opacity="0.25" Color="#000000" />
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4F46E5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4338CA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3730A3" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#D97706" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B45309" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EEF2FF" />
            <Setter Property="Foreground" Value="#4F46E5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#C7D2FE" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0E7FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                                <Setter Property="BorderBrush" Value="#E2E8F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4F46E5" />
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel LastChildFill="True">

            <!-- ==================== 1. TOP HEADER BAR ==================== -->
            <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Logo & Page Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="10" Background="#4F46E5" Margin="0,0,12,0">
                            <TextBlock Text="📚" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="DANH MỤC" FontWeight="Black" FontSize="19" Foreground="#4F46E5" />
                                <TextBlock Text=" TOÀN BỘ SÁCH" FontWeight="Black" FontSize="19" Foreground="#0F172A" />
                                <Border Background="#EEF2FF" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="/books" FontSize="11" FontWeight="SemiBold" Foreground="#4F46E5" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Tra cứu toàn bộ kho sách, hiển thị ảnh bìa &amp; quản lý ảnh sách (Admin)" FontSize="11" Foreground="#64748B" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Global Search Input -->
                    <Grid Grid.Column="1" HorizontalAlignment="Center" Width="430" Margin="16,0">
                        <TextBox x:Name="txtSearch"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 Padding="36,8,30,8"
                                 TextChanged="txtSearch_TextChanged" />
                        <TextBlock Text="🔍" FontSize="14" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False" />
                        <TextBlock x:Name="txtSearchPlaceholder"
                                   Text="Tìm kiếm theo Tên sách, Tác giả, ISBN, NXB, Thể loại..."
                                   Foreground="#94A3B8" FontSize="13"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Margin="36,0,0,0" IsHitTestVisible="False" />
                        <Button x:Name="btnClearSearch" Content="✖"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                Background="Transparent" BorderThickness="0" Foreground="#94A3B8"
                                Cursor="Hand" Click="btnClearSearch_Click" Visibility="Collapsed" />
                    </Grid>

                    <!-- Right Navigation Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,8,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👤 " FontSize="13" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock x:Name="txtCurrentUserName" Text="Khách vãng lai" FontWeight="Bold" FontSize="12" Foreground="#0F172A" />
                                    <TextBlock x:Name="txtCurrentUserRole" Text="Khách (Guest)" FontSize="10" Foreground="#64748B" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Button x:Name="btnBackHome" Content="🏠 Trang Chủ (/homepage)" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Click="btnBackHome_Click" />
                        <Button x:Name="btnOpenAdmin" Content="🛠️ Admin Dashboard" Style="{StaticResource RentButtonStyle}" Background="#0F172A" Margin="0,0,8,0" Click="btnOpenAdmin_Click" />
                        <Button x:Name="btnAuthAction" Content="🔐 Tài khoản" Style="{StaticResource SecondaryButtonStyle}" Click="btnAuthAction_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== 2. TOP KPI SUMMARY STRIP ==================== -->
            <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,10">
                <UniformGrid Columns="5">
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,8" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#EEF2FF" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                <TextBlock Text="📚" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="TỔNG ĐẦU SÁCH" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                <TextBlock x:Name="statTotalBooks" Text="0 đầu sách" FontSize="15" FontWeight="Black" Foreground="#0F172A" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,8" Margin="4,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#DCFCE7" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                <TextBlock Text="📦" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="TỔNG TỒN KHO" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                <TextBlock x:Name="statTotalStock" Text="0 cuốn" FontSize="15" FontWeight="Black" Foreground="#15803D" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,8" Margin="4,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#E0E7FF" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                <TextBlock Text="🛍️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="SÁCH ĐANG BÁN" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                <TextBlock x:Name="statForSale" Text="0 sách" FontSize="15" FontWeight="Black" Foreground="#4F46E5" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,8" Margin="4,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#FEF3C7" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                <TextBlock Text="📅" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="SÁCH CHO THUÊ" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                <TextBlock x:Name="statForRent" Text="0 sách" FontSize="15" FontWeight="Black" Foreground="#D97706" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,8" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#E0F2FE" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                <TextBlock Text="🗂️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="THỂ LOẠI &amp; NXB" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                <TextBlock x:Name="statCategories" Text="0 thể loại" FontSize="15" FontWeight="Black" Foreground="#0284C7" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Border>

            <!-- ==================== 3. MAIN BODY (SIDEBAR FILTERS + BOOK LIST) ==================== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDEBAR: ADVANCED FILTERS -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="18,16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBlock Text="⚡" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="BỘ LỌC SÁCH NÂNG CAO" FontWeight="Bold" FontSize="14" Foreground="#0F172A" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- 1. Category Filter -->
                            <TextBlock Text="1. THỂ LOẠI SÁCH" FontWeight="Bold" FontSize="11" Foreground="#64748B" Margin="0,0,0,6" />
                            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Background="#F8FAFC" Padding="4" Margin="0,0,0,14">
                                <ListBox x:Name="lstCategories"
                                         MaxHeight="175"
                                         BorderThickness="0" Background="Transparent"
                                         SelectionChanged="lstCategories_SelectionChanged"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,5" CornerRadius="6" Background="Transparent">
                                                <Grid>
                                                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#1E293B" TextTrimming="CharacterEllipsis" />
                                                    <Border Background="#E2E8F0" CornerRadius="10" Padding="6,1" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding Count}" FontSize="11" Foreground="#475569" FontWeight="SemiBold" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <!-- 2. Transaction Status Filter -->
                            <TextBlock Text="2. HÌNH THỨC GIAO DỊCH" FontWeight="Bold" FontSize="11" Foreground="#64748B" Margin="0,0,0,6" />
                            <ComboBox x:Name="cbStatusFilter" Margin="0,0,0,14" Padding="10,6" SelectionChanged="FilterSelection_Changed">
                                <ComboBoxItem Content="Tất cả hình thức" IsSelected="True" />
                                <ComboBoxItem Content="Bán" />
                                <ComboBoxItem Content="Cho thuê" />
                                <ComboBoxItem Content="Đã thuê" />
                            </ComboBox>

                            <!-- 3. Price Range Filter -->
                            <TextBlock Text="3. KHOẢNG GIÁ BÌA (VNĐ)" FontWeight="Bold" FontSize="11" Foreground="#64748B" Margin="0,0,0,6" />
                            <StackPanel Margin="0,0,0,8">
                                <RadioButton x:Name="rbPriceAll" Content="Tất cả mức giá" IsChecked="True" Margin="0,3" Checked="FilterCheck_Changed" />
                                <RadioButton x:Name="rbPriceUnder100" Content="Dưới 100.000 đ" Margin="0,3" Checked="FilterCheck_Changed" />
                                <RadioButton x:Name="rbPrice100To250" Content="Từ 100.000 đ - 250.000 đ" Margin="0,3" Checked="FilterCheck_Changed" />
                                <RadioButton x:Name="rbPrice250To500" Content="Từ 250.000 đ - 500.000 đ" Margin="0,3" Checked="FilterCheck_Changed" />
                                <RadioButton x:Name="rbPriceAbove500" Content="Trên 500.000 đ" Margin="0,3" Checked="FilterCheck_Changed" />
                            </StackPanel>

                            <!-- Custom Price Range -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Hoặc nhập khoảng giá tùy chỉnh:" FontSize="11" Foreground="#64748B" Margin="0,0,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtMinPrice" Grid.Column="0" Style="{StaticResource SearchTextBoxStyle}" Padding="6,4" FontSize="12" ToolTip="Giá tối thiểu" TextChanged="CustomPrice_TextChanged" />
                                        <TextBlock Grid.Column="1" Text="-" VerticalAlignment="Center" Margin="6,0" Foreground="#64748B" />
                                        <TextBox x:Name="txtMaxPrice" Grid.Column="2" Style="{StaticResource SearchTextBoxStyle}" Padding="6,4" FontSize="12" ToolTip="Giá tối đa" TextChanged="CustomPrice_TextChanged" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 4. Publisher Filter -->
                            <TextBlock Text="4. NHÀ XUẤT BẢN" FontWeight="Bold" FontSize="11" Foreground="#64748B" Margin="0,0,0,6" />
                            <ComboBox x:Name="cbPublisherFilter" Margin="0,0,0,14" Padding="10,6" SelectionChanged="FilterSelection_Changed" />

                            <!-- 5. Publication Year Filter -->
                            <TextBlock Text="5. NĂM XUẤT BẢN" FontWeight="Bold" FontSize="11" Foreground="#64748B" Margin="0,0,0,6" />
                            <ComboBox x:Name="cbYearFilter" Margin="0,0,0,14" Padding="10,6" SelectionChanged="FilterSelection_Changed" />

                            <!-- 6. Stock Availability -->
                            <TextBlock Text="6. TÌNH TRẠNG TỒN KHO" FontWeight="Bold" FontSize="11" Foreground="#64748B" Margin="0,0,0,6" />
                            <CheckBox x:Name="chkInStockOnly" Content="Chỉ hiện sách còn tồn kho (&gt; 0)" Margin="0,0,0,16" Checked="FilterCheck_Changed" Unchecked="FilterCheck_Changed" />

                            <!-- Reset & Refresh -->
                            <Button x:Name="btnResetFilters" Content="🧹 Đặt Lại Bộ Lọc" Style="{StaticResource SecondaryButtonStyle}" Click="btnResetFilters_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                            <Button x:Name="btnRefreshData" Content="🔄 Làm Mới Dữ Liệu" Style="{StaticResource SecondaryButtonStyle}" Click="btnRefreshData_Click" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- RIGHT CONTENT: TOOLBAR + GRID/TABLE VIEWS + PAGINATION -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- A. TOP CATALOG TOOLBAR -->
                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Margin="18,14,18,8" Padding="16,10" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <!-- Left: Result Count + Quick Status Tabs -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#EEF2FF" CornerRadius="8" Padding="10,5" Margin="0,0,12,0">
                                    <TextBlock x:Name="txtResultSummary" Text="Hiển thị: 0 / 0 đầu sách" FontSize="12" FontWeight="Bold" Foreground="#4F46E5" />
                                </Border>

                                <Button x:Name="btnPillAll" Content="Tất Cả" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="12" Margin="0,0,6,0" Click="btnPillAll_Click" />
                                <Button x:Name="btnPillForSale" Content="🛍️ Sách Bán" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="12" Margin="0,0,6,0" Click="btnPillForSale_Click" />
                                <Button x:Name="btnPillForRent" Content="📅 Cho Thuê" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="12" Margin="0,0,6,0" Click="btnPillForRent_Click" />
                                <Button x:Name="btnPillRentedOut" Content="⏳ Đã Thuê" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="12" Click="btnPillRentedOut_Click" />
                            </StackPanel>

                            <!-- Right: Sorting + View Mode Switcher -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="Sắp xếp:" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="cbSortBy" Width="195" Padding="10,5" Margin="0,0,14,0" SelectionChanged="cbSortBy_SelectionChanged">
                                    <ComboBoxItem Content="Mới nhất (Mặc định)" IsSelected="True" />
                                    <ComboBoxItem Content="Mã sách: Tăng dần" />
                                    <ComboBoxItem Content="Mã sách: Giảm dần" />
                                    <ComboBoxItem Content="Giá bìa: Thấp đến Cao" />
                                    <ComboBoxItem Content="Giá bìa: Cao đến Thấp" />
                                    <ComboBoxItem Content="Tên sách: A → Z" />
                                    <ComboBoxItem Content="Tên sách: Z → A" />
                                    <ComboBoxItem Content="Năm xuất bản: Mới → Cũ" />
                                    <ComboBoxItem Content="Tồn kho: Nhiều → Ít" />
                                </ComboBox>

                                <!-- View Mode Switcher -->
                                <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="3">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="btnViewGrid" Content="⊞ Dạng Lưới" Padding="10,4" FontSize="12"
                                                Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,3,0"
                                                Click="btnViewGrid_Click" />
                                        <Button x:Name="btnViewTable" Content="☰ Dạng Bảng" Padding="10,4" FontSize="12"
                                                Style="{StaticResource SecondaryButtonStyle}" BorderThickness="0"
                                                Click="btnViewTable_Click" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- B. MAIN CONTENT AREA (GRID VIEW OR TABLE VIEW) -->
                    <Grid Grid.Row="1" Margin="18,4,18,8">
                        <!-- EMPTY STATE -->
                        <Border x:Name="panelEmptyState" Visibility="Collapsed" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                <TextBlock Text="📭" FontSize="52" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                <TextBlock Text="Không tìm thấy đầu sách nào phù hợp!" FontWeight="Bold" FontSize="18" Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <TextBlock Text="Hãy thử thay đổi từ khóa tìm kiếm hoặc nhấn nút 'Đặt Lại Bộ Lọc' để xem toàn bộ kho sách." FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,16" />
                                <Button Content="🧹 Đặt Lại Toàn Bộ Bộ Lọc" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" Click="btnResetFilters_Click" />
                            </StackPanel>
                        </Border>

                        <!-- MODE 1: CARD GRID VIEW -->
                        <ScrollViewer x:Name="scrollGridView" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="icBooksGrid">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="252" Height="422" Margin="0,0,14,14" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Effect="{StaticResource CardShadow}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="182" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Cover Photo / Placeholder -->
                                                <Border Grid.Row="0" CornerRadius="12,12,0,0" ClipToBounds="True" Background="#1E1B4B">
                                                    <Grid>
                                                        <Image Source="{Binding CoverImage}" Stretch="UniformToFill"
                                                               Visibility="{Binding HasCoverImage, Converter={StaticResource BoolToVisConverter}}" />

                                                        <Border Visibility="{Binding HasNoCoverImage, Converter={StaticResource BoolToVisConverter}}" Padding="14">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#4338CA" Offset="0" />
                                                                    <GradientStop Color="#6D28D9" Offset="0.6" />
                                                                    <GradientStop Color="#0284C7" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <TextBlock Text="📖" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold" Foreground="White"
                                                                           TextAlignment="Center" TextWrapping="Wrap" MaxHeight="45" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Book ID & Category Badge (Top Left) -->
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                                                            <Border Background="#D90F172A" CornerRadius="6" Padding="6,2" Margin="0,0,4,0">
                                                                <TextBlock Text="{Binding BookCode}" FontSize="10" FontWeight="Bold" Foreground="#A5B4FC" />
                                                            </Border>
                                                            <Border Background="#D9000000" CornerRadius="6" Padding="6,2">
                                                                <TextBlock Text="{Binding CategoryName}" FontSize="10" FontWeight="SemiBold" Foreground="White" MaxWidth="115" TextTrimming="CharacterEllipsis" />
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- Status Badge (Top Right) -->
                                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                                                Background="{Binding StatusBadgeColor}" CornerRadius="6" Padding="8,2">
                                                            <TextBlock Text="{Binding BookStatus}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                                        </Border>

                                                        <!-- Image Count Badge (Bottom Left) -->
                                                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                                                                Background="#B80F172A" CornerRadius="6" Padding="7,2">
                                                            <TextBlock Text="{Binding ImageCountBadge}" FontSize="10" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                                        </Border>

                                                        <!-- ADMIN ONLY: Quick Add/Change Image Button (Bottom Right) -->
                                                        <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                                                                Content="📷 Thêm Ảnh" Padding="8,3" FontSize="10"
                                                                Style="{StaticResource RentButtonStyle}" Background="#4F46E5"
                                                                Visibility="{Binding IsAdminActionVisible, Converter={StaticResource BoolToVisConverter}}"
                                                                Tag="{Binding}" Click="btnAdminUploadCardImage_Click"
                                                                ToolTip="Quyền Admin: Tải thêm ảnh hoặc đổi ảnh bìa cho sách này" />
                                                    </Grid>
                                                </Border>

                                                <!-- Book Details -->
                                                <StackPanel Grid.Row="1" Margin="12,10,12,6">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13.5" Foreground="#0F172A"
                                                               TextTrimming="CharacterEllipsis" MaxHeight="38" TextWrapping="Wrap" Margin="0,0,0,3"
                                                               ToolTip="{Binding Title}" />

                                                    <TextBlock Text="{Binding Author}" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569"
                                                               TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />

                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <TextBlock Text="🏢 " FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding PublisherDisplay}" FontSize="11" Foreground="#64748B" MaxWidth="135" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text=" • " FontSize="11" Foreground="#CBD5E1" />
                                                        <TextBlock Text="{Binding YearDisplay}" FontSize="11" Foreground="#64748B" FontWeight="SemiBold" />
                                                    </StackPanel>

                                                    <Grid Margin="0,2,0,2">
                                                        <TextBlock Text="{Binding PrimaryPriceDisplay}" FontWeight="Black" FontSize="14" Foreground="#4F46E5" VerticalAlignment="Center" />
                                                        <Border Background="{Binding StockBadgeColor}" CornerRadius="6" Padding="6,2" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding StockStatusText}" FontSize="10" FontWeight="Bold" Foreground="{Binding StockTextColor}" />
                                                        </Border>
                                                    </Grid>
                                                    <Grid Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding SecondaryPriceDisplay}" FontSize="11" Foreground="#D97706" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding IsbnDisplay}" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>
                                                </StackPanel>

                                                <!-- Card Footer Buttons -->
                                                <Border Grid.Row="2" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Padding="10,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button Grid.Column="0" Content="🔍 Chi Tiết" Style="{StaticResource SecondaryButtonStyle}"
                                                                Margin="0,0,4,0" Padding="8,6" FontSize="11.5"
                                                                Tag="{Binding}" Click="btnViewDetail_Click" />
                                                        <Button Grid.Column="1" Content="🛒 Mua / Thuê" Style="{StaticResource PrimaryButtonStyle}"
                                                                Margin="4,0,0,0" Padding="8,6" FontSize="11.5"
                                                                Tag="{Binding}" Click="btnSelectBookAction_Click" />
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- MODE 2: TABLE / DATAGRID VIEW -->
                        <Border x:Name="borderTableView" Visibility="Collapsed" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12" Effect="{StaticResource CardShadow}">
                            <DataGrid x:Name="dgBooksTable"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F1F5F9"
                                      BorderBrush="#E2E8F0"
                                      BorderThickness="1"
                                      RowHeight="56"
                                      Background="White"
                                      MouseDoubleClick="dgBooksTable_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã Sách" Binding="{Binding BookCode}" Width="75" FontWeight="Bold" />

                                    <!-- Cover Image Thumbnail Column -->
                                    <DataGridTemplateColumn Header="Ảnh Bìa" Width="68">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Width="40" Height="48" CornerRadius="6" ClipToBounds="True" Background="#E0E7FF" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Grid>
                                                        <TextBlock Text="📖" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Image Source="{Binding CoverImage}" Stretch="UniformToFill"
                                                               Visibility="{Binding HasCoverImage, Converter={StaticResource BoolToVisConverter}}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Tiêu Đề Sách" Binding="{Binding Title}" Width="*" FontWeight="Bold" />
                                    <DataGridTextColumn Header="Tác Giả" Binding="{Binding Author}" Width="140" />
                                    <DataGridTextColumn Header="Thể Loại" Binding="{Binding CategoryName}" Width="140" />
                                    <DataGridTextColumn Header="Nhà Xuất Bản" Binding="{Binding PublisherDisplay}" Width="125" />
                                    <DataGridTextColumn Header="Năm XB" Binding="{Binding YearDisplay}" Width="65" />
                                    <DataGridTextColumn Header="Giá Bìa" Binding="{Binding FormattedPrice}" Width="95" FontWeight="Bold" />
                                    <DataGridTextColumn Header="Thuê 7N" Binding="{Binding FormattedRental7Days}" Width="90" />

                                    <!-- Stock Badge Column -->
                                    <DataGridTemplateColumn Header="Tồn Kho" Width="105">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding StockBadgeColor}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StockStatusText}" FontSize="11" FontWeight="Bold" Foreground="{Binding StockTextColor}" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Status Badge Column -->
                                    <DataGridTemplateColumn Header="Hình Thức" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding StatusBadgeColor}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding BookStatus}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Actions Column -->
                                    <DataGridTemplateColumn Header="Thao Tác" Width="215">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="🔍 Chi Tiết" Style="{StaticResource SecondaryButtonStyle}"
                                                            Padding="7,4" FontSize="11" Margin="0,0,4,0"
                                                            Tag="{Binding}" Click="btnViewDetail_Click" />
                                                    <Button Content="📷 Ảnh" Style="{StaticResource RentButtonStyle}"
                                                            Padding="7,4" FontSize="11" Margin="0,0,4,0"
                                                            Visibility="{Binding IsAdminActionVisible, Converter={StaticResource BoolToVisConverter}}"
                                                            Tag="{Binding}" Click="btnAdminUploadCardImage_Click"
                                                            ToolTip="Quyền Admin: Tải ảnh lên cho sách này" />
                                                    <Button Content="🛒 Chọn" Style="{StaticResource PrimaryButtonStyle}"
                                                            Padding="7,4" FontSize="11"
                                                            Tag="{Binding}" Click="btnSelectBookAction_Click" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>

                    <!-- C. BOTTOM PAGINATION BAR -->
                    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Margin="18,0,18,14" Padding="16,10" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <!-- Left: Page Size Selector & Range Info -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Số sách / trang:" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="cbPageSize" Width="135" Padding="8,4" Margin="0,0,16,0" SelectionChanged="cbPageSize_SelectionChanged">
                                    <ComboBoxItem Content="6 sách / trang" Tag="6" />
                                    <ComboBoxItem Content="8 sách / trang" Tag="8" IsSelected="True" />
                                    <ComboBoxItem Content="12 sách / trang" Tag="12" />
                                    <ComboBoxItem Content="20 sách / trang" Tag="20" />
                                    <ComboBoxItem Content="Hiển thị tất cả" Tag="9999" />
                                </ComboBox>
                                <TextBlock x:Name="txtPaginationInfo" Text="Đang hiển thị 0 - 0 trên tổng 0 đầu sách" FontSize="12" Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Right: Page Controls -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="btnFirstPage" Content="⏮ Đầu" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="12" Margin="0,0,6,0" Click="btnFirstPage_Click" />
                                <Button x:Name="btnPrevPage" Content="◀ Trước" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="12" Margin="0,0,10,0" Click="btnPrevPage_Click" />

                                <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="8" Padding="14,5" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtPageIndicator" Text="Trang 1 / 1" FontSize="12" FontWeight="Bold" Foreground="#4F46E5" />
                                </Border>

                                <Button x:Name="btnNextPage" Content="Sau ▶" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="12" Margin="0,0,6,0" Click="btnNextPage_Click" />
                                <Button x:Name="btnLastPage" Content="Cuối ⏭" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="12" Click="btnLastPage_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </DockPanel>

        <!-- ==================== 4. MODAL OVERLAY: BOOK DETAIL POPUP ==================== -->
        <Grid x:Name="gridDetailModal" Background="#70000000" Visibility="Collapsed">
            <Border Width="760" MaxHeight="780" Background="#FFFFFF" CornerRadius="16" Effect="{StaticResource ModalShadow}" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Modal Header -->
                    <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="22,16">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📖 " FontSize="18" />
                                <TextBlock Text="Chi Tiết Đầu Sách &amp; Album Ảnh" FontWeight="Bold" FontSize="16" Foreground="#0F172A" VerticalAlignment="Center" />
                                <Border Background="#EEF2FF" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtDetailBookCode" Text="#BK-001" FontSize="11" FontWeight="Bold" Foreground="#4F46E5" />
                                </Border>
                            </StackPanel>
                            <Button Content="✕" Width="30" Height="30" Background="#F1F5F9" BorderThickness="0"
                                    Foreground="#64748B" FontWeight="Bold" Cursor="Hand" HorizontalAlignment="Right"
                                    Click="btnCloseDetail_Click" />
                        </Grid>
                    </Border>

                    <!-- Modal Body -->
                    <ScrollViewer Grid.Row="1" Padding="24,18" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="175" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: Main Cover Preview + Gallery Thumbnails -->
                                <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                                    <Border Width="160" Height="220" CornerRadius="12" ClipToBounds="True" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource CardShadow}">
                                        <Grid>
                                            <Border>
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#4338CA" Offset="0" />
                                                        <GradientStop Color="#0284C7" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="📖" FontSize="44" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Image x:Name="imgDetailCover" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>

                                    <TextBlock x:Name="txtDetailImageCount" Text="🖼️ Album ảnh (0)" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="2,8,0,4" />

                                    <!-- Gallery Thumbnails -->
                                    <ItemsControl x:Name="icDetailGallery">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" MaxWidth="165" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,6,6" Cursor="Hand"
                                                        Tag="{Binding}" Click="btnSelectGalleryThumbnail_Click"
                                                        ToolTip="{Binding CoverBadgeText}">
                                                    <Border Width="46" Height="58" CornerRadius="6" BorderBrush="{Binding BorderColor}" BorderThickness="2" ClipToBounds="True">
                                                        <Image Source="{Binding ImageSource}" Stretch="UniformToFill" />
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Right: Title, Badges & Pricing -->
                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                    <TextBlock x:Name="txtDetailTitle" Text="Tên sách" FontWeight="Black" FontSize="20" Foreground="#0F172A" TextWrapping="Wrap" Margin="0,0,0,6" />
                                    <TextBlock x:Name="txtDetailAuthor" Text="Tác giả: ..." FontSize="14" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,12" />

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Background="#EEF2FF" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                            <TextBlock x:Name="txtDetailCategory" Text="Thể loại" FontSize="12" FontWeight="Bold" Foreground="#4F46E5" />
                                        </Border>
                                        <Border x:Name="borderDetailStatus" Background="#10B981" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                            <TextBlock x:Name="txtDetailStatus" Text="Bán" FontSize="12" FontWeight="Bold" Foreground="White" />
                                        </Border>
                                        <Border Background="#F1F5F9" CornerRadius="6" Padding="10,4">
                                            <TextBlock x:Name="txtDetailStock" Text="Còn 20 cuốn" FontSize="12" FontWeight="Bold" Foreground="#0F172A" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock x:Name="txtDetailCreatedAt" Text="Ngày nhập kho: --/--/----" FontSize="11" Foreground="#64748B" Margin="0,0,0,12" />

                                    <!-- ADMIN ONLY: Book Image Management Box inside Detail Modal -->
                                    <Border x:Name="panelAdminDetailImageControls" Visibility="Collapsed"
                                            Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="👑 QUẢN LÝ ẢNH SÁCH (CHỈ DÀNH CHO ADMIN)" FontSize="11" FontWeight="Bold" Foreground="#4338CA" Margin="0,0,0,8" />
                                            <WrapPanel Orientation="Horizontal">
                                                <Button Content="➕ Thêm Ảnh Mới" Style="{StaticResource PrimaryButtonStyle}" Padding="10,5" FontSize="11" Margin="0,0,6,6" Click="btnDetailUploadImages_Click" />
                                                <Button Content="🔄 Đổi Ảnh Bìa Chính" Style="{StaticResource RentButtonStyle}" Padding="10,5" FontSize="11" Margin="0,0,6,6" Click="btnDetailChangeCover_Click" />
                                                <Button x:Name="btnDetailSetSelectedAsCover" Content="⭐ Đặt Ảnh Đang Xem Làm Bìa" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="11" Margin="0,0,6,6" Click="btnDetailSetSelectedAsCover_Click" />
                                                <Button x:Name="btnDetailDeleteSelectedImage" Content="🗑️ Xóa Ảnh Đang Xem" Style="{StaticResource SecondaryButtonStyle}" Foreground="#DC2626" Padding="10,5" FontSize="11" Margin="0,0,0,6" Click="btnDetailDeleteSelectedImage_Click" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Pricing & Metadata Box -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                                <TextBlock Text="Giá Bìa Mua Sở Hữu" FontSize="11" Foreground="#64748B" />
                                                <TextBlock x:Name="txtDetailPrice" Text="0 đ" FontWeight="Black" FontSize="17" Foreground="#4F46E5" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                                <TextBlock Text="Giá Thuê (7 / 14 Ngày)" FontSize="11" Foreground="#64748B" />
                                                <TextBlock x:Name="txtDetailRentPrice" Text="0 đ" FontWeight="Bold" FontSize="13" Foreground="#D97706" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                                                <TextBlock Text="Giá Thuê (30 Ngày)" FontSize="11" Foreground="#64748B" />
                                                <TextBlock x:Name="txtDetailRent30Price" Text="0 đ" FontWeight="Bold" FontSize="13" Foreground="#B45309" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="0">
                                                <TextBlock Text="Nhà Xuất Bản" FontSize="11" Foreground="#64748B" />
                                                <TextBlock x:Name="txtDetailPublisher" Text="NXB" FontWeight="SemiBold" FontSize="12.5" Foreground="#1E293B" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="1">
                                                <TextBlock Text="Năm Xuất Bản" FontSize="11" Foreground="#64748B" />
                                                <TextBlock x:Name="txtDetailYear" Text="2024" FontWeight="SemiBold" FontSize="12.5" Foreground="#1E293B" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="2">
                                                <TextBlock Text="Mã Tiêu Chuẩn ISBN" FontSize="11" Foreground="#64748B" />
                                                <TextBlock x:Name="txtDetailIsbn" Text="ISBN" FontWeight="SemiBold" FontSize="12.5" Foreground="#1E293B" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Description -->
                            <TextBlock Text="MÔ TẢ NỘI DUNG SÁCH" FontWeight="Bold" FontSize="12" Foreground="#475569" Margin="0,0,0,6" />
                            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                                <TextBlock x:Name="txtDetailDescription" Text="Mô tả chi tiết..." FontSize="13" Foreground="#334155" TextWrapping="Wrap" LineHeight="20" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Modal Footer -->
                    <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="22,14" Background="#F8FAFC" CornerRadius="0,0,16,16">
                        <Grid>
                            <Button Content="Đóng" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Click="btnCloseDetail_Click" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="btnDetailAddToCart" Content="🛒 Thêm Vào Giỏ Hàng &amp; Mua/Thuê" Style="{StaticResource PrimaryButtonStyle}" Click="btnDetailAddToCart_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
